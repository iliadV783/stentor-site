---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import type { NavId } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  active?: NavId | null;
  showNav?: boolean;
  showFooter?: boolean;
  image?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  author?: string;
}

const {
  title = site.title,
  description = site.description,
  active = null,
  showNav = true,
  showFooter = true,
  image = "/og-default.svg",
  ogType = "website",
  noindex = false,
  publishedTime,
  author,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image.startsWith("http") ? image : new URL(image, Astro.site).toString();
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "";
const faviconURL = "/favicon.svg?v=bronze-96-2026-06-13-v2";

const isHome = Astro.url.pathname === "/";
const isArticle = ogType === "article";
const socialUrls = (Object.values(site.social) as string[]).filter(
  (s) => s && !s.startsWith("#"),
);

const orgSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: siteOrigin || undefined,
  logo: ogImage,
  ...(socialUrls.length ? { sameAs: socialUrls } : {}),
};

const websiteSchema = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: site.title,
      url: siteOrigin || undefined,
      description: site.description,
    }
  : null;

const articleSchema =
  isArticle && publishedTime
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description,
        image: ogImage,
        datePublished: publishedTime,
        ...(author
          ? { author: { "@type": "Person", name: author } }
          : {}),
        publisher: {
          "@type": "Organization",
          name: site.name,
          logo: { "@type": "ImageObject", url: ogImage },
        },
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
      }
    : null;
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href={faviconURL} />
    <link rel="shortcut icon" type="image/svg+xml" href={faviconURL} />
    <link rel="apple-touch-icon" href={faviconURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.locale} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && author && (
      <meta property="article:author" content={author} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {websiteSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    {articleSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />

    <ClientRouter />
  </head>
  <body>
    {showNav && <Nav active={active} />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}

    <script is:inline>
      document.addEventListener("astro:after-swap", () => {
        if (window.Alpine) window.Alpine.initTree(document.body);
      });
    </script>

    <script is:inline>
      window.addEventListener("unhandledrejection", (e) => {
        const r = e.reason;
        if (
          r &&
          r.name === "InvalidStateError" &&
          typeof r.message === "string" &&
          /transition was aborted/i.test(r.message)
        ) {
          e.preventDefault();
        }
      });
    </script>

    <script is:inline>
      (() => {
        function init() {
          const els = document.querySelectorAll("[data-animate]:not(.is-in)");
          if (!els.length) return;
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (reduce || !("IntersectionObserver" in window)) {
            els.forEach((el) => el.classList.add("is-in"));
            return;
          }
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add("is-in");
                  io.unobserve(e.target);
                }
              }
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
          );
          els.forEach((el) => io.observe(el));
        }
        document.addEventListener("astro:page-load", init);
        document.addEventListener("astro:after-swap", init);
      })();
    </script>
  </body>
</html>
