---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "./Eyebrow.astro";
import Btn from "./Btn.astro";

import IllusRegionMap from "../assets/illustrations/region-map.svg";
import IllusPolicyHexagon from "../assets/illustrations/policy-hexagon.svg";
import IllusP95Ring from "../assets/illustrations/p95-ring.svg";
import IllusTrafficChart from "../assets/illustrations/traffic-line-chart.svg";
import IllusPostgres from "../assets/illustrations/iso-bento-postgres.svg";
import IllusTypes from "../assets/illustrations/iso-bento-types.svg";
import IllusPulse from "../assets/illustrations/iso-bento-pulse-arc.svg";
import IllusDeploy from "../assets/illustrations/iso-bento-deploy-branch.svg";

const {
  blog,
  locale = "en-US",
  title = "Sténtor – Blog",
  description = "Research notes, field notes and development updates on surtitles, translation, audio description and live-performance text.",
  featuredLabel = "Featured",
  notesLabel = "notes",
  postStatusLabel = "Coming soon",
} = Astro.props;

const coverMap = {
  "region-map": IllusRegionMap,
  "policy-hexagon": IllusPolicyHexagon,
  "p95-ring": IllusP95Ring,
  "traffic-line-chart": IllusTrafficChart,
  "iso-postgres": IllusPostgres,
  "iso-types": IllusTypes,
  "iso-pulse": IllusPulse,
  "iso-deploy": IllusDeploy,
} as const;

const coverTints: Record<string, string> = {
  research: "rgba(96,165,250,0.16)",
  practice: "rgba(239,68,68,0.18)",
  product: "rgba(251,191,36,0.16)",
  fieldnotes: "rgba(74,222,128,0.14)",
};

const sorted = [...blog.posts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const featured = sorted.find((p) => p.featured) ?? sorted[0];
const rest = sorted.filter((p) => p.id !== featured?.id);

const fmtDate = (d: string) =>
  new Date(d).toLocaleString(locale, { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Layout
  title={title}
  description={description}
  active={null}
>
  <section class="relative overflow-hidden border-b border-hairline pt-24 pb-16">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.35)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] [mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="max-w-[760px]">
        <Eyebrow><span class="font-mono">{blog.hero.eyebrow}</span></Eyebrow>
        <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.02] tracking-[-0.04em] font-semibold mt-5 mb-4">{blog.hero.title}</h1>
        <p class="text-lg leading-[1.55] text-text-2 mb-7 max-w-[560px]">{blog.hero.description}</p>
        <div class="flex flex-wrap gap-3">
          <Btn href={blog.hero.primaryCta.href} variant="primary">{blog.hero.primaryCta.label}</Btn>
          <Btn href={blog.hero.secondaryCta.href} variant="ghost">{blog.hero.secondaryCta.label}</Btn>
        </div>
      </div>
    </div>
  </section>

  <div class="sticky top-16 z-10 border-b border-hairline bg-bg/60 backdrop-blur-md" x-data="{f:'all'}">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 h-14 flex items-center gap-4 overflow-x-auto">
      <div class="flex gap-1">
        {blog.categories.map((c) => (
          <button
            @click={`f='${c.id}'`}
            :class={`f==='${c.id}' ? 'bg-red-500/[0.08] border-red-500/25 text-red-500' : 'border-transparent text-text-2 hover:text-text'`}
            class="h-8 px-3 rounded-md border text-[13px] whitespace-nowrap transition-colors"
          >{c.label}</button>
        ))}
      </div>
      <span class="ml-auto hidden sm:inline-block font-mono text-xs text-text-3">{sorted.length} {notesLabel}</span>
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-14 md:py-16">
    {featured && (() => {
      const FeatCover = featured.cover ? coverMap[featured.cover] : null;
      const featStyle = blog.categoryStyles[featured.category];
      const tint = coverTints[featured.category];
      return (
        <article class="block border border-hairline rounded-xl bg-surface overflow-hidden mb-14 grid grid-cols-1 lg:[grid-template-columns:1.05fr_1fr]">
          <div class="relative bg-deep border-b lg:border-b-0 lg:border-r border-hairline overflow-hidden aspect-[16/9] lg:aspect-auto lg:min-h-[360px]" style={`background: radial-gradient(ellipse 60% 80% at 50% 50%, ${tint}, var(--color-deep) 70%);`}>
            <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:48px_48px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
            {FeatCover && <FeatCover class="absolute inset-0 w-full h-full" />}
            <span class={`absolute top-5 left-5 inline-flex items-center gap-1.5 font-mono text-[11px] tracking-[0.06em] uppercase px-2.5 py-1 rounded-full border ${featStyle.tag}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${featStyle.dot}`}></span>
              {featuredLabel} · {blog.categoryLabels?.[featured.category] ?? featured.category}
            </span>
          </div>
          <div class="p-8 lg:p-12 flex flex-col gap-4 justify-center">
            <span class="font-mono text-[12px] text-text-3">{fmtDate(featured.date)} · {featured.readingTime}</span>
            <h2 class="text-3xl md:text-[34px] lg:text-[40px] tracking-[-0.03em] font-semibold leading-[1.08]">{featured.title}</h2>
            <p class="text-[15.5px] leading-[1.6] text-text-2 max-w-[480px]">{featured.description}</p>
            <div class="flex items-center gap-3 mt-3 pt-5 border-t border-dashed border-hairline">
              <span class="inline-flex items-center gap-1.5 text-text-3 text-[13px] font-medium border border-hairline rounded-full px-2.5 py-1">
                {postStatusLabel}
              </span>
            </div>
          </div>
        </article>
      );
    })()}

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => {
        const Cover = post.cover ? coverMap[post.cover] : null;
        const style = blog.categoryStyles[post.category];
        const tint = coverTints[post.category];
        return (
          <article class="flex flex-col border border-hairline rounded-xl bg-surface overflow-hidden">
            <div class="relative aspect-[16/10] bg-deep border-b border-hairline overflow-hidden" style={`background: radial-gradient(ellipse 70% 90% at 50% 60%, ${tint}, var(--color-deep) 70%);`}>
              <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:40px_40px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
              {Cover && <Cover class="absolute inset-0 w-full h-full" />}
              <span class={`absolute top-3.5 left-3.5 inline-flex items-center gap-1.5 font-mono text-[10.5px] tracking-[0.06em] uppercase px-2 py-0.5 rounded-full border ${style.tag}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${style.dot}`}></span>
                {blog.categoryLabels?.[post.category] ?? post.category}
              </span>
            </div>
            <div class="p-5 flex flex-col gap-3 flex-1">
              <span class="font-mono text-[11.5px] text-text-3">{fmtDate(post.date)} · {post.readingTime}</span>
              <h3 class="text-[18px] tracking-[-0.02em] font-semibold leading-[1.25]">{post.title}</h3>
              <p class="text-[13.5px] leading-[1.55] text-text-3 m-0 line-clamp-3">{post.description}</p>
              <div class="flex items-center mt-auto pt-4 border-t border-dashed border-hairline">
                <span class="text-[11px] text-text-4 border border-hairline rounded-full px-2 py-0.5">{postStatusLabel}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <Btn href={blog.loadMoreHref ?? "/contact"} variant="ghost">{blog.loadMore} <span aria-hidden="true">↓</span></Btn>
    </div>
  </div>

  <section class="border-t border-hairline py-20 bg-bg/40">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 text-center grid justify-items-center gap-5">
      <Eyebrow><span class="font-mono">{blog.finalCta.eyebrow}</span></Eyebrow>
      <h2 class="text-3xl md:text-4xl lg:text-[44px] tracking-[-0.035em] font-semibold leading-[1.1] max-w-[680px]">{blog.finalCta.title}</h2>
      <p class="text-[15.5px] leading-[1.6] text-text-2 max-w-[560px]">{blog.finalCta.body}</p>
      <div class="flex flex-wrap justify-center gap-3 mt-2">
        <Btn href={blog.finalCta.primaryCta.href} variant="primary">{blog.finalCta.primaryCta.label}</Btn>
        <Btn href={blog.finalCta.secondaryCta.href} variant="ghost">{blog.finalCta.secondaryCta.label}</Btn>
      </div>
      <p class="text-[12px] text-text-4 max-w-[420px]">{blog.finalCta.fineprint}</p>
    </div>
  </section>
</Layout>
