---
interface Props {
  href?: string;
}

import StentorLogo from "../assets/icons/logo.svg";

const { href = "/" } = Astro.props;
const brandMark = "data:image/png;base64,";
---
<a href={href} aria-label="Sténtor — home" class="inline-flex items-center gap-[12px] font-semibold tracking-[-0.02em]">
  <span class="grid place-items-center w-8 h-8 rounded-[8px] overflow-hidden ring-1 ring-white/10 shadow-[0_0_18px_rgba(198,83,64,0.18)] bg-black">
    <img src={brandMark} alt="" class="w-full h-full block" aria-hidden="true" />
  </span>
  <span class="text-base flex items-center gap-[12px]">
    <StentorLogo class="h-4 w-auto" aria-hidden="true" />
    <span class="hidden sm:inline text-text-3 font-medium">Live Theatre Accessibility</span>
  </span>
</a>
