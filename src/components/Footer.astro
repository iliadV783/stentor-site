---
import { site, footerGroups } from "../data/site";
import { getLocaleFromPath, getLocalizedPath } from "../i18n/config";

const currentLocale = getLocaleFromPath(Astro.url.pathname);
const isFr = currentLocale === "fr";
const isIt = currentLocale === "it";
const isEs = currentLocale === "es";
const isDe = currentLocale === "de";
const groups = isFr
  ? [
      { title: "Produit", links: [
        { href: "/fr/features", label: "Fonctionnalites" },
        { href: "/fr/docs", label: "Workflow" },
        { href: "/fr/for-theatres", label: "Pour les theatres" },
        { href: "/fr/contact", label: "Contact" },
      ] },
      { title: "Usages", links: [
        { href: "/fr/features", label: "Surtitres" },
        { href: "/fr/features", label: "Traduction" },
        { href: "/fr/features", label: "Audiodescription" },
        { href: "/fr/for-theatres", label: "Festivals" },
      ] },
      { title: "Projet", links: [
        { href: "/fr/about", label: "A propos" },
        { href: "/fr/blog/", label: "Notes" },
        { href: "/fr/changelog/", label: "Mises a jour" },
      ] },
      { title: "Legal", links: [
        { href: "/privacy", label: "Confidentialite" },
        { href: "/terms", label: "Conditions" },
      ] },
    ]
  : isIt
    ? [
        { title: "Prodotto", links: [
          { href: "/it/features", label: "Funzioni" },
          { href: "/it/docs", label: "Documentazione" },
          { href: "/it/for-theatres", label: "Per i teatri" },
          { href: "/it/contact", label: "Contatti" },
        ] },
        { title: "Usi", links: [
          { href: "/it/features", label: "Soprattitoli" },
          { href: "/it/features", label: "Traduzione" },
          { href: "/it/features", label: "Audio-descrizione" },
          { href: "/it/for-theatres", label: "Festival" },
        ] },
        { title: "Progetto", links: [
          { href: "/it/about", label: "Chi siamo" },
          { href: "/it/blog/", label: "Note" },
          { href: "/it/changelog/", label: "Aggiornamenti" },
        ] },
        { title: "Legale", links: [
          { href: "/privacy", label: "Privacy" },
          { href: "/terms", label: "Termini" },
        ] },
      ]
    : isEs
      ? [
          { title: "Producto", links: [
            { href: "/es/features", label: "Funciones" },
            { href: "/es/docs", label: "Guía" },
            { href: "/es/for-theatres", label: "Para teatros" },
            { href: "/es/contact", label: "Contacto" },
          ] },
          { title: "Usos", links: [
            { href: "/es/features", label: "Sobretítulos" },
            { href: "/es/features", label: "Traducción" },
            { href: "/es/features", label: "Audiodescripción" },
            { href: "/es/for-theatres", label: "Festivales" },
          ] },
          { title: "Proyecto", links: [
            { href: "/es/about", label: "Proyecto" },
            { href: "/es/blog/", label: "Notas" },
            { href: "/es/changelog/", label: "Actualizaciones" },
          ] },
          { title: "Legal", links: [
            { href: "/privacy", label: "Privacidad" },
            { href: "/terms", label: "Términos" },
          ] },
        ]
      : isDe
        ? [
            { title: "Produkt", links: [
              { href: "/de/features", label: "Funktionen" },
              { href: "/de/docs", label: "Leitfaden" },
              { href: "/de/for-theatres", label: "Für Theater" },
              { href: "/de/contact", label: "Kontakt" },
            ] },
            { title: "Anwendungen", links: [
              { href: "/de/features", label: "Übertitel" },
              { href: "/de/features", label: "Übersetzung" },
              { href: "/de/features", label: "Audiodeskription" },
              { href: "/de/for-theatres", label: "Festivals" },
            ] },
            { title: "Projekt", links: [
              { href: "/de/about", label: "Projekt" },
              { href: "/de/blog/", label: "Notizen" },
              { href: "/de/changelog/", label: "Updates" },
            ] },
            { title: "Rechtliches", links: [
              { href: "/privacy", label: "Datenschutz" },
              { href: "/terms", label: "Bedingungen" },
            ] },
          ]
        : footerGroups;
const localizedGroups = groups.map((group) => ({
  ...group,
  links: group.links.map((link) => ({
    ...link,
    href: link.href === "/privacy" ? getLocalizedPath("/privacy", currentLocale) : link.href === "/terms" ? getLocalizedPath("/terms", currentLocale) : link.href,
  })),
}));
const footerTagline = isFr
  ? "Surtitres, traduction et audiodescription pour le spectacle vivant."
  : isIt
    ? "Soprattitoli, traduzione e audio-descrizione per lo spettacolo dal vivo."
    : isEs
      ? "Sobretítulos, traducción y audiodescripción para las artes escénicas en vivo."
      : isDe
        ? "Übertitel, Übersetzung und Audiodeskription für Live-Aufführungen."
        : site.footerTagline;
const statusPrefix = isFr
  ? "Concu pour le spectacle vivant"
  : isIt
    ? "Pensato per lo spettacolo dal vivo"
    : isEs
      ? "Pensado para las artes escénicas en vivo"
      : isDe
        ? "Für Live-Aufführungen entwickelt"
        : site.statusPrefix;
const statusRegions = isFr
  ? "surtitres, traduction, audiodescription"
  : isIt
    ? "soprattitoli, traduzione, audio-descrizione"
    : isEs
      ? "sobretítulos, traducción, audiodescripción"
      : isDe
        ? "Übertitel, Übersetzung, Audiodeskription"
        : site.statusRegions;
const homeHref = getLocalizedPath("/", currentLocale);
const brandMark = "/stentor-brand-mark.png?v=2026-06-13-real-png";
---
<footer class="border-t border-hairline pt-16 pb-10 text-text-3">
  <div class="max-w-[1280px] mx-auto px-4 md:px-8">
    <div class="grid gap-12 grid-cols-2 lg:[grid-template-columns:1.4fr_repeat(4,1fr)]">
      <div class="col-span-2 lg:col-span-1">
        <div class="flex items-start gap-4">
          <span class="grid place-items-center w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden ring-1 ring-white/10 shadow-[0_0_28px_rgba(198,83,64,0.22)] bg-black flex-none">
            <img src={brandMark} alt="" class="w-full h-full block" aria-hidden="true" />
          </span>
          <div>
            <a href={homeHref} aria-label="Stentor home" class="inline-flex text-2xl sm:text-3xl leading-none tracking-[-0.04em] font-semibold text-text hover:text-text transition-colors">
              Sténtor
            </a>
            <p class="text-text-3 text-sm mt-4 max-w-[320px]">
              {footerTagline}
            </p>
          </div>
        </div>
      </div>

      {
        localizedGroups.map((g) => (
          <div>
            <h2 class="text-xs uppercase tracking-[0.06em] text-text-3 mb-3.5 font-medium">{g.title}</h2>
            <ul class="grid gap-2.5 list-none p-0 m-0">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-text-2 hover:text-text transition-colors">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 pt-6 border-t border-hairline flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 text-[13px] text-text-3">
      <span>{site.copyright}</span>
      <span class="font-mono">{statusPrefix} · <span class="text-green-400">●</span> {statusRegions}</span>
    </div>
  </div>
</footer>
