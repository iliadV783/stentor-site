---
import { logoCloud as defaultLogoCloud } from "../../../data/home";

interface Props {
  logoCloud?: typeof defaultLogoCloud;
}

const { logoCloud = defaultLogoCloud } = Astro.props;
---
<section class="relative overflow-hidden border-y border-hairline py-9">
  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-bold text-[120px] sm:text-[180px] leading-[0.85] tracking-[-0.06em] text-stentor opacity-[0.035] pointer-events-none whitespace-nowrap select-none z-0" aria-hidden="true">{logoCloud.bigNumber}</div>
  <div class="relative z-10 max-w-[1280px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:[grid-template-columns:200px_1fr] gap-6 md:gap-12 items-center">
      <div class="font-mono text-xs text-text-3 tracking-[0.04em]">{logoCloud.label}</div>
      <div class="flex flex-wrap lg:justify-between items-center gap-x-8 gap-y-4 opacity-70">
        {logoCloud.logos.map((l) => (
          <span class="inline-flex items-center gap-2 text-text-2 text-lg font-medium tracking-[-0.02em]">
            <span class:list={["w-5 h-5 bg-text-3", l.glyph]}></span>{l.name}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
