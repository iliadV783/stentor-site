---
import Eyebrow from "../../Eyebrow.astro";
import Btn from "../../Btn.astro";
import IconPlay from "../../../assets/icons/play.svg";
import { hero as defaultHero } from "../../../data/home";

interface Props {
  hero?: typeof defaultHero;
}

const { hero = defaultHero } = Astro.props;
const pathLang = Astro.url.pathname.split("/").filter(Boolean)[0];
const currentLang = pathLang || "en";
const isIt = currentLang === "it";

type DemoLine = {
  code: string;
  text: string;
};

const demoLines: Record<string, DemoLine> = {
  it: { code: "IT", text: "Vogliono vivere in noi!" },
  en: { code: "EN", text: "They want to live in us!" },
  fr: { code: "FR", text: "Ils veulent vivre en nous !" },
  es: { code: "ES", text: "¡Quieren vivir en nosotros!" },
  de: { code: "DE", text: "Sie wollen in uns leben!" },
  pt: { code: "PT", text: "Querem viver em nós!" },
  zh: { code: "ZH", text: "他们想活在我们之中！" },
  ja: { code: "JA", text: "彼らは私たちの中で生きたがっている！" },
  ar: { code: "AR", text: "يريدون أن يعيشوا فينا!" },
};

const currentDemoLine = demoLines[currentLang] ?? demoLines.en;
const comparisonDemoLine = currentLang === "it" ? demoLines.en : demoLines.it;
const demoLanguagePair = `${currentDemoLine.code} · ${comparisonDemoLine.code}`;

const labels = isIt
  ? {
      inRoom: "In sala",
      screenCaption: "Soprattitoli sullo schermo",
      textLabel: "Testo",
      textValue: "una regia",
      outputsLabel: "Uscite",
      outputsValue: "più canali",
      spaceLabel: "Spazio",
      spaceValue: "dal vivo",
      phoneEyebrow: "Telefono spettatore",
      translationTitle: "Traduzione",
      phoneSync: "sincronizzato con la battuta in sala",
      audioEyebrow: "Audio-descrizione",
      audioTitle: "Nota pronta",
      audioNote: "Ingresso dell'attore da sinistra. Si ferma al centro, guarda la platea.",
      currentCue: "cue corrente",
      nextNote: "prossima nota",
      operator: "operatore",
      synced: "sincronizzato",
      operatorTitle: "Una postazione operatore, più forme di accesso.",
      operatorBody: "Sténtor prepara e manda lo stesso testo verso schermi, telefoni del pubblico, traduzioni e note per audio-descrizione.",
    }
  : {
      inRoom: "In the room",
      screenCaption: "Surtitles on screen",
      textLabel: "Text",
      textValue: "one cueing desk",
      outputsLabel: "Outputs",
      outputsValue: "many channels",
      spaceLabel: "Space",
      spaceValue: "live",
      phoneEyebrow: "Viewer phone",
      translationTitle: "Translation",
      phoneSync: "synced with the line in the room",
      audioEyebrow: "Audio description",
      audioTitle: "Ready note",
      audioNote: "The actor enters from the left. He stops at centre stage and looks toward the audience.",
      currentCue: "current cue",
      nextNote: "next note",
      operator: "operator",
      synced: "synced",
      operatorTitle: "One operator station, multiple forms of access.",
      operatorBody: "Sténtor prepares and sends the same performance text to screens, audience phones, translations and audio-description notes.",
    };
---
<section class="relative pt-24 lg:pt-[120px] pb-10 overflow-hidden">
  <div class="absolute inset-0 dotgrid dotgrid-fade pointer-events-none" aria-hidden="true"></div>
  <div class="absolute left-1/2 -translate-x-1/2 top-[520px] w-[1100px] h-[460px] pointer-events-none halo-red opacity-90" aria-hidden="true"></div>

  <div class="relative max-w-[1280px] mx-auto px-4 md:px-8 text-center">
    <Eyebrow><span class="font-mono">{hero.eyebrow}</span></Eyebrow>

    <h1 class="mt-6 mb-5 mx-auto max-w-[980px] text-5xl sm:text-6xl lg:text-[76px] leading-[0.98] tracking-[-0.045em] font-semibold" set:html={hero.title}></h1>

    <p class="text-lg leading-[1.55] text-text-2 max-w-[640px] mx-auto">{hero.description}</p>

    <div class="mt-8 inline-flex flex-wrap justify-center gap-3">
      {hero.ctas.map((cta) => (
        <Btn href={cta.href} variant={cta.variant} size="lg">
          {"icon" in cta && cta.icon === "play" && <IconPlay class="w-5 h-5" />}
          {cta.label}
          {!("icon" in cta) && <span aria-hidden="true">→</span>}
        </Btn>
      ))}
    </div>

    <div class="mt-16 lg:mt-24 flex flex-wrap justify-center items-center gap-x-4 sm:gap-x-[18px] gap-y-2 font-mono text-xs text-text-3">
      {hero.trust.map((item, i) => (
        <>
          {i > 0 && <span class="hidden sm:block w-px h-3 bg-hairline-strong"></span>}
          <span>{item.live && <><span class="text-green-400">●</span>{" "}</>}{item.label}</span>
        </>
      ))}
    </div>

    <div class="relative mt-14 lg:mt-18 mx-auto max-w-[1120px] text-left" role="img" aria-label="Sténtor sends one performance text to screens, audience phones and audio-description notes.">
      <div class="absolute inset-x-8 -top-10 h-32 rounded-full bg-red-500/18 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative rounded-[28px] border border-hairline bg-deep/92 overflow-hidden shadow-[0_34px_100px_-34px_rgba(0,0,0,0.85),0_50px_110px_-40px_rgba(239,68,68,0.25)]">
        <div class="absolute inset-0 pointer-events-none [background-image:radial-gradient(rgba(255,255,255,0.055)_1px,transparent_1px)] [background-size:26px_26px] [-webkit-mask-image:linear-gradient(to_bottom,#000_0%,transparent_75%)] [mask-image:linear-gradient(to_bottom,#000_0%,transparent_75%)]" aria-hidden="true"></div>

        <div class="relative grid lg:grid-cols-[0.95fr_1.05fr] min-h-[520px]">
          <div class="relative p-6 md:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-hairline flex flex-col justify-between overflow-hidden">
            <div class="absolute left-1/2 top-20 -translate-x-1/2 w-[520px] h-[300px] rounded-full bg-red-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

            <div class="relative">
              <p class="font-mono text-[12px] uppercase tracking-[0.16em] text-red-400 mb-4">{labels.inRoom}</p>
              <div class="rounded-2xl border border-white/10 bg-black/45 p-5 md:p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]">
                <div class="aspect-[16/8.5] rounded-xl border border-white/10 bg-black flex items-center justify-center p-6 text-center relative overflow-hidden">
                  <div class="absolute inset-x-10 top-0 h-px bg-red-500/70 shadow-[0_0_28px_rgba(239,68,68,0.9)]" aria-hidden="true"></div>
                  <p class="text-3xl md:text-4xl lg:text-[44px] leading-[1.08] tracking-[-0.055em] font-semibold text-white">“{currentDemoLine.text}”</p>
                </div>
                <div class="mt-4 flex items-center justify-between gap-4 text-sm text-text-3">
                  <span>{labels.screenCaption}</span>
                  <span class="font-mono text-green-400">live</span>
                </div>
              </div>
            </div>

            <div class="relative mt-8 grid grid-cols-3 gap-3 text-center">
              <div class="rounded-xl border border-white/10 bg-white/[0.035] px-3 py-4">
                <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-4 mb-1">{labels.textLabel}</p>
                <p class="text-text text-sm">{labels.textValue}</p>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/[0.035] px-3 py-4">
                <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-4 mb-1">{labels.outputsLabel}</p>
                <p class="text-text text-sm">{labels.outputsValue}</p>
              </div>
              <div class="rounded-xl border border-white/10 bg-white/[0.035] px-3 py-4">
                <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-4 mb-1">{labels.spaceLabel}</p>
                <p class="text-text text-sm">{labels.spaceValue}</p>
              </div>
            </div>
          </div>

          <div class="relative p-6 md:p-8 lg:p-10 flex flex-col justify-center gap-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <article class="rounded-2xl border border-white/10 bg-white/[0.045] p-5 md:p-6">
                <div class="flex items-start justify-between gap-4 mb-7">
                  <div>
                    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-4 mb-2">{labels.phoneEyebrow}</p>
                    <h2 class="text-2xl tracking-[-0.04em] font-semibold">{labels.translationTitle}</h2>
                  </div>
                  <span class="w-3 h-3 rounded-full bg-green-400 shadow-[0_0_14px_rgba(74,222,128,0.85)]"></span>
                </div>
                <div class="mx-auto max-w-[190px] rounded-[26px] border border-white/15 bg-black p-2 shadow-[0_20px_50px_-28px_rgba(0,0,0,0.9)]">
                  <div class="rounded-[20px] bg-sunken border border-white/8 min-h-[250px] p-4 flex flex-col">
                    <div class="h-1 w-10 rounded-full bg-white/20 mx-auto mb-6"></div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-green-400 mb-3">{demoLanguagePair}</p>
                    <p class="text-xl leading-[1.18] tracking-[-0.035em] text-white">{comparisonDemoLine.text}</p>
                    <p class="mt-auto text-[12px] text-text-3 leading-[1.4]">{labels.phoneSync}</p>
                  </div>
                </div>
              </article>

              <article class="rounded-2xl border border-white/10 bg-white/[0.045] p-5 md:p-6 flex flex-col">
                <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-4 mb-2">{labels.audioEyebrow}</p>
                <h2 class="text-2xl tracking-[-0.04em] font-semibold mb-7">{labels.audioTitle}</h2>
                <div class="rounded-xl border border-blue-400/20 bg-blue-400/8 p-4 mb-4">
                  <p class="text-sm leading-[1.55] text-blue-100/90">{labels.audioNote}</p>
                </div>
                <div class="grid gap-2 mt-auto font-mono text-[11px] text-text-3">
                  <div class="flex items-center justify-between rounded-lg border border-white/8 bg-black/24 px-3 py-2"><span>{labels.currentCue}</span><span class="text-green-400">live</span></div>
                  <div class="flex items-center justify-between rounded-lg border border-white/8 bg-black/24 px-3 py-2"><span>{labels.nextNote}</span><span>standby</span></div>
                  <div class="flex items-center justify-between rounded-lg border border-white/8 bg-black/24 px-3 py-2"><span>{labels.operator}</span><span>{labels.synced}</span></div>
                </div>
              </article>
            </div>

            <div class="rounded-2xl border border-red-500/20 bg-red-500/[0.055] p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-red-500/15 border border-red-500/25 flex items-center justify-center text-red-300 font-mono">01</div>
              <div>
                <h2 class="text-xl tracking-[-0.035em] font-semibold mb-1">{labels.operatorTitle}</h2>
                <p class="text-text-3 leading-[1.55]">{labels.operatorBody}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
