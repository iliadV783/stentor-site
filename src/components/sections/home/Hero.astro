---
import Eyebrow from "../../Eyebrow.astro";
import Btn from "../../Btn.astro";
import IconPlay from "../../../assets/icons/play.svg";
import IconGrid from "../../../assets/icons/grid.svg";
import IconRows from "../../../assets/icons/rows.svg";
import IconCode from "../../../assets/icons/code.svg";
import IconChartUp from "../../../assets/icons/chart-up.svg";
import IconBox from "../../../assets/icons/box.svg";
import IconCrossAxis from "../../../assets/icons/cross-axis.svg";
import IconClock from "../../../assets/icons/clock.svg";
import { hero as defaultHero } from "../../../data/home";

interface Props {
  hero?: typeof defaultHero;
}

const { hero = defaultHero } = Astro.props;
---
<section class="relative pt-24 lg:pt-[120px] pb-10 overflow-hidden">
  <div class="absolute inset-0 dotgrid dotgrid-fade pointer-events-none" aria-hidden="true"></div>
  <div class="absolute left-1/2 -translate-x-1/2 top-[540px] w-[1100px] h-[460px] pointer-events-none halo-red opacity-90" aria-hidden="true"></div>

  <div class="relative max-w-[1280px] mx-auto px-4 md:px-8 text-center">
    <Eyebrow><span class="font-mono">{hero.eyebrow}</span></Eyebrow>

    <h1 class="mt-6 mb-5 mx-auto max-w-[980px] text-5xl sm:text-6xl lg:text-[76px] leading-[0.98] tracking-[-0.045em] font-semibold" set:html={hero.title}></h1>

    <p class="text-lg leading-[1.55] text-text-2 max-w-[640px] mx-auto">{hero.description}</p>

    <div class="mt-8 inline-flex flex-wrap justify-center gap-3">
      {hero.ctas.map((cta) => (
        <Btn href={cta.href} variant={cta.variant} size="lg">
          {"icon" in cta && cta.icon === "play" && <IconPlay class="w-5 h-5" />}
          {cta.label}
          {!("icon" in cta) && <span aria-hidden="true">→</span>}
        </Btn>
      ))}
    </div>

    <div class="mt-16 lg:mt-24 flex flex-wrap justify-center items-center gap-x-4 sm:gap-x-[18px] gap-y-2 font-mono text-xs text-text-3">
      {hero.trust.map((item, i) => (
        <>
          {i > 0 && <span class="hidden sm:block w-px h-3 bg-hairline-strong"></span>}
          <span>{item.live && <><span class="text-green-400">●</span>{" "}</>}{item.label}</span>
        </>
      ))}
    </div>

    <!-- Illustrative workflow preview -->
    <div class="relative mt-16 mx-auto max-w-[1200px] border border-hairline bg-deep rounded-2xl overflow-hidden text-left shadow-[inset_0_1px_0_rgba(255,255,255,0.05),0_30px_80px_-20px_rgba(0,0,0,0.7),0_60px_120px_-20px_rgba(239,68,68,0.18)]" role="img" aria-label="Illustrative Sténtor workflow preview">
      <div class="flex items-center gap-2.5 h-10 px-3.5 border-b border-hairline bg-white/[0.02]">
        <span class="inline-flex gap-[5px]">
          <i class="w-2 h-2 rounded-full bg-chrome"></i>
          <i class="w-2 h-2 rounded-full bg-chrome"></i>
          <i class="w-2 h-2 rounded-full bg-chrome"></i>
        </span>
        <div class="flex-1 font-mono text-xs text-text-3 text-center"><span class="text-text-4">Illustrative workflow preview</span></div>
        <div class="flex gap-1.5">
          <span class="w-[22px] h-[22px] border border-hairline rounded"></span>
          <span class="w-[22px] h-[22px] border border-hairline rounded"></span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:[grid-template-columns:220px_1fr] md:h-[560px]">
        <aside class="hidden md:grid grid-rows-[auto_1fr_auto] gap-4 border-r border-hairline p-4 px-3 bg-bg">
          <div class="flex items-center gap-2.5 p-2 border border-hairline rounded-lg">
            <div class="w-6 h-6 rounded-md bg-gradient-to-br from-red-500 to-red-700"></div>
            <div class="text-xs">
              <b class="block">Live workspace</b>
              <span class="text-text-3 text-[11px]">rehearsal · local room</span>
            </div>
          </div>
          <nav class="grid gap-0.5 text-text-2 text-[13px]">
            <p class="mx-2 my-1 mt-3 text-[10px] tracking-[0.08em] uppercase text-text-4 font-medium">Project</p>
            <p class="flex items-center gap-2.5 px-2 py-1.5 rounded-md">
              <IconRows class="w-3.5 h-3.5" />
              Script
            </p>
            <p class="flex items-center gap-2.5 px-2 py-1.5 rounded-md bg-white/[0.04] text-text">
              <IconGrid class="w-3.5 h-3.5" />
              Operator view
            </p>
            <p class="flex items-center gap-2.5 px-2 py-1.5 rounded-md">
              <IconChartUp class="w-3.5 h-3.5" />
              Screens<span class="ml-auto font-mono text-[11px] text-text-3">ready</span>
            </p>
            <p class="flex items-center gap-2.5 px-2 py-1.5 rounded-md">
              <IconClock class="w-3.5 h-3.5" />
              Audio description
            </p>
            <p class="mx-2 my-1 mt-3 text-[10px] tracking-[0.08em] uppercase text-text-4 font-medium">Live</p>
            <p class="flex items-center gap-2.5 px-2 py-1.5 rounded-md">
              <IconBox class="w-3.5 h-3.5" />
              Viewer phones<span class="ml-auto font-mono text-[11px] text-text-3">synced</span>
            </p>
            <p class="flex items-center gap-2.5 px-2 py-1.5 rounded-md">
              <IconCode class="w-3.5 h-3.5" />
              Languages<span class="ml-auto font-mono text-[11px] text-text-3">IT · EN</span>
            </p>
            <p class="flex items-center gap-2.5 px-2 py-1.5 rounded-md">
              <IconCrossAxis class="w-3.5 h-3.5" />
              Operator notes
            </p>
          </nav>
          <div class="flex items-center gap-2.5 p-2 -mx-3 -mb-4 border-t border-hairline">
            <div class="w-6 h-6 rounded-full bg-chrome"></div>
            <div>
              <b class="text-xs font-medium">Operator</b>
              <span class="block text-[11px] text-text-3">workflow preview</span>
            </div>
          </div>
        </aside>

        <main class="p-5">
          <div class="flex items-center justify-between mb-[18px]">
            <h2 class="text-lg tracking-[-0.02em]">Operator workflow</h2>
            <div class="font-mono text-[11px] text-text-3">example project</div>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
            <div class="border border-hairline rounded-[10px] py-3 px-3.5 bg-sunken">
              <div class="font-mono text-[11px] text-text-3">Current cue</div>
              <div class="text-[22px] tracking-[-0.03em] mt-1.5">Cue</div>
              <div class="font-mono text-[11px] mt-0.5 text-green-400">live</div>
            </div>
            <div class="border border-hairline rounded-[10px] py-3 px-3.5 bg-sunken">
              <div class="font-mono text-[11px] text-text-3">Viewer phones</div>
              <div class="text-[22px] tracking-[-0.03em] mt-1.5">Synced</div>
              <div class="font-mono text-[11px] mt-0.5 text-green-400">following</div>
            </div>
            <div class="border border-hairline rounded-[10px] py-3 px-3.5 bg-sunken">
              <div class="font-mono text-[11px] text-text-3">Screens</div>
              <div class="text-[22px] tracking-[-0.03em] mt-1.5">Ready</div>
              <div class="font-mono text-[11px] mt-0.5 text-green-400">connected</div>
            </div>
            <div class="border border-hairline rounded-[10px] py-3 px-3.5 bg-sunken">
              <div class="font-mono text-[11px] text-text-3">Languages</div>
              <div class="text-[22px] tracking-[-0.03em] mt-1.5">IT · EN</div>
              <div class="font-mono text-[11px] mt-0.5 text-green-400">ready</div>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:[grid-template-columns:1.35fr_1fr] gap-3">
            <div class="grid gap-3">
              <div class="border border-hairline rounded-[10px] bg-sunken overflow-hidden">
                <div class="flex items-center justify-between px-3.5 py-2.5 border-b border-hairline text-xs text-text-2">
                  <span>Current cue</span>
                  <span class="font-mono text-[11px] text-green-400">live</span>
                </div>
                <div class="p-6 min-h-[140px] flex flex-col justify-center">
                  <p class="text-3xl lg:text-[38px] leading-[1.12] tracking-[-0.04em] font-semibold text-text">“{hero.mock.currentCue.text}”</p>
                  <p class="mt-4 font-mono text-xs text-text-3">surtitles · screen preview</p>
                </div>
              </div>
              <div class="border border-hairline rounded-[10px] bg-sunken overflow-hidden">
                <div class="flex items-center justify-between px-3.5 py-2.5 border-b border-hairline text-xs text-text-2">
                  <span>Next cue</span>
                  <span class="font-mono text-[11px] text-text-3">standby</span>
                </div>
                <div class="p-5 min-h-[110px] flex flex-col justify-center">
                  <p class="text-2xl lg:text-[28px] leading-[1.14] tracking-[-0.035em] text-text-2">“{hero.mock.nextCue.text}”</p>
                  <p class="mt-3 font-mono text-xs text-text-3">operator preview</p>
                </div>
              </div>
            </div>

            <div class="border border-hairline rounded-[10px] bg-sunken overflow-hidden">
              <div class="flex items-center justify-between px-3.5 py-2.5 border-b border-hairline text-xs text-text-2">
                <span>Live notes</span>
                <span class="font-mono text-[11px] text-text-3">synced</span>
              </div>
              <div class="font-mono text-[11px] py-1.5">
                <div class="grid [grid-template-columns:44px_1fr] gap-2.5 px-3.5 py-1.5 border-b border-dashed border-white/5 text-text-2 items-start">
                  <span class="px-1.5 py-px rounded-sm text-[10px] tracking-[0.04em] inline-block w-fit text-green-400 bg-green-400/10">cue</span>
                  <span class="text-text">cue sent to screens <span class="text-text-3">· live</span></span>
                </div>
                <div class="grid [grid-template-columns:44px_1fr] gap-2.5 px-3.5 py-1.5 border-b border-dashed border-white/5 text-text-2 items-start">
                  <span class="px-1.5 py-px rounded-sm text-[10px] tracking-[0.04em] inline-block w-fit text-green-400 bg-green-400/10">web</span>
                  <span class="text-text">viewer phones <span class="text-text-3">· synced</span></span>
                </div>
                <div class="grid [grid-template-columns:44px_1fr] gap-2.5 px-3.5 py-1.5 border-b border-dashed border-white/5 text-text-2 items-start">
                  <span class="px-1.5 py-px rounded-sm text-[10px] tracking-[0.04em] inline-block w-fit text-blue-400 bg-blue-400/10">AD</span>
                  <span class="text-text">audio description note <span class="text-text-3">· ready</span></span>
                </div>
                <div class="grid [grid-template-columns:44px_1fr] gap-2.5 px-3.5 py-1.5 border-b border-dashed border-white/5 text-text-2 items-start">
                  <span class="px-1.5 py-px rounded-sm text-[10px] tracking-[0.04em] inline-block w-fit text-green-400 bg-green-400/10">note</span>
                  <span class="text-text">operator note <span class="text-text-3">· saved</span></span>
                </div>
                <div class="grid [grid-template-columns:44px_1fr] gap-2.5 px-3.5 py-1.5 text-text-2 items-start">
                  <span class="px-1.5 py-px rounded-sm text-[10px] tracking-[0.04em] inline-block w-fit text-red-500 bg-red-500/10">next</span>
                  <span class="text-text">next cue preview <span class="text-text-3">· standby</span></span>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </div>
</section>
