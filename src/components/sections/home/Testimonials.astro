---
import { testimonials as defaultTestimonials } from "../../../data/home";

interface Props {
  testimonials?: typeof defaultTestimonials;
}

const { testimonials = defaultTestimonials } = Astro.props;
---
<section class="py-24" id="customers">
  <div class="max-w-[1280px] mx-auto px-4 md:px-8">
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-4 mb-6">
      <h2 class="text-3xl md:text-4xl tracking-[-0.035em] max-w-[640px] font-semibold" set:html={testimonials.title}></h2>
      <p class="text-text-2 max-w-[420px]">{testimonials.description}</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.quotes.map((q) => (
        <div class="flex flex-col gap-6 bg-surface border border-hairline rounded-xl p-7">
          <p class="text-base leading-[1.55] text-zinc-200 m-0">{q.text}</p>
          <div class="flex items-center gap-3 mt-auto">
            <div class="w-10 h-10 rounded-full border border-hairline-strong grid place-items-center font-mono text-[13px] text-text-2 bg-gradient-to-br from-raised to-sunken">{q.av}</div>
            <div>
              <b class="block font-medium text-sm">{q.name}</b>
              <span class="block text-xs text-text-3">{q.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
