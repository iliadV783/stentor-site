---
import { metrics as defaultMetrics } from "../../../data/home";

interface Props {
  metrics?: typeof defaultMetrics;
}

const { metrics = defaultMetrics } = Astro.props;
---
<section class="py-16">
  <div class="max-w-[1280px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:[grid-template-columns:2fr_1fr_1fr_1fr] border border-hairline rounded-xl bg-surface overflow-hidden">
      <div class="flex flex-col justify-center gap-2.5 px-7 py-7 lg:px-9 bg-gradient-to-b from-stentor/[0.04] to-transparent border-b md:border-b-0 md:border-r border-hairline">
        <h3 class="text-[22px] tracking-[-0.025em] leading-[1.15] font-semibold max-w-[280px]" set:html={metrics.title}></h3>
        <p class="text-[13px] text-text-3 leading-[1.5] max-w-[320px] m-0">{metrics.description}</p>
      </div>
      {metrics.items.map((item, i) => (
        <div class:list={[
          "flex flex-col justify-center px-6 py-6 lg:px-7",
          i < metrics.items.length - 1 && "border-b md:border-b-0 md:border-r border-hairline",
        ]}>
          <div class="text-[32px] tracking-[-0.035em] font-semibold leading-none">{item.value}<em class="not-italic font-medium text-stentor">{item.suffix}</em></div>
          <div class="text-xs text-text-2 mt-2 leading-[1.4]">{item.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
