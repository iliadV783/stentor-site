  locale?: "it" | "en" | "fr" | "es" | "de";
}

const { locale = "it" } = Astro.props;

const copy = {
  it: {
    kicker: "Dentro Sténtor",
    stageLine: "Domani, e domani, e domani,",
    title: "Dal copione alla sala,<br/>nello stesso ambiente.",
    intro: "Prepara il testo, vai in scena e porta sottotitoli, traduzioni e accessibilità fino al pubblico.",
    explore: "Esplora tutte le funzioni",
    features: "/it/features/",
    live: "In scena",
    text: "TESTO",
    currentCue: "CUE CORRENTE",
    screens: "SCHERMI",
    screensReady: "2 pronti",
    audience: "PUBBLICO",
    audienceConnected: "18 connessi",
    next: "SUCCESSIVO",
    forward: "Avanti",
    screen: "SCHERMO",
    phoneIntro: "Segui lo spettacolo sul tuo dispositivo.",
    subtitles: "Sottotitoli",
    translation: "Traduzione",
    ad: "Audiodescrizione",
    enter: "Entra nello spettacolo",
    prepare: "PREPARA",
    prepareText: "Testo, lingue e audiodescrizione.",
    liveStep: "VAI IN SCENA",
    liveText: "Regia, cue e schermi.",
    reach: "RAGGIUNGI IL PUBBLICO",
    reachText: "Telefoni, accessibilità e feedback.",
  },
  en: {
    kicker: "Inside Sténtor",
    stageLine: "Tomorrow, and tomorrow, and tomorrow,",
    title: "From script to stage,<br/>in one environment.",
    intro: "Prepare the text, go live and bring surtitles, translations and accessibility all the way to the audience.",
    explore: "Explore all features",
    features: "/features/",
    live: "Live",
    text: "TEXT",
    currentCue: "CURRENT CUE",
    screens: "SCREENS",
    screensReady: "2 ready",
    audience: "AUDIENCE",
    audienceConnected: "18 connected",
    next: "NEXT",
    forward: "Forward",
    screen: "SCREEN",
    phoneIntro: "Follow the performance on your device.",
    subtitles: "Surtitles",
    translation: "Translation",
    ad: "Audio description",
    enter: "Enter performance",
    prepare: "PREPARE",
    prepareText: "Text, languages and audio description.",
    liveStep: "GO LIVE",
    liveText: "Stage desk, cues and screens.",
    reach: "REACH THE AUDIENCE",
    reachText: "Phones, accessibility and feedback.",
  },
  fr: {
    kicker: "Dans Sténtor",
    stageLine: "Demain, et demain, et demain,",
    title: "Du texte à la scène,<br/>dans un même environnement.",
    intro: "Préparez le texte, passez en régie et diffusez surtitres, traductions et accessibilité jusqu’au public.",
    explore: "Découvrir toutes les fonctions",
    features: "/fr/features/",
    live: "En scène",
    text: "TEXTE",
    currentCue: "CUE ACTUEL",
    screens: "ÉCRANS",
    screensReady: "2 prêts",
    audience: "PUBLIC",
    audienceConnected: "18 connectés",
    next: "SUIVANT",
    forward: "Avancer",
    screen: "ÉCRAN",
    phoneIntro: "Suivez le spectacle sur votre appareil.",
    subtitles: "Surtitres",
    translation: "Traduction",
    ad: "Audiodescription",
    enter: "Entrer dans le spectacle",
    prepare: "PRÉPARER",
    prepareText: "Texte, langues et audiodescription.",
    liveStep: "PASSER EN SCÈNE",
    liveText: "Régie, cues et écrans.",
    reach: "REJOINDRE LE PUBLIC",
    reachText: "Téléphones, accessibilité et retours.",
  },
  es: {
    kicker: "Dentro de Sténtor",
    stageLine: "Mañana, y mañana, y mañana,",
    title: "Del texto al escenario,<br/>en un mismo entorno.",
    intro: "Prepara el texto, pasa a escena y lleva sobretítulos, traducciones y accesibilidad hasta el público.",
    explore: "Explorar todas las funciones",
    features: "/es/features/",
    live: "En escena",
    text: "TEXTO",
    currentCue: "CUE ACTUAL",
    screens: "PANTALLAS",
    screensReady: "2 listas",
    audience: "PÚBLICO",
    audienceConnected: "18 conectados",
    next: "SIGUIENTE",
    forward: "Avanzar",
    screen: "PANTALLA",
    phoneIntro: "Sigue el espectáculo en tu dispositivo.",
    subtitles: "Sobretítulos",
    translation: "Traducción",
    ad: "Audiodescripción",
    enter: "Entrar al espectáculo",
    prepare: "PREPARA",
    prepareText: "Texto, idiomas y audiodescripción.",
