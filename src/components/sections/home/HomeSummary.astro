  de: {
    kicker: "In Sténtor",
    stageLine: "Morgen, und morgen, und morgen,",
    title: "Vom Text auf die Bühne,<br/>in einer Umgebung.",
    intro: "Bereite den Text vor, gehe live und bringe Übertitel, Übersetzungen und Barrierefreiheit bis zum Publikum.",
    explore: "Alle Funktionen entdecken",
    features: "/de/features/",
    live: "Live",
    text: "TEXT",
    currentCue: "AKTUELLER CUE",
    screens: "BILDSCHIRME",
    screensReady: "2 bereit",
    audience: "PUBLIKUM",
    audienceConnected: "18 verbunden",
    next: "NÄCHSTER",
    forward: "Weiter",
    screen: "BILDSCHIRM",
    phoneIntro: "Verfolge die Aufführung auf deinem Gerät.",
    subtitles: "Übertitel",
    translation: "Übersetzung",
    ad: "Audiodeskription",
    enter: "Zur Aufführung",
    prepare: "VORBEREITEN",
    prepareText: "Text, Sprachen und Audiodeskription.",
    liveStep: "LIVE GEHEN",
    liveText: "Regie, Cues und Bildschirme.",
    reach: "PUBLIKUM ERREICHEN",
    reachText: "Telefone, Barrierefreiheit und Feedback.",
  },
}[locale];
---

<section class="home-summary">
  <div class="max-w-[1180px] mx-auto px-4 md:px-8">

    <div class="summary-heading">
      <div>
        <p class="summary-kicker">{copy.kicker}</p>
        <h2 set:html={copy.title}></h2>
      </div>

      <div class="summary-intro">
        <p>{copy.intro}</p>

        <a href={copy.features} class="summary-link">
          {copy.explore} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>


    <!-- UNICA SCENA PRODOTTO -->
    <div class="product-scene">

      <div class="scene-toolbar">
        <div class="scene-dots"></div>
        <b>Sténtor</b>
        <span>Macbeth.stn</span>

        <div class="scene-live">
          <i></i>
          {copy.live}
        </div>
      </div>

      <div class="scene-layout">

        <!-- TESTO -->
        <aside class="scene-cues">
          <small>{copy.text}</small>

          <div>
            <span>021</span>
            <b>DUNCAN</b>
          </div>

          <div>
            <span>022</span>
            <b>MACBETH</b>
          </div>

          <div class="active">
            <span>023</span>
            <b>MACBETH</b>
          </div>

          <div>
            <span>024</span>
            <b>MACBETH</b>
          </div>
        </aside>


        <!-- REGIA -->
        <main class="scene-stage">
          <div class="stage-status">
            <span>
              <small>{copy.currentCue}</small>
              <b>023</b>
            </span>

            <span>
              <small>{copy.screens}</small>
              <b>{copy.screensReady}</b>
            </span>

            <span>
              <small>{copy.audience}</small>
              <b>{copy.audienceConnected}</b>
            </span>
          </div>

          <div class="stage-copy">
            <small>MACBETH</small>
            <h3>{copy.stageLine}</h3>


          </div>

          <div class="stage-bottom">
            <span>
              <small>{copy.next}</small>
              <b>024 · Macbeth</b>
            </span>

            <button>{copy.forward} →</button>
          </div>
        </main>


        <!-- OUTPUT -->
        <aside class="scene-output">

          <div class="mini-screen">
            <div>
              <small>{copy.screen} · EN</small>
            </div>

            <strong>
              Tomorrow, and tomorrow,<br/>
              and tomorrow,
            </strong>

            <span>Cue 023</span>
          </div>


          <div class="mini-phone">
            <small>STÉNTOR</small>
            <h4>Macbeth</h4>
            <p>{copy.phoneIntro}</p>

            <span>{copy.subtitles}</span>
            <span>{copy.translation}</span>
            <span>{copy.ad}</span>

            <b>{copy.enter}</b>
          </div>

        </aside>

      </div>
    </div>


    <!-- TRE CONCETTI -->
    <div class="summary-steps">

      <article>
        <span>01</span>
        <div>
          <p>{copy.prepare}</p>
          <h3>{copy.prepareText}</h3>
        </div>
      </article>

      <article>
        <span>02</span>
        <div>
          <p>{copy.liveStep}</p>
          <h3>{copy.liveText}</h3>
        </div>
      </article>

      <article>
        <span>03</span>
        <div>
          <p>{copy.reach}</p>
          <h3>{copy.reachText}</h3>
        </div>
      </article>

    </div>

  </div>
</section>


<style>
  @reference "../../../styles/global.css";

  .home-summary {
    @apply py-20 lg:py-28 border-t border-hairline;
  }

  .summary-heading {
    @apply grid lg:grid-cols-[1.15fr_.85fr] gap-8 lg:gap-16 items-end;
  }

  .summary-kicker {
    @apply font-mono text-[10px] uppercase tracking-[.11em] text-stentor mb-4;
  }

  .summary-heading h2 {
    @apply text-4xl sm:text-5xl lg:text-[58px] leading-[1.01] tracking-[-.045em] font-semibold;
  }

  .summary-intro {
    @apply lg:pb-1;
  }

  .summary-intro p {
    @apply text-lg leading-relaxed text-text-2 max-w-[480px];
  }

  .summary-link {
    @apply inline-flex items-center gap-2 mt-5 text-sm font-medium text-stentor;
  }


  /* PRODUCT SCENE */

  .product-scene {
    @apply mt-12 lg:mt-16 overflow-hidden rounded-2xl border border-slate-700 bg-[#09111e] text-white;
    box-shadow: 0 40px 100px -65px rgba(8,20,40,.85);
  }

  .scene-toolbar {
    @apply h-12 px-4 md:px-5 flex items-center gap-3 border-b border-slate-800 bg-[#101827] font-mono text-[9px] text-slate-500;
  }

  .scene-toolbar b {
    @apply text-white font-medium;
  }

  .scene-dots {
    width: 27px;
    height: 8px;
    flex: 0 0 auto;
    background:
      radial-gradient(circle at 4px 4px, #64748b 0 3px, transparent 3.5px),
      radial-gradient(circle at 13px 4px, #64748b 0 3px, transparent 3.5px),
      radial-gradient(circle at 22px 4px, #64748b 0 3px, transparent 3.5px);
  }

  .scene-live {
    @apply ml-auto flex items-center gap-1.5 text-green-400;
  }

  .scene-live i {
    @apply block w-1.5 h-1.5 rounded-full bg-green-400;
  }

  .scene-layout {
    @apply grid lg:grid-cols-[170px_1fr_240px];
    min-height: 490px;
  }


  /* CUES */

  .scene-cues {
    @apply hidden lg:block bg-[#0d1421] border-r border-slate-800 p-3;
  }

  .scene-cues > small {
    @apply block p-2 mb-2 font-mono text-[8px] tracking-[.08em] text-slate-500;
  }

  .scene-cues div {
    @apply grid grid-cols-[30px_1fr] items-center gap-2 rounded-md px-2 py-3 text-[10px] text-slate-500;
  }

  .scene-cues div b {
    @apply font-medium text-slate-300;
  }

  .scene-cues div.active {
    @apply bg-stentor text-blue-100;
  }

  .scene-cues div.active b {
    @apply text-white;
  }


  /* STAGE */

  .scene-stage {
    @apply flex flex-col min-w-0;
  }

  .stage-status {
    @apply grid grid-cols-3 gap-px bg-slate-800 border-b border-slate-800;
  }

  .stage-status span {
    @apply bg-[#0d1421] px-3 md:px-4 py-3;
  }

  .stage-status small {
    @apply block font-mono text-[7px] md:text-[8px] text-slate-500 mb-1;
  }

  .stage-status b {
    @apply block text-[9px] md:text-[10px] text-slate-300 font-medium;
  }

  .stage-copy {
    @apply flex-1 p-6 md:p-8 flex flex-col justify-center;
  }

  .stage-copy > small {
    @apply font-mono text-[9px] tracking-[.08em] text-blue-300;
  }

  .stage-copy h3 {
    @apply mt-3 text-3xl md:text-4xl lg:text-[42px] leading-[1.08] tracking-[-.04em] font-medium max-w-[620px];
  }

  .translation {
    @apply grid grid-cols-[34px_1fr] gap-3 mt-8 pt-4 border-t border-slate-800;
  }

  .translation span {
    @apply font-mono text-[9px] text-blue-300;
  }

  .translation p {
    @apply text-sm text-slate-400;
  }

  .stage-bottom {
    @apply flex items-center justify-between gap-4 px-6 md:px-8 py-4 border-t border-slate-800;
  }

  .stage-bottom small {
    @apply block font-mono text-[7px] text-slate-500;
  }

  .stage-bottom b {
    @apply text-[10px] text-slate-300 font-medium;
  }

  .stage-bottom button {
    @apply rounded-md bg-stentor px-5 py-2.5 text-[10px] text-white;
  }


  /* OUTPUT */

  .scene-output {
    @apply hidden md:grid grid-cols-2 lg:grid-cols-1 gap-3 p-4 border-t lg:border-t-0 lg:border-l border-slate-800 bg-[#0c1320];
  }

  .mini-screen {
    @apply min-h-[190px] rounded-lg bg-black p-4 flex flex-col justify-between;
  }

  .mini-screen small,
  .mini-screen span {
    @apply font-mono text-[7px] text-slate-500;
  }

  .mini-screen strong {
    @apply text-base leading-snug font-medium;
  }

  .mini-phone {
    @apply mx-auto w-[150px] rounded-[24px] border-[4px] border-slate-700 bg-[#111827] px-4 pt-6 pb-4 flex flex-col;
  }

  .mini-phone > small {
    @apply font-mono text-[7px] text-blue-300;
  }

  .mini-phone h4 {
    @apply text-base font-semibold mt-4;
  }

  .mini-phone p {
    @apply text-[8px] text-slate-400 mt-1 mb-4 leading-relaxed;
  }

  .mini-phone > span {
    @apply text-[8px] border border-slate-700 rounded px-2 py-1.5 mb-1.5;
  }

  .mini-phone > b {
    @apply mt-3 rounded bg-stentor py-2 text-center text-[7px] font-medium;
  }


  /* THREE IDEAS */

  .summary-steps {
    @apply grid md:grid-cols-3 mt-6 border-t border-l border-hairline;
  }

  .summary-steps article {
    @apply min-h-[150px] p-5 md:p-6 border-r border-b border-hairline bg-surface flex gap-4;
  }

  .summary-steps article > span {
    @apply font-mono text-[9px] text-text-3 pt-1;
  }

  .summary-steps p {
    @apply font-mono text-[9px] tracking-[.1em] text-stentor mb-2;
  }

  .summary-steps h3 {
    @apply text-xl leading-snug tracking-[-.025em] font-medium;
  }


  @media (max-width: 767px) {
    .home-summary {
      @apply py-16;
    }

    .summary-heading h2 {
      @apply text-[42px];
    }

    .product-scene {
      @apply mt-9;
    }

    .scene-layout {
      grid-template-columns: 1fr;
      min-height: 420px;
    }

    .scene-output {
      display: none;
    }

    .stage-copy h3 {
      @apply text-[32px];
    }

    .summary-steps {
      grid-template-columns: 1fr;
    }

    .summary-steps article {
      min-height: 0;
    }
  }
</style>
