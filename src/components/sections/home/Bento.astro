---
const locale = Astro.url.pathname.split("/").filter(Boolean)[0] || "en";
---

{locale === "it" && (
<section class="product-story" id="inside-stentor">
  <div class="max-w-[1280px] mx-auto px-4 md:px-8">

    <header class="product-story__intro">
      <div>
        <p class="product-kicker">Dentro Sténtor</p>
        <h2>Dalla prima battuta<br/>allo spettacolo dal vivo.</h2>
      </div>

      <p>
        Testo, traduzioni, accessibilità, schermi, pubblico e regia
        restano nello stesso ambiente di lavoro.
      </p>
    </header>


    <!-- =========================================================
         TESTO
    ========================================================== -->
    <article class="story-step story-step--hero">
      <div class="story-copy">
        <span class="story-number">01</span>
        <p class="story-label">Testo</p>
        <h3>Prepara il copione.</h3>
        <p>
          Organizza le battute, assegna personaggi e tipi di riga,
          prepara traduzioni e contenuti che accompagneranno lo spettacolo.
        </p>
