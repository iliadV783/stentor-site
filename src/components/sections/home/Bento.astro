<script is:inline>
  (() => {
    const demos = document.querySelectorAll("[data-regia-demo]");

    const cues = [
      {
        number: "021",
        speaker: "DUNCAN",
        line: "È tempo di entrare.",
        next: "022 · Lady Macbett",
        screen: "It is time to enter."
      },
      {
        number: "022",
        speaker: "LADY MACBETT",
        line: "Il silenzio è caduto sulla sala.",
        next: "023 · Macbett",
        screen: "Silence has fallen over the hall."
      },
      {
        number: "023",
        speaker: "MACBETT",
        line: "Non resta che attraversare la notte.",
        next: "024 · Guardia",
        screen: "We need only cross the night."
      },
      {
        number: "024",
        speaker: "GUARDIA",
        line: "Qualcuno si avvicina.",
        next: "Fine sequenza",
        screen: "Someone is approaching."
      }
    ];

    demos.forEach((demo) => {
      let index = 1;

      const number = demo.querySelector("[data-current-number]");
      const speaker = demo.querySelector("[data-current-speaker]");
      const line = demo.querySelector("[data-current-line]");
      const nextCue = demo.querySelector("[data-next-cue]");
      const screenLine = demo.querySelector("[data-screen-line]");
      const phoneLine = demo.querySelector("[data-phone-line]");
      const buttons = demo.querySelectorAll("[data-cue-select]");

      const render = () => {
        const cue = cues[index];

        number.textContent = cue.number;
        speaker.textContent = cue.speaker;
        line.textContent = cue.line;
        nextCue.textContent = cue.next;
        screenLine.textContent = cue.screen;
        phoneLine.textContent = cue.screen;

        buttons.forEach((btn, buttonIndex) => {
          btn.classList.toggle("is-current", buttonIndex === index);
        });
      };

      demo.querySelector("[data-regia-prev]")?.addEventListener("click", () => {
        index = Math.max(0, index - 1);
        render();
      });

      demo.querySelector("[data-regia-next]")?.addEventListener("click", () => {
        index = Math.min(cues.length - 1, index + 1);
        render();
      });

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          index = Number(btn.dataset.cueSelect);
          render();
        });
      });
    });
  })();
</script>

