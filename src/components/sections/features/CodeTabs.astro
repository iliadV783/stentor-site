---
import { codeTabs as defaultCodeTabs } from "../../../data/features";

interface Props {
  codeTabs?: typeof defaultCodeTabs;
}

const { codeTabs = defaultCodeTabs } = Astro.props;
---
<section class="py-24" x-data="{tab:'ts'}">
  <div class="max-w-[1280px] mx-auto px-4 md:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
      <h2 class="text-3xl md:text-4xl tracking-[-0.035em] max-w-[640px] leading-[1.1] font-semibold">{codeTabs.title}</h2>
      <p class="text-text-2 max-w-[420px]">{codeTabs.description}</p>
    </div>
    <div class="bg-surface border border-hairline rounded-xl overflow-hidden">
      <div class="flex items-center gap-1 px-3.5 pb-2 pt-3.5 border-b border-hairline overflow-x-auto overflow-y-hidden" role="tablist" aria-label="Code examples">
        {codeTabs.tabs.map((t) => (
          <button
            role="tab"
            id={`codetab-${t.id}`}
            aria-controls={`codepanel-${t.id}`}
            :aria-selected={`tab==='${t.id}' ? 'true' : 'false'`}
            :tabindex={`tab==='${t.id}' ? '0' : '-1'`}
            @click={`tab='${t.id}'`}
            :class={`tab==='${t.id}' ? 'text-stentor border-hairline border-b-surface bg-surface' : 'text-text-3 border-transparent'`}
            class="appearance-none border border-transparent border-b-0 font-mono text-xs px-3.5 py-2.5 rounded-t-md cursor-pointer relative top-px whitespace-nowrap"
          >{t.label}<span class="text-text-4 ml-1.5 text-[11px]">{t.count}</span></button>
        ))}
      </div>
      <div class="p-7 min-h-[360px] font-mono text-[12.5px] leading-[1.65] text-text-2 overflow-x-auto">
        <div x-show="tab==='ts'" role="tabpanel" id="codepanel-ts" aria-labelledby="codetab-ts">
          <div class="text-text-4 mb-3.5">{`// Structured project file: metadata, languages, cues and outputs.`}</div>
          <pre class="m-0 p-0 whitespace-pre-wrap"><code>{`{`}
  <span class="tok-str">"title"</span>: <span class="tok-str">"Macbett"</span>,
  <span class="tok-str">"languages"</span>: [<span class="tok-str">"it"</span>, <span class="tok-str">"en"</span>, <span class="tok-str">"fr"</span>],
  <span class="tok-str">"layers"</span>: [<span class="tok-str">"surtitles"</span>, <span class="tok-str">"translation"</span>, <span class="tok-str">"audio_description"</span>],
  <span class="tok-str">"screens"</span>: <span class="tok-num">2</span>,
  <span class="tok-str">"audience"</span>: <span class="tok-str">"local_network"</span>
{`}`}</code></pre>
        </div>
        <div x-show="tab==='go'" role="tabpanel" id="codepanel-go" aria-labelledby="codetab-go" x-cloak>
          <div class="text-text-4 mb-3.5">{`// A cue keeps source text, translation and operator context together.`}</div>
          <pre class="m-0 p-0 whitespace-pre-wrap"><code>{`{`}
  <span class="tok-str">"cue"</span>: <span class="tok-num">24</span>,
  <span class="tok-str">"speaker"</span>: <span class="tok-str">""</span>,
  <span class="tok-str">"source"</span>: <span class="tok-str">"O patria mia..."</span>,
  <span class="tok-str">"translation"</span>: <span class="tok-str">"O my country, poor country!"</span>,
  <span class="tok-str">"operator_note"</span>: <span class="tok-str">"hold until light change"</span>
{`}`}</code></pre>
        </div>
        <div x-show="tab==='py'" role="tabpanel" id="codepanel-py" aria-labelledby="codetab-py" x-cloak>
          <div class="text-text-4 mb-3.5"># Audio-description notes stay linked to the live text.</div>
          <pre class="m-0 p-0 whitespace-pre-wrap"><code>{`{`}
  <span class="tok-str">"audio_description"</span>: {`{`}
    <span class="tok-str">"cue"</span>: <span class="tok-num">24</span>,
    <span class="tok-str">"note"</span>: <span class="tok-str">"Macbett crosses slowly toward the table."</span>,
    <span class="tok-str">"audio_file"</span>: <span class="tok-str">"ad_024.m4a"</span>
  {`}`}
{`}`}</code></pre>
        </div>
        <div x-show="tab==='curl'" role="tabpanel" id="codepanel-curl" aria-labelledby="codetab-curl" x-cloak>
          <div class="text-text-4 mb-3.5"># Live state sent by the operator desk.</div>
          <pre class="m-0 p-0 whitespace-pre-wrap"><code>{`{`}
  <span class="tok-str">"state"</span>: <span class="tok-str">"live"</span>,
  <span class="tok-str">"currentCue"</span>: <span class="tok-num">24</span>,
  <span class="tok-str">"blackout"</span>: <span class="tok-kw">false</span>,
  <span class="tok-str">"screens"</span>: [<span class="tok-str">"screen-1"</span>, <span class="tok-str">"screen-2"</span>],
  <span class="tok-str">"audiencePhones"</span>: <span class="tok-num">18</span>
{`}`}</code></pre>
        </div>
        <div x-show="tab==='resp'" role="tabpanel" id="codepanel-resp" aria-labelledby="codetab-resp" x-cloak>
          <div class="text-text-4 mb-3.5">{`// Audience view receives the selected language and mode.`}</div>
          <pre class="m-0 p-0 whitespace-pre-wrap"><code>{`{`}
  <span class="tok-str">"device"</span>: <span class="tok-str">"audience-phone"</span>,
  <span class="tok-str">"language"</span>: <span class="tok-str">"fr"</span>,
  <span class="tok-str">"mode"</span>: <span class="tok-str">"surtitles_and_audio_description"</span>,
  <span class="tok-str">"text"</span>: <span class="tok-str">"Ô mon pays, pauvre pays !"</span>
{`}`}</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [x-cloak] { display: none !important; }
</style>
