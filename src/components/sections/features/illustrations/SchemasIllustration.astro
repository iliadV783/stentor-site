---
/**
 * Schemas illustration — visual companion to the "Schemas" showcase row.
 * Self-contained: replace this file's content with your own markup or SVG
 * to swap the visual without touching Showcase.astro.
 */
import IconTable from "../../../../assets/icons/table.svg";
---
<div class="illus">
  <div class="illus__bar">
    <span><span class="font-mono">schemas/billing.lambda.ts</span> · <span class="text-green-400">●</span> synced</span>
    <span class="font-mono">v 142 · 0.3s</span>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6">
    <div class="schema-table">
      <div class="schema-table__hd"><IconTable class="w-4 h-4 text-text-3" /><b class="text-stentor font-medium">customers</b></div>
      <div class="schema-table__row"><span><span class="text-stentor">id</span> · text</span><span class="text-text-4 text-[11px]">PK</span></div>
      <div class="schema-table__row"><span>email · text</span><span class="text-text-4 text-[11px]">UNIQUE</span></div>
      <div class="schema-table__row"><span>tier · enum</span><span class="text-text-4 text-[11px]">free|pro|ent</span></div>
      <div class="schema-table__row"><span>created_at · ts</span><span class="text-text-4 text-[11px]">now()</span></div>
    </div>
    <div class="schema-table">
      <div class="schema-table__hd"><IconTable class="w-4 h-4 text-text-3" /><b class="text-stentor font-medium">subscriptions</b></div>
      <div class="schema-table__row"><span><span class="text-stentor">id</span> · text</span><span class="text-text-4 text-[11px]">PK</span></div>
      <div class="schema-table__row"><span><span class="text-blue-400">customer_id</span> · text</span><span class="text-text-4 text-[11px]">FK</span></div>
      <div class="schema-table__row"><span>plan · ref(Plan)</span><span class="text-text-4 text-[11px]">FK</span></div>
      <div class="schema-table__row"><span>status · enum</span><span class="text-text-4 text-[11px]">3 vals</span></div>
      <div class="schema-table__row"><span>renews_at · ts</span><span class="text-text-4 text-[11px]">nullable</span></div>
    </div>
    <div class="md:col-span-2">
      <div class="illus__bar border-y border-hairline gap-2">
        <span class="font-mono truncate min-w-0">.lambda/generated/clients/typescript.ts</span>
        <span class="tag tag--green flex-none">type-safe</span>
      </div>
      <pre class="px-5 py-4 m-0 font-mono text-[12.5px] leading-[1.65] text-text-2 whitespace-pre-wrap"><code><span class="tok-cm"><span class="tok-ln">1</span>{`// Auto-generated. Edit billing.lambda.ts instead.`}</span>
<span class="tok-ln">2</span><span class="tok-kw">const</span> sub = <span class="tok-kw">await</span> lambda.<span class="tok-fn">subscriptions</span>.<span class="tok-fn">create</span>({`({`}
<span class="tok-ln">3</span>  customer: customer.id,
<span class="tok-ln">4</span>  plan:     <span class="tok-str">"pro_monthly"</span>,
<span class="tok-ln">5</span>  status:   <span class="tok-str">"active"</span>,         <span class="tok-cm">{`// ← autocompletes`}</span>
<span class="tok-ln">6</span>{`});`}</code></pre>
    </div>
  </div>
</div>

<style>
  @reference "../../../../styles/global.css";
  .illus {
    @apply bg-surface border border-hairline rounded-xl overflow-hidden shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)];
  }
  .illus__bar {
    @apply flex items-center justify-between px-3.5 py-2.5 border-b border-hairline font-mono text-[11px] text-text-3 bg-surface-2;
  }
  .schema-table {
    @apply border border-hairline rounded-lg bg-deep overflow-hidden font-mono text-xs;
  }
  .schema-table__hd {
    @apply flex items-center gap-2 px-3 py-2 border-b border-hairline;
  }
  .schema-table__row {
    @apply grid grid-cols-[1fr_auto] gap-2 px-3 py-1.5 border-b last:border-b-0 border-dashed border-hairline-strong text-text-2;
  }
  .tag {
    @apply inline-flex items-center gap-1.5 font-mono text-[11px] px-2 py-0.5 rounded-sm bg-surface-2 text-text-2 border border-hairline whitespace-nowrap;
  }
  .tag--green { @apply text-green-400 bg-green-400/10 border-green-400/20; }
</style>
