---
/**
 * Regions illustration — visual companion to the "Edge runtime" showcase row.
 * Reads `regions` from src/data/features.ts. Replace this file's content
 * with your own markup to swap the visual without touching Showcase.astro.
 */
import { regions } from "../../../../data/features";
---
<div class="illus">
  <div class="illus__bar">
    <span><span class="font-mono">edge · live</span></span>
    <span class="font-mono text-text-3">38 regions · last 60s</span>
  </div>
  <div class="p-5">
    <div class="relative h-[200px] rounded-lg bg-deep border border-hairline overflow-hidden">
      <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:28px_28px]"></div>
      {regions.map((r) => (
        <>
          <span class="absolute w-2.5 h-2.5 rounded-full bg-stentor -translate-x-1/2 -translate-y-1/2 shadow-[0_0_0_4px_rgba(24, 88, 200,0.18),0_0_16px_#1858c8]" style={`left: ${r.left}; top: ${r.top};`}></span>
          <span class="absolute font-mono text-[10px] text-text-2 translate-x-2 -translate-y-1/2" style={`left: ${r.left}; top: ${r.top};`}>{r.code} · {r.lat}</span>
        </>
      ))}
    </div>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-2.5">
      <div class="border border-hairline rounded-md px-2.5 py-2 flex items-center gap-2.5 font-mono text-xs">
        <span class="px-1.5 py-px rounded-sm text-[10px] text-green-400 bg-green-400/10">GET</span>
        <span class="text-text">/api/me</span>
        <span class="ml-auto text-text-3">11ms</span>
      </div>
      <div class="border border-hairline rounded-md px-2.5 py-2 flex items-center gap-2.5 font-mono text-xs">
        <span class="px-1.5 py-px rounded-sm text-[10px] text-blue-400 bg-blue-400/10">POST</span>
        <span class="text-text">/api/orders</span>
        <span class="ml-auto text-text-3">42ms</span>
      </div>
      <div class="border border-hairline rounded-md px-2.5 py-2 flex items-center gap-2.5 font-mono text-xs">
        <span class="px-1.5 py-px rounded-sm text-[10px] text-stentor bg-stentor/10">PUT</span>
        <span class="text-text">/api/sessions</span>
        <span class="ml-auto text-text-3">24ms</span>
      </div>
    </div>
  </div>
</div>

<style>
  @reference "../../../../styles/global.css";
  .illus {
    @apply bg-surface border border-hairline rounded-xl overflow-hidden shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)];
  }
  .illus__bar {
    @apply flex items-center justify-between px-3.5 py-2.5 border-b border-hairline font-mono text-[11px] text-text-3 bg-surface-2;
  }
</style>
