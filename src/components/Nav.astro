---
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import IconMenu from "../assets/icons/menu.svg";
import IconX from "../assets/icons/x.svg";
import IconArrowRight from "../assets/icons/arrow-right.svg";
import { nav, navCta, site } from "../data/site";
import type { NavId } from "../data/site";

interface Props {
  active?: NavId | null;
}
const { active = null } = Astro.props;
const isFr = Astro.url.pathname.startsWith("/fr");
const isIt = Astro.url.pathname.startsWith("/it");
const isEs = Astro.url.pathname.startsWith("/es");
const isDe = Astro.url.pathname.startsWith("/de");
const navItems = isFr
  ? [
      { href: "/fr/features", label: "Fonctionnalités", id: "features" as const },
      { href: "/fr/docs", label: "Parcours", id: "docs" as const },
      { href: "/fr/for-theatres", label: "Pour les théâtres", id: "customers" as const },
      { href: "/about", label: "About", id: "about" as const },
    ]
  : isIt
    ? [
        { href: "/it/features", label: "Funzioni", id: "features" as const },
        { href: "/it/docs", label: "Documentazione", id: "docs" as const },
        { href: "/it/for-theatres", label: "Per i teatri", id: "customers" as const },
        { href: "/about", label: "About", id: "about" as const },
      ]
    : isEs
      ? [
          { href: "/es/features", label: "Funciones", id: "features" as const },
          { href: "/es/docs", label: "Guía", id: "docs" as const },
          { href: "/es/for-theatres", label: "Para teatros", id: "customers" as const },
          { href: "/about", label: "About", id: "about" as const },
        ]
      : isDe
        ? [
            { href: "/de/features", label: "Funktionen", id: "features" as const },
            { href: "/de/docs", label: "Leitfaden", id: "docs" as const },
            { href: "/de/for-theatres", label: "Für Theater", id: "customers" as const },
            { href: "/about", label: "About", id: "about" as const },
          ]
        : nav;
const cta = isFr
  ? {
      primary: { href: "/fr/account", label: "Compte" },
      secondary: { href: "/fr/download", label: "Télécharger" },
      statusPrefix: "Conçu pour le spectacle vivant",
    }
  : isIt
    ? {
        primary: { href: "/it/account", label: "Area personale" },
        secondary: { href: "/it/download", label: "Scarica" },
        statusPrefix: "Pensato per lo spettacolo dal vivo",
      }
    : isEs
      ? {
          primary: { href: "/es/account", label: "Cuenta" },
          secondary: { href: "/es/download", label: "Descargar" },
          statusPrefix: "Pensado para las artes escénicas en vivo",
        }
      : isDe
        ? {
            primary: { href: "/de/account", label: "Konto" },
            secondary: { href: "/de/download", label: "Herunterladen" },
            statusPrefix: "Für Live-Aufführungen entwickelt",
          }
        : { ...navCta, statusPrefix: site.statusPrefix };
---
<div
  class="contents"
  x-data="{ open: false }"
  x-init="$watch('open', v => { document.documentElement.style.overflow = v ? 'hidden' : ''; document.body.style.overflow = v ? 'hidden' : ''; })"
  x-on:keydown.escape.window="open = false"
  x-on:resize.window.debounce.150ms="if (window.innerWidth >= 768) open = false"
>
<header
  x-bind:class="open ? 'bg-bg' : 'bg-bg/70'"
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md backdrop-saturate-150 border-b border-hairline transition-colors"
>
  <div class="relative max-w-[1280px] mx-auto px-4 md:px-8 flex items-center justify-between h-16">
    <div class="flex items-center gap-2 min-w-0">
      <Logo />
    </div>

    <nav aria-label="Navigazione principale" class="hidden md:flex gap-1 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      {navItems.map((l) => (
        <a
          href={l.href}
          class:list={[
            "px-3 py-2 text-sm rounded-md transition-colors hover:bg-white/5 whitespace-nowrap",
            active === l.id ? "text-text" : "text-text-2 hover:text-text",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1 ml-auto">
      <div class="hidden md:block">
        <LanguageSwitcher />
      </div>

      <a
        href={cta.secondary.href}
        class="hidden md:inline-flex items-center justify-center h-10 px-4 rounded-lg text-sm font-medium text-text-2 hover:text-text transition-colors"
      >
        {cta.secondary.label}
      </a>
      <a
        href={cta.primary.href}
        class="hidden md:inline-flex items-center justify-center gap-2 h-10 px-4 rounded-lg text-sm font-medium bg-red-500 text-bg hover:bg-red-400 transition-colors shadow-[inset_0_1px_0_rgba(255,255,255,0.18),0_6px_24px_-8px_rgba(239,68,68,0.5)] whitespace-nowrap"
      >
        {cta.primary.label} <span aria-hidden="true">→</span>
      </a>

      <button
        type="button"
        x-on:click="open = !open"
        x-bind:aria-expanded="open.toString()"
        aria-controls="mobile-nav"
        aria-label="Apri o chiudi il menu"
        class="md:hidden ml-1 inline-flex items-center justify-center w-10 h-10 rounded-md text-text-2 hover:text-text hover:bg-white/5 transition-colors"
      >
        <IconMenu class="w-5 h-5 stroke-2" x-show="!open" />
        <IconX class="w-5 h-5 stroke-2" x-show="open" x-cloak />
      </button>
    </div>
  </div>
</header>

<div class="h-16" aria-hidden="true"></div>

<div
  id="mobile-nav"
  x-show="open"
  x-cloak
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0 -translate-y-2 scale-[0.97]"
  x-transition:enter-end="opacity-100 translate-y-0 scale-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100 translate-y-0 scale-100"
  x-transition:leave-end="opacity-0 -translate-y-2 scale-[0.97]"
  class="md:hidden fixed left-3 right-3 top-[70px] z-50 origin-top rounded-2xl border border-hairline-strong bg-surface/95 backdrop-blur-xl shadow-[0_8px_40px_rgba(0,0,0,0.7),0_0_0_1px_rgba(255,255,255,0.04)]"
  role="dialog"
  aria-label="Menu di navigazione"
>
    <nav class="px-3 pt-3 pb-3 flex flex-col gap-1" aria-label="Mobile">
      {navItems.map((l) => (
        <a
          href={l.href}
          x-on:click="open = false"
          class:list={[
            "flex items-center justify-between px-3 py-3.5 rounded-xl text-[15px] font-medium transition-colors border",
            active === l.id
              ? "bg-red-500/10 border-red-500/25 text-text"
              : "border-transparent text-text-2 hover:text-text hover:bg-white/[0.04]",
          ]}
        >
          <span>{l.label}</span>
          <div class="flex items-center gap-2">
            <span
              class:list={[
                "text-sm transition-colors",
                active === l.id ? "text-red-400" : "text-text-4",
              ]}
              aria-hidden="true"
            >
              <IconArrowRight class="w-4 h-4"/>
              </span>
          </div>
        </a>
      ))}
    </nav>

    <div class="px-3 pb-3 border-t border-hairline pt-3">
      <LanguageSwitcher />
    </div>

    <div class="px-3 pb-3 grid grid-cols-2 gap-2 border-t border-hairline pt-3">
      <a
        href={cta.secondary.href}
        x-on:click="open = false"
        class="h-12 inline-flex items-center justify-center border border-hairline-strong rounded-xl text-[14px] font-medium text-text-2 hover:text-text transition-colors"
      >
        {cta.secondary.label}
      </a>
      <a
        href={cta.primary.href}
        x-on:click="open = false"
        class="h-12 inline-flex items-center justify-center gap-1.5 bg-red-500 hover:bg-red-400 text-bg rounded-xl text-[14px] font-semibold shadow-[0_4px_20px_-4px_rgba(239,68,68,0.55)] transition-colors"
      >
        {cta.primary.label} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="px-4 py-2.5 flex items-center justify-between border-t border-hairline bg-black/20 rounded-b-2xl">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]" aria-hidden="true"></span>
        <span class="text-[12px] text-text-3 font-mono">{cta.statusPrefix}</span>
      </div>
      <span class="text-[11px] text-text-4 font-mono">v0.1.64</span>
    </div>
</div>

<div
  x-show="open"
  x-cloak
  x-on:click="open = false"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  aria-hidden="true"
  class="md:hidden fixed inset-0 top-16 z-40 bg-bg/85 backdrop-blur-sm"
></div>
</div>