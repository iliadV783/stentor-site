---
import {
  getLocalizedPath,
  getLocaleFromPath,
  localeLabels,
  locales,
} from "../i18n/config";

const currentPath = Astro.url.pathname;
const currentLang = getLocaleFromPath(currentPath);
const languages = locales.map((code) => ({
  code,
  label: localeLabels[code],
  href: getLocalizedPath(currentPath, code),
}));

const currentLabel = localeLabels[currentLang];
const currentText = {
  en: "current",
  it: "attuale",
  fr: "actuelle",
  es: "actual",
  de: "aktuell",
}[currentLang];
const selectLanguageLabel = {
  en: "Select language",
  it: "Seleziona lingua",
  fr: "Choisir la langue",
  es: "Seleccionar idioma",
  de: "Sprache auswählen",
}[currentLang];
const languageOptionsLabel = {
  en: "Language options",
  it: "Opzioni lingua",
  fr: "Options de langue",
  es: "Opciones de idioma",
  de: "Sprachoptionen",
}[currentLang];
---

<div
  class="relative"
  x-data="{ open: false }"
  x-on:keydown.escape.window="open = false"
>
  <button
    type="button"
    x-on:click="open = !open"
    x-bind:aria-expanded="open.toString()"
    aria-haspopup="menu"
    aria-label={`${selectLanguageLabel}: ${currentLabel}`}
    class="inline-flex items-center gap-2 h-10 px-2.5 rounded-lg text-sm text-text-3 hover:text-text hover:bg-white/[0.04] transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18"></path>
      <path d="M12 3a15 15 0 0 1 0 18"></path>
      <path d="M12 3a15 15 0 0 0 0 18"></path>
    </svg>
    <span class="font-mono text-xs uppercase">{currentLang}</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-text-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>

  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-1 scale-[0.98]"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 -translate-y-1 scale-[0.98]"
    x-on:click.outside="open = false"
    class="absolute right-0 mt-2 w-56 rounded-xl border border-hairline-strong bg-surface/98 backdrop-blur-xl shadow-[0_18px_50px_-22px_rgba(0,0,0,0.85)] overflow-hidden z-[60]"
    role="menu"
    aria-label={languageOptionsLabel}
  >
    {languages.map((lang) => (
      <a
        href={lang.href}
        hreflang={lang.code}
        lang={lang.code}
        aria-current={currentLang === lang.code ? "page" : undefined}
        x-on:click={`localStorage.setItem('stentor-lang-choice', '${lang.code}'); open = false`}
        class="flex items-center gap-3 px-4 py-3 text-sm text-text hover:bg-white/[0.04] transition-colors"
        role="menuitem"
      >
        <span class:list={["font-mono text-[11px] uppercase w-6", currentLang === lang.code ? "text-red-500" : "text-text-3"]}>{lang.code}</span>
        <span class="flex-1">{lang.label}</span>
        <span class="font-mono text-[10px] uppercase text-text-4">{currentLang === lang.code ? currentText : ""}</span>
      </a>
    ))}
  </div>
</div>
