---
---

<div class="stentor-site-options-shell" data-site-options>
  <button class="stentor-site-options" type="button" aria-label="Preferenze sito" title="Preferenze sito" aria-expanded="false" aria-controls="stentor-site-options-panel" data-site-options-toggle>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="7.2" r="3.2" />
      <path d="M5.2 19c1.1-4 3.6-6.1 6.8-6.1s5.7 2.1 6.8 6.1" />
    </svg>
  </button>

  <aside class="stentor-site-options-panel" id="stentor-site-options-panel" aria-label="Preferenze sito" hidden data-site-options-panel>
    <div class="stentor-site-options-panel__head">
      <div>
        <p>Sténtor</p>
        <h2>Preferenze sito</h2>
      </div>
      <button type="button" aria-label="Chiudi preferenze sito" data-site-options-close>×</button>
    </div>

    <p class="stentor-site-options-panel__intro" data-site-options-status>
      Sténtor non vende dati e non usa preferenze marketing. Puoi gestire solo strumenti essenziali e misurazione anonima/aggregata.
    </p>

    <div class="stentor-site-options-panel__custom" hidden data-site-options-custom-panel>
      <article class="stentor-site-options-panel__row">
        <div>
          <h3>Necessari</h3>
          <p>Servono al funzionamento del sito e restano sempre attivi.</p>
        </div>
        <button type="button" class="stentor-site-options-panel__switch" aria-pressed="true" disabled data-site-options-switch="necessary"><span></span></button>
      </article>
      <article class="stentor-site-options-panel__row">
        <div>
          <h3>Funzionalità</h3>
          <p>Salvano preferenze utili, come scelte di interfaccia e navigazione.</p>
        </div>
        <button type="button" class="stentor-site-options-panel__switch" aria-pressed="false" data-site-options-switch="functional"><span></span></button>
      </article>
      <article class="stentor-site-options-panel__row">
        <div>
          <h3>Misurazione</h3>
          <p>Aiuta a capire quali pagine funzionano meglio, solo in forma aggregata.</p>
        </div>
        <button type="button" class="stentor-site-options-panel__switch" aria-pressed="false" data-site-options-switch="analytics"><span></span></button>
      </article>
      <p class="stentor-site-options-panel__note">Nessuna categoria marketing: Sténtor non vende dati e non usa profilazione pubblicitaria.</p>
    </div>

    <div class="stentor-site-options-panel__actions">
      <button type="button" data-site-options-reject>Rifiuta tutto</button>
      <button type="button" data-site-options-customize>Personalizza</button>
      <button type="button" class="is-primary" data-site-options-accept>Accetta tutto</button>
      <button type="button" class="is-primary" hidden data-site-options-save>Salva preferenze</button>
    </div>

    <a class="stentor-site-options-panel__link" href="/privacy" data-site-options-policy>Visualizza Privacy Policy</a>
  </aside>
</div>

<script is:inline>
  (() => {
    const storageKey = 'stentor-site-options-v2';
    const root = document.documentElement;
    const routes = {
      it: '/it/privacy',
      en: '/privacy',
      fr: '/fr/privacy',
      es: '/es/privacy',
      de: '/de/privacy'
    };
    let draft = { functional: false, analytics: false };

    function getLang() {
      return (root.lang || 'en').split('-')[0];
    }

    function getSaved() {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || '{}');
      } catch {
        return {};
      }
    }

    function saveOptions(choice, options = {}) {
      const payload = {
        choice,
        functional: Boolean(options.functional),
        analytics: Boolean(options.analytics),
        marketing: false,
        updatedAt: new Date().toISOString()
      };
      localStorage.setItem(storageKey, JSON.stringify(payload));
      window.dispatchEvent(new CustomEvent('stentor:site-options', { detail: payload }));
      return payload;
    }

    function init() {
      const toggle = document.querySelector('[data-site-options-toggle]');
      const panel = document.querySelector('[data-site-options-panel]');
      const close = document.querySelector('[data-site-options-close]');
      const reject = document.querySelector('[data-site-options-reject]');
      const customize = document.querySelector('[data-site-options-customize]');
      const accept = document.querySelector('[data-site-options-accept]');
      const save = document.querySelector('[data-site-options-save]');
      const customPanel = document.querySelector('[data-site-options-custom-panel]');
      const status = document.querySelector('[data-site-options-status]');
      const policy = document.querySelector('[data-site-options-policy]');
      if (!toggle || !panel) return;

      if (policy) policy.setAttribute('href', routes[getLang()] || routes.en);

      function syncSwitches() {
        document.querySelectorAll('[data-site-options-switch]').forEach((button) => {
          const key = button.getAttribute('data-site-options-switch');
          const active = key === 'necessary' ? true : Boolean(draft[key]);
          button.setAttribute('aria-pressed', String(active));
          button.dataset.active = active ? 'true' : 'false';
        });
      }

      function updateStatus() {
        const saved = getSaved();
        if (!status || !saved.choice) return;
        if (saved.choice === 'accepted') status.textContent = 'Preferenze salvate: funzionalità e misurazione attive. Nessuna profilazione marketing.';
        else if (saved.choice === 'rejected') status.textContent = 'Preferenze salvate: solo impostazioni essenziali. Nessuna profilazione marketing.';
        else status.textContent = 'Preferenze personalizzate salvate. Nessuna categoria marketing è prevista.';
      }

      function setCustomizeMode(active) {
        if (customPanel) customPanel.hidden = !active;
        if (save) save.hidden = !active;
        if (customize) customize.hidden = active;
        syncSwitches();
      }

      function setOpen(open) {
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        if (open) {
          const saved = getSaved();
          draft.functional = Boolean(saved.functional);
          draft.analytics = Boolean(saved.analytics);
          setCustomizeMode(false);
          updateStatus();
          panel.querySelector('button, a')?.focus();
        }
      }

      function commit(choice, options) {
        saveOptions(choice, options);
        updateStatus();
        setOpen(false);
      }

      updateStatus();
      syncSwitches();
      toggle.addEventListener('click', () => setOpen(panel.hidden));
      close?.addEventListener('click', () => setOpen(false));
      reject?.addEventListener('click', () => commit('rejected', { functional: false, analytics: false }));
      accept?.addEventListener('click', () => commit('accepted', { functional: true, analytics: true }));
      customize?.addEventListener('click', () => setCustomizeMode(true));
      save?.addEventListener('click', () => commit('customized', draft));
      document.querySelectorAll('[data-site-options-switch]').forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.getAttribute('data-site-options-switch');
          if (!key || key === 'necessary') return;
          draft[key] = !draft[key];
          syncSwitches();
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });
    }

    document.addEventListener('astro:page-load', init, { once: true });
    if (document.readyState !== 'loading') init();
  })();
</script>

<style is:global>
  .stentor-site-options-shell {
    position: fixed;
    left: max(18px, env(safe-area-inset-left));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 82;
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
  }

  .stentor-site-options {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    background: rgba(18, 18, 18, 0.9);
    color: #24c7a0;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(18px);
  }

  .stentor-site-options svg {
    width: 27px;
    height: 27px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stentor-site-options-panel {
    position: absolute;
    left: 0;
    bottom: 60px;
    width: min(410px, calc(100vw - 28px));
    max-height: min(720px, calc(100vh - 96px));
    overflow: auto;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background: rgba(12, 12, 12, 0.96);
    color: #fafafa;
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(22px);
  }

  .stentor-site-options-panel__head {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stentor-site-options-panel__head p {
    margin: 0 0 6px;
    color: #24c7a0;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .stentor-site-options-panel__head h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .stentor-site-options-panel__head button {
    flex: none;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 24px;
    line-height: 1;
  }

  .stentor-site-options-panel__intro,
  .stentor-site-options-panel__note,
  .stentor-site-options-panel__row p {
    color: #cfcfd6;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .stentor-site-options-panel__intro {
    margin: 14px 0 0;
  }

  .stentor-site-options-panel__custom {
    display: grid;
    gap: 12px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stentor-site-options-panel__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
  }

  .stentor-site-options-panel__row h3 {
    margin: 0;
    font-size: 14.5px;
    font-weight: 800;
  }

  .stentor-site-options-panel__row p,
  .stentor-site-options-panel__note {
    margin: 5px 0 0;
  }

  .stentor-site-options-panel__switch {
    position: relative;
    width: 54px;
    height: 30px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
  }

  .stentor-site-options-panel__switch span {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: #fff;
    transition: transform 160ms ease;
  }

  .stentor-site-options-panel__switch[data-active="true"] {
    background: #24c7a0;
  }

  .stentor-site-options-panel__switch[data-active="true"] span {
    transform: translateX(24px);
  }

  .stentor-site-options-panel__switch:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .stentor-site-options-panel__actions {
    display: grid;
    gap: 9px;
    margin-top: 16px;
  }

  .stentor-site-options-panel__actions button,
  .stentor-site-options-panel__link {
    min-height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.055);
    color: #f7f7f8;
    font-size: 13.5px;
    font-weight: 700;
  }

  .stentor-site-options-panel__actions button {
    padding: 0 12px;
    text-align: left;
  }

  .stentor-site-options-panel__actions .is-primary {
    border-color: rgba(36, 199, 160, 0.65);
    background: rgba(36, 199, 160, 0.18);
  }

  .stentor-site-options-panel__link {
    display: flex;
    align-items: center;
    margin-top: 10px;
    padding: 0 12px;
    text-decoration: none;
  }

  .stentor-site-options:focus-visible,
  .stentor-site-options-panel button:focus-visible,
  .stentor-site-options-panel a:focus-visible {
    outline: 3px solid rgba(37, 99, 235, 0.8);
    outline-offset: 4px;
  }
</style>
