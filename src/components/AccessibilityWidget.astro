---
---

<div class="stentor-a11y" data-stentor-a11y>
  <button class="stentor-a11y__fab" type="button" aria-label="Accessibilità" title="Accessibilità" aria-expanded="false" aria-controls="stentor-a11y-panel" data-a11y-toggle>
    <span class="stentor-a11y__fab-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" focusable="false">
        <circle cx="16" cy="5.8" r="2.4" />
        <path d="M7.7 11.2c3.1 1.2 5.9 1.8 8.3 1.8s5.2-.6 8.3-1.8" />
        <path d="M16 13v5.2" />
        <path d="M16 18.2 10.8 27" />
        <path d="M16 18.2 21.2 27" />
      </svg>
    </span>
  </button>

  <aside class="stentor-a11y__panel" id="stentor-a11y-panel" aria-label="Pannello accessibilità" hidden data-a11y-panel>
    <div class="stentor-a11y__head">
      <div>
        <p class="stentor-a11y__eyebrow" data-a11y-i18n="eyebrow">Sito</p>
        <h2 data-a11y-i18n="title">Accessibilità</h2>
        <p data-a11y-i18n="intro">Preferenze di lettura e navigazione per questo sito.</p>
      </div>
      <button class="stentor-a11y__close" type="button" aria-label="Chiudi pannello accessibilità" data-a11y-close>×</button>
    </div>

    <div class="stentor-a11y__grid" role="group" aria-label="Preferenze di visualizzazione">
      <button type="button" data-a11y-action="text" data-a11y-i18n="textSize">Testo grande</button>
      <button type="button" data-a11y-action="contrast" data-a11y-i18n="contrast">Contrasto alto</button>
      <button type="button" data-a11y-action="theme" data-a11y-i18n="theme">Tema chiaro</button>
      <button type="button" data-a11y-action="font" data-a11y-i18n="font">Font leggibile</button>
      <button type="button" data-a11y-action="motion" data-a11y-i18n="motion">Riduci movimento</button>
      <button type="button" data-a11y-action="links" data-a11y-i18n="links">Evidenzia link</button>
      <button type="button" data-a11y-action="images" data-a11y-i18n="images">Nascondi immagini</button>
      <button type="button" data-a11y-action="read" data-a11y-i18n="read">Leggi pagina</button>
    </div>

    <div class="stentor-a11y__foot">
      <button type="button" data-a11y-reset data-a11y-i18n="reset">Ripristina</button>
      <p data-a11y-i18n="note">Il pannello aiuta la lettura, ma non sostituisce un sito progettato accessibile alla base.</p>
    </div>
  </aside>
</div>

<div class="stentor-privacy" data-stentor-privacy>
  <button class="stentor-privacy__fab" type="button" aria-label="Privacy e preferenze" title="Privacy e preferenze" aria-expanded="false" aria-controls="stentor-privacy-panel" data-privacy-toggle>
    <span class="stentor-privacy__fab-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" focusable="false">
        <circle cx="16" cy="10.2" r="5.1" />
        <path d="M6.8 27.2c1.1-6.1 4.7-9.1 9.2-9.1s8.1 3 9.2 9.1" />
      </svg>
    </span>
  </button>

  <aside class="stentor-privacy__panel" id="stentor-privacy-panel" aria-label="Pannello privacy e preferenze" hidden data-privacy-panel>
    <div class="stentor-a11y__head">
      <div>
        <p class="stentor-a11y__eyebrow" data-privacy-i18n="eyebrow">Privacy</p>
        <h2 data-privacy-i18n="title">Privacy e preferenze</h2>
        <p data-privacy-i18n="intro">Gestisci le preferenze essenziali del sito e apri l’informativa privacy.</p>
      </div>
      <button class="stentor-a11y__close" type="button" aria-label="Chiudi pannello privacy" data-privacy-close>×</button>
    </div>

    <div class="stentor-privacy__body">
      <p data-privacy-i18n="essential">Usiamo solo preferenze tecniche salvate nel browser per ricordare le scelte di accessibilità e privacy.</p>
      <a href="/privacy" data-privacy-route="privacy" data-privacy-i18n="privacyLink">Leggi l’informativa privacy</a>
      <button type="button" data-privacy-save data-privacy-i18n="save">Salva preferenze essenziali</button>
      <p class="stentor-privacy__status" data-privacy-status role="status" aria-live="polite"></p>
    </div>
  </aside>
</div>

<script is:inline>
  (() => {
    const storageKey = "stentor-a11y-preferences";
    const privacyKey = "site-privacy-preferences";
    const root = document.documentElement;
    const copy = {
      it: {
        eyebrow: "Sito",
        openLabel: "Accessibilità",
        title: "Accessibilità",
        intro: "Preferenze di lettura e navigazione per questo sito.",
        textSize: "Testo grande",
        contrast: "Contrasto alto",
        theme: "Tema chiaro",
        font: "Font leggibile",
        motion: "Riduci movimento",
        links: "Evidenzia link",
        images: "Nascondi immagini",
        read: "Leggi pagina",
        reset: "Ripristina",
        note: "Il pannello aiuta la lettura, ma non sostituisce un sito progettato accessibile alla base."
      },
      en: {
        eyebrow: "Site",
        openLabel: "Accessibility",
        title: "Accessibility",
        intro: "Reading and navigation preferences for this website.",
        textSize: "Large text",
        contrast: "High contrast",
        theme: "Light theme",
        font: "Readable font",
        motion: "Reduce motion",
        links: "Highlight links",
        images: "Hide images",
        read: "Read page",
        reset: "Reset",
        note: "This panel helps reading, but it does not replace an accessible-by-design website."
      },
      fr: {
        eyebrow: "Site",
        openLabel: "Accessibilité",
        title: "Accessibilité",
        intro: "Préférences de lecture et de navigation pour ce site.",
        textSize: "Grand texte",
        contrast: "Contraste élevé",
        theme: "Thème clair",
        font: "Police lisible",
        motion: "Réduire le mouvement",
        links: "Mettre les liens en évidence",
        images: "Masquer les images",
        read: "Lire la page",
        reset: "Réinitialiser",
        note: "Ce panneau facilite la lecture, mais ne remplace pas un site conçu accessible dès le départ."
      },
      es: {
        eyebrow: "Sitio",
        openLabel: "Accesibilidad",
        title: "Accesibilidad",
        intro: "Preferencias de lectura y navegación para este sitio.",
        textSize: "Texto grande",
        contrast: "Alto contraste",
        theme: "Tema claro",
        font: "Fuente legible",
        motion: "Reducir movimiento",
        links: "Resaltar enlaces",
        images: "Ocultar imágenes",
        read: "Leer página",
        reset: "Restablecer",
        note: "Este panel ayuda a la lectura, pero no sustituye un sitio diseñado con accesibilidad desde la base."
      },
      de: {
        eyebrow: "Website",
        openLabel: "Barrierefreiheit",
        title: "Barrierefreiheit",
        intro: "Lese- und Navigationseinstellungen für diese Website.",
        textSize: "Großer Text",
        contrast: "Hoher Kontrast",
        theme: "Helles Design",
        font: "Lesbare Schrift",
        motion: "Bewegung reduzieren",
        links: "Links hervorheben",
        images: "Bilder ausblenden",
        read: "Seite vorlesen",
        reset: "Zurücksetzen",
        note: "Dieses Panel unterstützt die Lesbarkeit, ersetzt aber keine barrierefrei gestaltete Website."
      }
    };
    const privacyCopy = {
      it: { openLabel: "Privacy e preferenze", title: "Privacy e preferenze", intro: "Gestisci le preferenze essenziali del sito e apri l’informativa privacy.", essential: "Usiamo solo preferenze tecniche salvate nel browser per ricordare le scelte di accessibilità e privacy.", privacyLink: "Leggi l’informativa privacy", save: "Salva preferenze essenziali", saved: "Preferenze salvate.", close: "Chiudi pannello privacy" },
      en: { openLabel: "Privacy and preferences", title: "Privacy and preferences", intro: "Manage essential site preferences and open the privacy notice.", essential: "We only store technical browser preferences to remember accessibility and privacy choices.", privacyLink: "Read the privacy notice", save: "Save essential preferences", saved: "Preferences saved.", close: "Close privacy panel" },
      fr: { openLabel: "Confidentialité et préférences", title: "Confidentialité et préférences", intro: "Gérez les préférences essentielles du site et ouvrez la politique de confidentialité.", essential: "Nous conservons uniquement des préférences techniques dans le navigateur pour mémoriser les choix d’accessibilité et de confidentialité.", privacyLink: "Lire la politique de confidentialité", save: "Enregistrer les préférences essentielles", saved: "Préférences enregistrées.", close: "Fermer le panneau de confidentialité" },
      es: { openLabel: "Privacidad y preferencias", title: "Privacidad y preferencias", intro: "Gestiona las preferencias esenciales del sitio y abre la política de privacidad.", essential: "Solo guardamos preferencias técnicas en el navegador para recordar elecciones de accesibilidad y privacidad.", privacyLink: "Leer la política de privacidad", save: "Guardar preferencias esenciales", saved: "Preferencias guardadas.", close: "Cerrar panel de privacidad" },
      de: { openLabel: "Datenschutz und Einstellungen", title: "Datenschutz und Einstellungen", intro: "Verwalten Sie wesentliche Website-Einstellungen und öffnen Sie die Datenschutzhinweise.", essential: "Wir speichern nur technische Browser-Einstellungen, um Barrierefreiheits- und Datenschutzoptionen zu merken.", privacyLink: "Datenschutzhinweise lesen", save: "Wesentliche Einstellungen speichern", saved: "Einstellungen gespeichert.", close: "Datenschutz-Panel schließen" }
    };
    const localizedPrivacyRoutes = {
      it: "/it/privacy",
      en: "/privacy",
      fr: "/fr/privacy",
      es: "/es/privacy",
      de: "/de/privacy"
    };
    const defaults = { text: 0, contrast: false, theme: false, font: false, motion: false, links: false, images: false };
    let state = { ...defaults };

    function getLang() {
      const lang = (root.lang || "en").split("-")[0];
      return copy[lang] ? lang : "en";
    }

    function load() {
      try {
        state = { ...defaults, ...JSON.parse(localStorage.getItem(storageKey) || "{}") };
      } catch {
        state = { ...defaults };
      }
    }

    function save() {
      localStorage.setItem(storageKey, JSON.stringify(state));
    }

    function apply() {
      root.classList.toggle("stentor-a11y-text-large", state.text === 1);
      root.classList.toggle("stentor-a11y-text-xlarge", state.text === 2);
      root.classList.toggle("stentor-a11y-contrast", state.contrast);
      root.classList.toggle("stentor-a11y-light", state.theme);
      root.classList.toggle("stentor-a11y-readable", state.font);
      root.classList.toggle("stentor-a11y-reduce-motion", state.motion);
      root.classList.toggle("stentor-a11y-highlight-links", state.links);
      root.classList.toggle("stentor-a11y-hide-images", state.images);
      document.querySelectorAll("[data-a11y-action]").forEach((button) => {
        const action = button.getAttribute("data-a11y-action");
        const active = action === "text" ? state.text > 0 : Boolean(state[action]);
        button.setAttribute("aria-pressed", String(active));
        button.dataset.active = active ? "true" : "false";
      });
    }

    function translate() {
      const lang = getLang();
      const labels = copy[lang];
      const privacyLabels = privacyCopy[lang];
      document.querySelectorAll("[data-a11y-i18n]").forEach((el) => {
        const key = el.getAttribute("data-a11y-i18n");
        if (labels[key]) el.textContent = labels[key];
      });
      document.querySelectorAll("[data-privacy-i18n]").forEach((el) => {
        const key = el.getAttribute("data-privacy-i18n");
        if (privacyLabels[key]) el.textContent = privacyLabels[key];
      });
      document.querySelectorAll("[data-privacy-route='privacy']").forEach((el) => {
        el.setAttribute("href", localizedPrivacyRoutes[lang] || localizedPrivacyRoutes.en);
      });
      const panel = document.querySelector("[data-a11y-panel]");
      if (panel) panel.setAttribute("aria-label", labels.title);
      const toggle = document.querySelector("[data-a11y-toggle]");
      if (toggle) {
        toggle.setAttribute("aria-label", labels.openLabel);
        toggle.setAttribute("title", labels.openLabel);
      }
      const close = document.querySelector("[data-a11y-close]");
      if (close) close.setAttribute("aria-label", lang === "it" ? "Chiudi pannello accessibilità" : "Close accessibility panel");
      const privacyToggle = document.querySelector("[data-privacy-toggle]");
      if (privacyToggle) {
        privacyToggle.setAttribute("aria-label", privacyLabels.openLabel);
        privacyToggle.setAttribute("title", privacyLabels.openLabel);
      }
      const privacyPanel = document.querySelector("[data-privacy-panel]");
      if (privacyPanel) privacyPanel.setAttribute("aria-label", privacyLabels.title);
      const privacyClose = document.querySelector("[data-privacy-close]");
      if (privacyClose) privacyClose.setAttribute("aria-label", privacyLabels.close);
    }

    function readPage() {
      if (!("speechSynthesis" in window)) return;
      if (speechSynthesis.speaking) {
        speechSynthesis.cancel();
        return;
      }
      const main = document.querySelector("main");
      const text = (main?.innerText || document.body.innerText || "").replace(/\s+/g, " ").trim().slice(0, 12000);
      if (!text) return;
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = root.lang || getLang();
      speechSynthesis.speak(utterance);
    }

    function init() {
      load();
      translate();
      apply();
      const toggle = document.querySelector("[data-a11y-toggle]");
      const panel = document.querySelector("[data-a11y-panel]");
      const close = document.querySelector("[data-a11y-close]");
      const reset = document.querySelector("[data-a11y-reset]");
      const privacyToggle = document.querySelector("[data-privacy-toggle]");
      const privacyPanel = document.querySelector("[data-privacy-panel]");
      const privacyClose = document.querySelector("[data-privacy-close]");
      const privacySave = document.querySelector("[data-privacy-save]");
      const privacyStatus = document.querySelector("[data-privacy-status]");

      function setOpen(targetPanel, targetToggle, open) {
        if (!targetPanel || !targetToggle) return;
        targetPanel.hidden = !open;
        targetToggle.setAttribute("aria-expanded", String(open));
        if (open) targetPanel.querySelector("button, a")?.focus();
      }

      toggle?.addEventListener("click", () => {
        setOpen(privacyPanel, privacyToggle, false);
        setOpen(panel, toggle, panel.hidden);
      });
      close?.addEventListener("click", () => setOpen(panel, toggle, false));
      privacyToggle?.addEventListener("click", () => {
        setOpen(panel, toggle, false);
        setOpen(privacyPanel, privacyToggle, privacyPanel.hidden);
      });
      privacyClose?.addEventListener("click", () => setOpen(privacyPanel, privacyToggle, false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setOpen(panel, toggle, false);
          setOpen(privacyPanel, privacyToggle, false);
        }
      });
      document.querySelectorAll("[data-a11y-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const action = button.getAttribute("data-a11y-action");
          if (action === "read") {
            readPage();
            return;
          }
          if (action === "text") state.text = (state.text + 1) % 3;
          else state[action] = !state[action];
          save();
          apply();
        });
      });
      reset?.addEventListener("click", () => {
        state = { ...defaults };
        save();
        apply();
      });
      privacySave?.addEventListener("click", () => {
        const lang = getLang();
        localStorage.setItem(privacyKey, JSON.stringify({ essential: true, savedAt: new Date().toISOString() }));
        if (privacyStatus) privacyStatus.textContent = privacyCopy[lang].saved;
      });
    }

    document.addEventListener("astro:page-load", init, { once: true });
    if (document.readyState !== "loading") init();
  })();
</script>

<style is:global>
  .stentor-a11y,
  .stentor-privacy {
    position: fixed;
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 80;
    font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
  }

  .stentor-a11y {
    right: max(18px, env(safe-area-inset-right));
  }

  .stentor-privacy {
    left: max(18px, env(safe-area-inset-left));
  }

  .stentor-a11y__fab,
  .stentor-privacy__fab {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 999px;
    color: #fff;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.34), 0 0 32px rgba(239, 68, 68, 0.22);
  }

  .stentor-a11y__fab {
    background: #ef4444;
  }

  .stentor-privacy__fab {
    background: #111827;
  }

  .stentor-a11y__fab-icon,
  .stentor-privacy__fab-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: transparent;
    color: #fff;
  }

  .stentor-a11y__fab-icon svg,
  .stentor-privacy__fab-icon svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }

  .stentor-a11y__fab-icon svg path,
  .stentor-privacy__fab-icon svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stentor-privacy__fab-icon svg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.1;
  }

  .stentor-a11y__panel,
  .stentor-privacy__panel {
    position: absolute;
    bottom: 64px;
    width: min(380px, calc(100vw - 28px));
    max-height: min(690px, calc(100vh - 96px));
    overflow: auto;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background: rgba(12, 12, 12, 0.96);
    color: #fafafa;
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(22px);
  }

  .stentor-a11y__panel {
    right: 0;
  }

  .stentor-privacy__panel {
    left: 0;
  }

  .stentor-a11y__head {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stentor-a11y__eyebrow {
    margin: 0 0 6px;
    color: #ef4444;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .stentor-a11y__head h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .stentor-a11y__head p:not(.stentor-a11y__eyebrow),
  .stentor-a11y__foot p,
  .stentor-privacy__body p {
    margin: 8px 0 0;
    color: #b8b8c2;
    font-size: 13px;
    line-height: 1.45;
  }

  .stentor-a11y__close {
    flex: none;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 24px;
    line-height: 1;
  }

  .stentor-a11y__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .stentor-a11y__grid button,
  .stentor-a11y__foot button,
  .stentor-privacy__body button,
  .stentor-privacy__body a {
    min-height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.055);
    color: #f7f7f8;
    font-size: 13.5px;
    font-weight: 650;
    text-align: left;
    line-height: 1.25;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .stentor-a11y__grid button,
  .stentor-a11y__foot button,
  .stentor-privacy__body button,
  .stentor-privacy__body a {
    padding: 12px;
  }

  .stentor-a11y__grid button:hover,
  .stentor-a11y__foot button:hover,
  .stentor-privacy__body button:hover,
  .stentor-privacy__body a:hover {
    border-color: rgba(239, 68, 68, 0.45);
    background: rgba(239, 68, 68, 0.12);
  }

  .stentor-a11y__grid button[data-active="true"] {
    border-color: rgba(239, 68, 68, 0.8);
    background: rgba(239, 68, 68, 0.22);
    color: #fff;
  }

  .stentor-a11y__foot,
  .stentor-privacy__body {
    margin-top: 16px;
  }

  .stentor-a11y__foot button,
  .stentor-privacy__body button,
  .stentor-privacy__body a {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
  }

  .stentor-privacy__body {
    display: grid;
    gap: 10px;
  }

  .stentor-privacy__status:empty {
    display: none;
  }

  .stentor-a11y button:focus-visible,
  .stentor-a11y a:focus-visible,
  .stentor-privacy button:focus-visible,
  .stentor-privacy a:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.78);
    outline-offset: 4px;
  }

  html.stentor-a11y-text-large body { font-size: 17px; }
  html.stentor-a11y-text-xlarge body { font-size: 19px; }
  html.stentor-a11y-readable body { font-family: Arial, Verdana, Tahoma, sans-serif; letter-spacing: 0.01em; }
  html.stentor-a11y-highlight-links a { text-decoration: underline !important; text-decoration-thickness: 2px !important; text-underline-offset: 4px !important; }
  html.stentor-a11y-reduce-motion *,
  html.stentor-a11y-reduce-motion *::before,
  html.stentor-a11y-reduce-motion *::after {
    animation: none !important;
    scroll-behavior: auto !important;
    transition: none !important;
  }
  html.stentor-a11y-hide-images img,
  html.stentor-a11y-hide-images picture,
  html.stentor-a11y-hide-images video,
  html.stentor-a11y-hide-images main svg {
    visibility: hidden !important;
  }
  html.stentor-a11y-contrast {
    --color-bg: #000;
    --color-deep: #000;
    --color-surface: #050505;
    --color-surface-2: #080808;
    --color-elevated: #080808;
    --color-text: #fff;
    --color-text-2: #fff;
    --color-text-3: #f2f2f2;
    --color-text-4: #e8e8e8;
    --color-hairline: rgba(255, 255, 255, 0.34);
    --color-hairline-strong: rgba(255, 255, 255, 0.52);
  }
  html.stentor-a11y-light {
    --color-bg: #f7f6f2;
    --color-deep: #fffdf7;
