---

<div class="floating-site-icons" aria-label="Preferenze sito">
  <button class="floating-site-icons__button floating-site-icons__button--accessibility" type="button" aria-label="Accessibilità" title="Accessibilità" data-floating-a11y>
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="16" cy="5.8" r="2.4" />
      <path d="M7.7 11.2c3.1 1.2 5.9 1.8 8.3 1.8s5.2-.6 8.3-1.8" />
      <path d="M16 13v5.2" />
      <path d="M16 18.2 10.8 27" />
      <path d="M16 18.2 21.2 27" />
    </svg>
  </button>
</div>

<script is:inline>
  (() => {
    function initFloatingIcons() {
      const a11y = document.querySelector("[data-floating-a11y]");

      a11y?.addEventListener("click", () => {
        document.documentElement.classList.toggle("floating-a11y-readable");
        localStorage.setItem(
          "floating-a11y-readable",
          document.documentElement.classList.contains("floating-a11y-readable") ? "1" : "0"
        );
      });

      if (localStorage.getItem("floating-a11y-readable") === "1") {
        document.documentElement.classList.add("floating-a11y-readable");
      }
    }

    document.addEventListener("astro:page-load", initFloatingIcons);
    if (document.readyState !== "loading") initFloatingIcons();
  })();
</script>

<style is:global>
  .floating-site-icons__button {
    position: fixed !important;
    bottom: max(18px, env(safe-area-inset-bottom)) !important;
    z-index: 2147483000 !important;
    display: grid !important;
    place-items: center !important;
    width: 54px !important;
    height: 54px !important;
    padding: 0 !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    border-radius: 999px !important;
    color: #fff !important;
    cursor: pointer !important;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.36), 0 0 32px rgba(239, 68, 68, 0.22) !important;
  }

  .floating-site-icons__button--accessibility {
    right: max(18px, env(safe-area-inset-right)) !important;
    background: #ef4444 !important;
  }

  .floating-site-icons__button svg {
    width: 29px !important;
    height: 29px !important;
  }

  .floating-site-icons__button--accessibility circle {
    fill: currentColor !important;
  }

  .floating-site-icons__button path {
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 3.1 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }

  .floating-site-icons__button:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.82) !important;
    outline-offset: 4px !important;
  }

  html.floating-a11y-readable body {
    font-family: Arial, Verdana, Tahoma, sans-serif !important;
    font-size: 18px !important;
    letter-spacing: 0.01em !important;
  }

  @media (max-width: 520px) {
    .floating-site-icons__button {
      bottom: 14px !important;
      width: 52px !important;
      height: 52px !important;
    }

    .floating-site-icons__button--accessibility {
      right: 14px !important;
    }
  }
</style>
