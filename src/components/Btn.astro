---
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "quiet";
  size?: "md" | "lg";
  class?: string;
  type?: "button" | "submit";
}

const { href, variant = "ghost", size = "md", class: className = "", type } = Astro.props;

const sizing = size === "lg" ? "h-[46px] px-5 text-[15px]" : "h-10 px-4 text-sm";
const variants = {
  primary:
    "bg-stentor text-white hover:bg-stentor-dark shadow-[0_10px_24px_-14px_rgba(24,88,200,0.55)]",
  ghost:
    "bg-white text-text border border-hairline-strong hover:bg-stentor-soft hover:border-stentor/25",
  quiet: "bg-transparent text-text-2 hover:text-text",
};

const cls = [
  "inline-flex items-center justify-center gap-2 rounded-lg font-medium whitespace-nowrap transition-[color,background-color,border-color,box-shadow] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-stentor/25",
  sizing,
  variants[variant],
  className,
].join(" ");

const Tag = href ? "a" : "button";
---
<Tag href={href} type={!href ? type : undefined} class={cls}>
  <slot />
</Tag>
