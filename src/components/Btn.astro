---
interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "quiet";
  size?: "md" | "lg";
  class?: string;
  type?: "button" | "submit";
}

const { href, variant = "ghost", size = "md", class: className = "", type } = Astro.props;

const sizing = size === "lg" ? "h-[46px] px-5 text-[15px]" : "h-10 px-4 text-sm";
const variants = {
  primary:
    "bg-red-500 text-bg hover:bg-red-400 shadow-[inset_0_1px_0_rgba(255,255,255,0.18),0_6px_24px_-8px_rgba(239,68,68,0.5)]",
  ghost:
    "bg-transparent text-text border border-hairline-strong hover:bg-white/[0.04] hover:border-white/20",
  quiet: "bg-transparent text-text-2 hover:text-text",
};

const cls = [
  "inline-flex items-center justify-center gap-2 rounded-lg font-medium whitespace-nowrap transition-colors",
  sizing,
  variants[variant],
  className,
].join(" ");

const Tag = href ? "a" : "button";
---
<Tag href={href} type={!href ? type : undefined} class={cls}>
  <slot />
</Tag>
