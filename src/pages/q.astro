---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Questionario pubblico - Sténtor"
  description="Questionario anonimo post-spettacolo raccolto tramite Sténtor."
  active={null}
  showNav={false}
  showFooter={false}
  noindex={true}
>
  <section class="min-h-screen bg-bg text-text relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(24, 88, 200,0.16)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_72%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_72%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-20%] top-[-20%] w-[680px] h-[680px] rounded-full bg-stentor/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <main class="relative max-w-[780px] mx-auto px-5 py-10 md:py-16">
      <header class="mb-8">
        <a href="/" class="inline-flex items-center gap-3 text-text hover:text-text-2 transition-colors">
          <span class="font-semibold tracking-[-0.04em] text-xl">STÉNTOR</span>
          <span class="text-text-2 text-sm">Questionario pubblico</span>
        </a>
      </header>

      <section class="rounded-3xl border border-hairline-strong bg-surface-2 backdrop-blur-sm p-6 md:p-8">
        <div data-loading>
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-3">Opinioni pubblico</p>
          <h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4">Caricamento questionario.</h1>
          <p class="text-text-2 leading-[1.6]">Sto verificando il link e la finestra temporale di compilazione.</p>
        </div>

        <div data-error hidden>
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-3">Questionario non disponibile</p>
          <h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4">Non posso aprire questo questionario.</h1>
          <p data-error-text class="text-text-2 leading-[1.6]"></p>
        </div>

        <div data-success hidden>
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-3">Grazie</p>
          <h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4">Risposta inviata.</h1>
          <p class="text-text-2 leading-[1.6]">Le risposte sono anonime e verranno mostrate alla compagnia in forma consultabile dentro Sténtor.</p>
        </div>

        <form data-survey-form hidden class="grid gap-6">
          <div>
            <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-3">Questionario post-spettacolo</p>
            <h1 data-survey-title class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4">Questionario Sténtor</h1>
            <p data-survey-meta class="text-text-2 leading-[1.6]"></p>
          </div>

          <div data-questions class="grid gap-4"></div>

          <label class="grid gap-2">
            <span class="text-sm font-medium text-text-2">Servizio usato</span>
            <select name="serviceUsed" class="survey-input">
              <option value="">Preferisco non indicarlo</option>
              <option value="surtitles">Sopratitoli</option>
              <option value="translation">Traduzione</option>
              <option value="audio-description">Audiodescrizione</option>
              <option value="multiple">Più servizi</option>
            </select>
          </label>

          <label class="grid gap-2">
            <span class="text-sm font-medium text-text-2">Lingua</span>
            <input name="language" class="survey-input" placeholder="it, en, fr..." />
          </label>

          <p class="text-text-2 text-sm leading-[1.6]">Non vengono richiesti nome, email o account. Il questionario salva solo le risposte fornite.</p>

          <button data-submit type="submit" class="h-13 rounded-xl bg-stentor text-white font-semibold hover:bg-stentor-dark transition-colors disabled:opacity-50 disabled:cursor-wait">Invia risposta anonima</button>
          <p data-form-error hidden class="rounded-xl border border-stentor/30 bg-stentor/10 text-stentor text-sm leading-[1.5] p-4"></p>
        </form>
      </section>
    </main>
  </section>
</Layout>

<style is:global>
  @reference "../styles/global.css";
  .survey-input { @apply w-full min-h-12 rounded-xl bg-surface-2 border border-hairline-strong px-4 py-3 text-text placeholder:text-text-2 outline-none focus:border-stentor/50; }
  .survey-card { @apply rounded-2xl border border-hairline-strong bg-sunken p-4 md:p-5; }
  .survey-label { @apply block text-sm font-medium text-text-2 mb-3; }
  .rating-choice { @apply h-12 rounded-xl border border-hairline-strong bg-surface-2 flex items-center justify-center cursor-pointer hover:bg-surface-2 transition-colors; }
  .rating-choice:has(input:checked) { @apply border-stentor/60 bg-stentor/20 text-text; }
</style>

<script>
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const endpoint = supabaseUrl ? `${String(supabaseUrl).replace(/\/$/, '')}/functions/v1/stentor-survey` : '';
  const params = new URLSearchParams(window.location.search);
  const token = params.get('token') || params.get('t') || '';

  const loading = document.querySelector('[data-loading]');
  const errorPanel = document.querySelector('[data-error]');
  const errorText = document.querySelector('[data-error-text]');
  const successPanel = document.querySelector('[data-success]');
  const form = document.querySelector('[data-survey-form]');
  const title = document.querySelector('[data-survey-title]');
  const meta = document.querySelector('[data-survey-meta]');
  const questionsTarget = document.querySelector('[data-questions]');
  const submitButton = document.querySelector('[data-submit]');
  const formError = document.querySelector('[data-form-error]');

  let currentSurvey = null;

  function escapeHTML(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char]));
  }

  function hideAll() {
    if (loading) loading.hidden = true;
    if (errorPanel) errorPanel.hidden = true;
    if (successPanel) successPanel.hidden = true;
    if (form) form.hidden = true;
  }

  function showError(message) {
    hideAll();
    if (errorText) errorText.textContent = message;
    if (errorPanel) errorPanel.hidden = false;
  }

  function formatDate(value) {
    if (!value) return '';
    try {
      return new Intl.DateTimeFormat('it-IT', { dateStyle: 'long', timeStyle: 'short' }).format(new Date(value));
    } catch {
      return String(value);
    }
  }

  function normalizedType(value) {
    const type = String(value || 'text').toLowerCase();
    if (['rating', 'rating_1_5', 'scale', 'scale_1_5', 'stars'].includes(type)) return 'rating_1_5';
    if (['choice', 'single_choice', 'select', 'yes_no'].includes(type)) return 'single_choice';
    return 'text';
  }

  function defaultQuestions() {
    return [
      { id: 'overallSatisfaction', title: 'Quanto ti è piaciuta l’esperienza complessiva?', type: 'rating_1_5' },
      { id: 'serviceUsefulness', title: 'Quanto è stato utile il servizio Sténtor?', type: 'rating_1_5' },
      { id: 'easeOfUse', title: 'Quanto è stato facile usare il servizio sullo smartphone?', type: 'rating_1_5' },
      { id: 'freeComment', title: 'Vuoi aggiungere un commento?', type: 'text' },
    ];
  }

  function normalizedQuestions(questions) {
    if (!Array.isArray(questions) || !questions.length) return defaultQuestions();
    return questions.map((question, index) => {
      if (typeof question === 'string') {
        return { id: `q${index + 1}`, title: question, type: 'text', options: [] };
      }

      const type = normalizedType(question.type || question.kind);
      return {
        id: String(question.id || question.key || `q${index + 1}`),
        title: String(question.title || question.prompt || question.text || `Domanda ${index + 1}`),
        type,
        options: Array.isArray(question.options) ? question.options : [],
      };
    });
  }

  function renderQuestion(question) {
    const id = escapeHTML(question.id);
    const label = escapeHTML(question.title);

    if (question.type === 'rating_1_5') {
      return `
        <fieldset class="survey-card" data-question-type="rating_1_5" data-question-id="${id}">
          <legend class="survey-label">${label}</legend>
          <div class="grid grid-cols-5 gap-2" aria-label="Valutazione da 1 a 5">
            ${[1, 2, 3, 4, 5].map((value) => `
              <label class="rating-choice">
                <input class="sr-only" type="radio" name="${id}" value="${value}" />
                <span class="font-semibold">${value}</span>
              </label>
            `).join('')}
          </div>
          <div class="mt-2 flex justify-between text-[11px] text-text-2"><span>1 = poco</span><span>5 = molto</span></div>
        </fieldset>
      `;
    }

    if (question.type === 'single_choice' && question.options.length) {
      return `
        <fieldset class="survey-card" data-question-type="single_choice" data-question-id="${id}">
          <legend class="survey-label">${label}</legend>
          <div class="grid gap-2">
            ${question.options.map((option) => `
              <label class="min-h-11 rounded-xl border border-hairline-strong bg-surface-2 px-4 py-3 flex items-center gap-3 cursor-pointer hover:bg-surface-2">
                <input type="radio" name="${id}" value="${escapeHTML(option)}" />
                <span>${escapeHTML(option)}</span>
              </label>
            `).join('')}
          </div>
        </fieldset>
      `;
    }

    return `
      <label class="survey-card grid gap-3" data-question-type="text" data-question-id="${id}">
        <span class="survey-label mb-0">${label}</span>
        <textarea name="${id}" rows="4" class="survey-input resize-y" placeholder="Scrivi qui la tua risposta"></textarea>
      </label>
    `;
  }

  function collectAnswers() {
    const answers = {};
    normalizedQuestions(currentSurvey?.questions || []).forEach((question) => {
      const fields = Array.from(form.querySelectorAll(`[name="${CSS.escape(question.id)}"]`));
      if (!fields.length) return;
      const checked = fields.find((field) => field.checked);
      const rawValue = checked ? checked.value : fields[0].value;
      const value = question.type === 'rating_1_5' && rawValue ? Number(rawValue) : (rawValue || '');
      answers[question.id] = {
        type: question.type,
        question: question.title,
        value,
      };
    });
    return answers;
  }

  async function loadSurvey() {
    if (!endpoint) return showError('Backend Supabase non configurato sul sito.');
    if (!token) return showError('Link questionario incompleto: manca il token pubblico.');

    const response = await fetch(`${endpoint}?action=publicSurvey&token=${encodeURIComponent(token)}`);
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || 'Questionario non disponibile.');

    currentSurvey = body;
    if (!body.isOpen) {
      const closes = formatDate(body.closesAt);
      return showError(closes ? `La finestra di compilazione è chiusa. Scadenza: ${closes}.` : 'La finestra di compilazione è chiusa.');
    }

    if (title) title.textContent = body.title || 'Questionario Sténtor';
    if (meta) {
      const parts = [body.companyName, body.venue, body.closesAt ? `Disponibile fino al ${formatDate(body.closesAt)}` : ''];
      meta.textContent = parts.filter(Boolean).join(' · ');
    }

    const questions = normalizedQuestions(body.questions);
    if (questionsTarget) {
      questionsTarget.innerHTML = questions.map(renderQuestion).join('');
    }

    hideAll();
    if (form) form.hidden = false;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (formError) formError.hidden = true;
    if (submitButton) submitButton.disabled = true;

    try {
      const formData = new FormData(form);
      const answers = collectAnswers();
      if (!Object.keys(answers).length && formData.get('comment')) {
        answers.comment = { type: 'text', question: 'Commento', value: String(formData.get('comment') || '') };
      }

      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'submitResponse',
          publicToken: token,
          answers,
          serviceUsed: String(formData.get('serviceUsed') || ''),
          language: String(formData.get('language') || ''),
        }),
      });

      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || 'Invio non riuscito.');

      hideAll();
      if (successPanel) successPanel.hidden = false;
    } catch (error) {
      if (formError) {
        formError.textContent = error instanceof Error ? error.message : 'Invio non riuscito.';
        formError.hidden = false;
      }
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });

  loadSurvey().catch((error) => showError(error instanceof Error ? error.message : 'Questionario non disponibile.'));
</script>
