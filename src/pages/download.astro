---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Btn from "../components/Btn.astro";
---

<Layout
  title="Download Sténtor - Sténtor"
  description="Download Sténtor after your free beta access has been approved. Your Account shows licence keys, activation details and available builds."
  active={null}
>
  <section class="relative overflow-hidden border-b border-hairline pt-24 pb-16">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.35)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] [mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="max-w-[840px]">
        <Eyebrow><span class="font-mono">DOWNLOAD</span></Eyebrow>
        <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.02] tracking-[-0.05em] font-semibold mt-5 mb-4">Download Sténtor.</h1>
        <p class="text-lg leading-[1.55] text-text-2 max-w-[780px] m-0">Sténtor beta is free, but downloads are enabled through an approved Account. Request access, wait for approval, then open your Account to copy the licence key and download the available build.</p>
      </div>
    </div>
  </section>

  <section class="max-w-[1280px] mx-auto px-4 md:px-8 py-16">
    <div class="grid lg:grid-cols-3 gap-5 items-stretch mb-8">
      <article class="relative overflow-hidden border border-red-500/25 rounded-2xl bg-surface p-7 md:p-8 shadow-[0_0_80px_rgba(239,68,68,0.07)]">
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-red-500 mb-4">Step 1</p>
        <h2 class="text-2xl font-semibold tracking-[-0.04em] mb-3">Request access</h2>
        <p class="text-text-3 leading-[1.6] mb-6">Tell us how you want to use Sténtor for rehearsal, performance, surtitles, translation or audio description. No card is required during the beta.</p>
        <Btn href="/request-pro" variant="primary" size="md">Request access</Btn>
      </article>

      <article class="relative overflow-hidden border border-hairline rounded-2xl bg-surface p-7 md:p-8">
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-3 mb-4">Step 2</p>
        <h2 class="text-2xl font-semibold tracking-[-0.04em] mb-3">Approval and licence</h2>
        <p class="text-text-3 leading-[1.6] mb-6">Access is reviewed manually. Once approved, your Account shows the personal licence key, validity period, activation limit and enabled platforms.</p>
        <Btn href="/account" variant="ghost" size="md">Open Account</Btn>
      </article>

      <article class="relative overflow-hidden border border-hairline rounded-2xl bg-surface p-7 md:p-8">
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-3 mb-4">Step 3</p>
        <h2 class="text-2xl font-semibold tracking-[-0.04em] mb-3">Download and activate</h2>
        <p class="text-text-3 leading-[1.6] mb-6">Download links appear inside your Account when a build is available for your workspace. The app asks for the licence key on activation.</p>
        <span class="inline-flex h-10 items-center rounded-lg border border-hairline px-4 text-sm text-text-3">Builds enabled per account</span>
      </article>
    </div>

    <div class="grid lg:grid-cols-2 gap-5 items-stretch">
      <article class="relative overflow-hidden border border-hairline rounded-2xl bg-surface p-7 md:p-8">
        <div class="absolute right-0 top-0 w-56 h-56 pointer-events-none" style="background: radial-gradient(50% 50% at 100% 0%, rgba(148,163,184,0.12), transparent);" aria-hidden="true"></div>
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-3 mb-4">Desktop beta</p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] mb-3">Current availability</h2>
        <p class="text-text-3 leading-[1.6] max-w-[560px] mb-6">macOS is the first target for the private beta. Windows and Linux remain planned as Sténtor moves toward broader desktop support.</p>
        <div class="grid sm:grid-cols-3 gap-2 mb-6">
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>macOS beta</button>
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>Windows planned</button>
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>Linux planned</button>
        </div>
        <p class="text-[13.5px] text-text-4 leading-[1.55]">Public packages are not listed on this page: approved users download builds from Account.</p>
      </article>

      <article class="relative overflow-hidden border border-red-500/25 rounded-2xl bg-surface p-7 md:p-8 shadow-[0_0_80px_rgba(239,68,68,0.07)]">
        <div class="absolute right-0 top-0 w-64 h-64 pointer-events-none" style="background: radial-gradient(50% 50% at 100% 0%, rgba(239,68,68,0.18), transparent);" aria-hidden="true"></div>
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-red-500 mb-4">Licence · Activation key</p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] mb-3">Activation required</h2>
        <p class="text-text-3 leading-[1.6] max-w-[560px] mb-6">The licence key activates the application, associates the device with your access and can be limited or revoked by the Sténtor project.</p>
        <ul class="grid gap-3 text-[14px] text-text-2 mb-7">
          <li class="flex gap-2"><span class="text-green-400">✓</span> Free beta access after approval</li>
          <li class="flex gap-2"><span class="text-green-400">✓</span> Personal activation key</li>
          <li class="flex gap-2"><span class="text-green-400">✓</span> Controlled downloads for theatres, festivals and collaborators</li>
        </ul>
        <Btn href="/account" variant="primary" size="lg">Open Account <span aria-hidden="true">→</span></Btn>
      </article>
    </div>
  </section>
</Layout>
