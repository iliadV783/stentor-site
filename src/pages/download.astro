---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Btn from "../components/Btn.astro";
---

<Layout
  title="Download Stentor - Stentor"
  description="Download Stentor Lite for macOS, Windows and Linux, or request Stentor Pro beta access for native macOS live production."
  active={null}
>
  <section class="relative overflow-hidden border-b border-hairline pt-24 pb-16">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.35)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] [mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="max-w-[760px]">
        <Eyebrow><span class="font-mono">DOWNLOAD</span></Eyebrow>
        <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.02] tracking-[-0.05em] font-semibold mt-5 mb-4">Choose your Stentor.</h1>
        <p class="text-lg leading-[1.55] text-text-2 max-w-[700px] m-0">Stentor Lite is the free cross-platform app built with Tauri. Stentor Pro is the native macOS app for professional live operation, currently available through controlled beta access.</p>
      </div>
    </div>
  </section>

  <section class="max-w-[1280px] mx-auto px-4 md:px-8 py-16">
    <div class="grid lg:grid-cols-2 gap-5 items-stretch">
      <article class="relative overflow-hidden border border-hairline rounded-2xl bg-surface p-7 md:p-8">
        <div class="absolute right-0 top-0 w-56 h-56 pointer-events-none" style="background: radial-gradient(50% 50% at 100% 0%, rgba(148,163,184,0.12), transparent);" aria-hidden="true"></div>
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-3 mb-4">Free · Tauri · Cross-platform</p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] mb-3">Stentor Lite</h2>
        <p class="text-text-3 leading-[1.6] max-w-[520px] mb-6">A lightweight free desktop app for preparing texts, surtitles and translations on macOS, Windows and Linux.</p>
        <div class="grid sm:grid-cols-3 gap-2 mb-6">
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>macOS soon</button>
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>Windows soon</button>
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>Linux soon</button>
        </div>
        <p class="text-[13.5px] text-text-4 leading-[1.55]">The public builds will appear here when the stable Lite packages are ready.</p>
      </article>

      <article class="relative overflow-hidden border border-red-500/25 rounded-2xl bg-surface p-7 md:p-8 shadow-[0_0_80px_rgba(239,68,68,0.07)]">
        <div class="absolute right-0 top-0 w-64 h-64 pointer-events-none" style="background: radial-gradient(50% 50% at 100% 0%, rgba(239,68,68,0.18), transparent);" aria-hidden="true"></div>
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-red-500 mb-4">Native macOS · Private beta</p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] mb-3">Stentor Pro</h2>
        <p class="text-text-3 leading-[1.6] max-w-[520px] mb-6">The professional app for rehearsal and live performance: timeline, cueing, screens, audience phones, translation and audio description.</p>
        <ul class="grid gap-3 text-[14px] text-text-2 mb-7">
          <li class="flex gap-2"><span class="text-green-400">✓</span> Native SwiftUI app for macOS</li>
          <li class="flex gap-2"><span class="text-green-400">✓</span> Controlled beta access during testing</li>
          <li class="flex gap-2"><span class="text-green-400">✓</span> Trial licenses for theatres and companies</li>
        </ul>
        <Btn href="/request-pro" variant="primary" size="lg">Request Pro beta <span aria-hidden="true">→</span></Btn>
      </article>
    </div>

    <div class="mt-8 border border-hairline rounded-2xl bg-surface p-6 md:p-7 grid gap-4 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 class="text-xl font-semibold tracking-[-0.03em] mb-2">Already have a Pro license?</h2>
        <p class="text-text-3 leading-[1.55]">Sign in to the client area to view downloads, license duration and available activations.</p>
      </div>
      <Btn href="/accesso" variant="ghost" size="md">Sign in</Btn>
    </div>
  </section>
</Layout>
