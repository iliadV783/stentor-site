---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Btn from "../components/Btn.astro";
---

<Layout
  title="Download Sténtor - Sténtor"
  description="Download Sténtor for macOS, Windows and Linux, or open your Account to retrieve your access code."
  active={null}
>
  <section class="relative overflow-hidden border-b border-hairline pt-24 pb-16">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.35)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] [mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="max-w-[760px]">
        <Eyebrow><span class="font-mono">DOWNLOAD</span></Eyebrow>
        <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.02] tracking-[-0.05em] font-semibold mt-5 mb-4">Download Sténtor.</h1>
        <p class="text-lg leading-[1.55] text-text-2 max-w-[700px] m-0">Sténtor is the desktop environment for preparing performance texts and operating surtitles, translations, screens, audience access and audio description during rehearsals and live shows.</p>
      </div>
    </div>
  </section>

  <section class="max-w-[1280px] mx-auto px-4 md:px-8 py-16">
    <div class="grid lg:grid-cols-2 gap-5 items-stretch">
      <article class="relative overflow-hidden border border-hairline rounded-2xl bg-surface p-7 md:p-8">
        <div class="absolute right-0 top-0 w-56 h-56 pointer-events-none" style="background: radial-gradient(50% 50% at 100% 0%, rgba(148,163,184,0.12), transparent);" aria-hidden="true"></div>
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-3 mb-4">Desktop · Cross-platform</p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] mb-3">Sténtor</h2>
        <p class="text-text-3 leading-[1.6] max-w-[520px] mb-6">Download builds for macOS, Windows and Linux as soon as they are available for your workspace.</p>
        <div class="grid sm:grid-cols-3 gap-2 mb-6">
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>macOS soon</button>
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>Windows soon</button>
          <button class="h-11 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>Linux soon</button>
        </div>
        <p class="text-[13.5px] text-text-4 leading-[1.55]">Public builds will appear here when stable packages are ready.</p>
      </article>

      <article class="relative overflow-hidden border border-red-500/25 rounded-2xl bg-surface p-7 md:p-8 shadow-[0_0_80px_rgba(239,68,68,0.07)]">
        <div class="absolute right-0 top-0 w-64 h-64 pointer-events-none" style="background: radial-gradient(50% 50% at 100% 0%, rgba(239,68,68,0.18), transparent);" aria-hidden="true"></div>
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-red-500 mb-4">Account · Access code</p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] mb-3">Open your Account</h2>
        <p class="text-text-3 leading-[1.6] max-w-[520px] mb-6">Sign in to view your Sténtor access code, activation details and available builds for your platform.</p>
        <ul class="grid gap-3 text-[14px] text-text-2 mb-7">
          <li class="flex gap-2"><span class="text-green-400">✓</span> Access code in one place</li>
          <li class="flex gap-2"><span class="text-green-400">✓</span> Enabled platforms and available builds</li>
          <li class="flex gap-2"><span class="text-green-400">✓</span> Details for rehearsals and live deployments</li>
        </ul>
        <Btn href="/account" variant="primary" size="lg">Open Account <span aria-hidden="true">→</span></Btn>
      </article>
    </div>

    <div class="mt-8 border border-hairline rounded-2xl bg-surface p-6 md:p-7 grid gap-4 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 class="text-xl font-semibold tracking-[-0.03em] mb-2">Already have an access code?</h2>
        <p class="text-text-3 leading-[1.55]">Sign in to your Account to view downloads, activation details and available builds.</p>
      </div>
      <Btn href="/account" variant="ghost" size="md">Sign in</Btn>
    </div>
  </section>
</Layout>
