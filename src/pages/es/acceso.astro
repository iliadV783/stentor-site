---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---
<Layout title="Acceso Sténtor - Sténtor" description="Accede al área de cuenta de Sténtor." active={null} noindex={true}>
  <section class="max-w-[860px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-4">Acceso</p>
    <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Accede a Sténtor.</h1>
    <p class="text-xl text-text-2 leading-[1.55] max-w-[720px] mb-8">El acceso con Google, Microsoft o enlace e-mail está en preparación. Mientras tanto, solicita una licencia beta o vuelve al área de cuenta.</p>
    <div class="flex flex-wrap gap-3">
      <Btn href="/es/solicitar-prueba" variant="primary" size="lg">Solicitar beta</Btn>
      <Btn href="/es/account" variant="ghost" size="lg">Volver a cuenta</Btn>
    </div>
  </section>
</Layout>