---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---
<Layout title="Para teatros - Sténtor" description="Sténtor para teatros, festivales, escuelas y compañías." active="customers">
  <section class="max-w-[1180px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <div class="max-w-[780px] mb-10">
      <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-4">Para teatros</p>
      <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Accesibilidad teatral con una regía clara.</h1>
      <p class="text-xl text-text-2 leading-[1.55]">Sténtor ayuda a preparar y operar sobretítulos, traducciones y audio descripción en espacios reales: teatros, festivales, escuelas, compañías e instituciones culturales.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      <article class="rounded-2xl border border-hairline bg-surface p-6"><h2 class="text-xl font-semibold mb-3">Ensayos</h2><p class="text-text-3 leading-[1.6]">Prueba textos, pantallas y dispositivos antes de la función.</p></article>
      <article class="rounded-2xl border border-hairline bg-surface p-6"><h2 class="text-xl font-semibold mb-3">Funciones</h2><p class="text-text-3 leading-[1.6]">Opera cues y salidas desde una postación dedicada.</p></article>
      <article class="rounded-2xl border border-hairline bg-surface p-6"><h2 class="text-xl font-semibold mb-3">Investigación</h2><p class="text-text-3 leading-[1.6]">Recoge feedback y mejora los flujos de accesibilidad.</p></article>
    </div>
    <div class="mt-8 flex flex-wrap gap-3"><Btn href="/es/solicitar-prueba" variant="primary">Solicitar acceso</Btn><Btn href="/es/contact" variant="ghost">Contactar</Btn></div>
  </section>
</Layout>