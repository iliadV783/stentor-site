---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---
<Layout title="Contacto - Sténtor" description="Contacta con Sténtor para pruebas, teatros e instituciones." active={null}>
  <section class="max-w-[960px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-4">Contacto</p>
    <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Hablemos de Sténtor.</h1>
    <p class="text-xl text-text-2 leading-[1.55] max-w-[760px] mb-8">Para pruebas, teatros, festivales, escuelas e instituciones, puedes solicitar acceso beta y describir tu contexto de uso.</p>
    <div class="flex flex-wrap gap-3">
      <Btn href="/es/solicitar-prueba" variant="primary" size="lg">Solicitar beta</Btn>
      <Btn href="/es/download" variant="ghost" size="lg">Ver descargas</Btn>
    </div>
  </section>
</Layout>