---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Admin Sténtor – Sténtor"
  description="Area amministrativa riservata per licenze e attivazioni Sténtor."
  active={null}
  showNav={false}
  showFooter={false}
  noindex={true}
>
  <section class="min-h-screen bg-black text-white">
    <header class="border-b border-white/10">
      <div class="max-w-[1280px] mx-auto px-5 md:px-8 h-16 flex items-center justify-between">
        <a href="/" class="font-semibold tracking-[-0.04em] text-xl">STÉNTOR</a>
        <span class="text-white/45 text-sm">Area amministrativa riservata</span>
      </div>
    </header>

    <main class="max-w-[1280px] mx-auto px-5 md:px-8 py-10">
      <div class="rounded-2xl border border-yellow-400/25 bg-yellow-400/[0.06] p-5 mb-6">
        <p class="font-medium text-yellow-100 mb-1">Protezione da configurare</p>
        <p class="text-sm text-yellow-100/65 leading-[1.55]">
          Questa pagina è uno scaffold visivo. Prima dell’uso reale deve essere protetta con Cloudflare Access o autenticazione equivalente, limitata agli amministratori Sténtor.
        </p>
      </div>

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-8">
        <div>
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-3">Admin</p>
          <h1 class="text-4xl md:text-6xl tracking-[-0.06em] leading-[0.98] font-semibold">Licenze Sténtor.</h1>
        </div>
        <button class="h-11 px-5 rounded-lg bg-red-500 text-black font-semibold text-sm cursor-not-allowed" disabled>
          + Nuova licenza
        </button>
      </div>

      <div class="grid md:grid-cols-4 gap-4 mb-6">
        <div class="admin-card">
          <p class="admin-label">Clienti</p>
          <p class="admin-value">1</p>
        </div>
        <div class="admin-card">
          <p class="admin-label">Licenze attive</p>
          <p class="admin-value">1</p>
        </div>
        <div class="admin-card">
          <p class="admin-label">Postazioni</p>
          <p class="admin-value">1 / 3</p>
        </div>
        <div class="admin-card">
          <p class="admin-label">Scadenze prossime</p>
          <p class="admin-value">0</p>
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.045] overflow-hidden">
        <div class="px-5 py-4 border-b border-white/10 flex items-center justify-between">
          <h2 class="font-semibold tracking-[-0.02em]">Licenze</h2>
          <span class="text-xs text-white/35">demo data</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm min-w-[820px]">
            <thead class="text-left text-white/45 border-b border-white/10">
              <tr>
                <th class="px-5 py-3 font-medium">Cliente</th>
                <th class="px-5 py-3 font-medium">Email</th>
                <th class="px-5 py-3 font-medium">Piano</th>
                <th class="px-5 py-3 font-medium">Scadenza</th>
                <th class="px-5 py-3 font-medium">Postazioni</th>
                <th class="px-5 py-3 font-medium">Stato</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-white/10">
                <td class="px-5 py-4 font-medium">Teatro Stabile</td>
                <td class="px-5 py-4 text-white/55">referente@esempio.it</td>
                <td class="px-5 py-4 text-white/70">Trial Pro Teatro</td>
                <td class="px-5 py-4 text-white/70">13/06/2027</td>
                <td class="px-5 py-4 text-white/70">1 / 3</td>
                <td class="px-5 py-4"><span class="rounded-full bg-green-400/10 text-green-300 border border-green-400/20 px-2.5 py-1 text-xs">attiva</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-4 mt-6">
        <section class="admin-panel lg:col-span-2">
          <h2 class="text-lg font-semibold tracking-[-0.03em] mb-3">Prossimi moduli</h2>
          <ul class="grid sm:grid-cols-2 gap-3 text-sm text-white/60">
            <li class="todo">Creazione licenze</li>
            <li class="todo">Revoca e rinnovo</li>
            <li class="todo">Dispositivi attivati</li>
            <li class="todo">API app macOS</li>
          </ul>
        </section>
        <section class="admin-panel">
          <h2 class="text-lg font-semibold tracking-[-0.03em] mb-3">Sicurezza</h2>
          <p class="text-sm text-white/55 leading-[1.6]">
            Prima del collegamento a dati reali: protezione /admin, login amministratore, database licenze e log attivazioni.
          </p>
        </section>
      </div>
    </main>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";
  .admin-card { @apply rounded-2xl border border-white/10 bg-white/[0.045] p-5; }
  .admin-label { @apply text-white/45 text-xs mb-2; }
  .admin-value { @apply text-2xl font-semibold tracking-[-0.04em]; }
  .admin-panel { @apply rounded-2xl border border-white/10 bg-white/[0.045] p-5; }
  .todo { @apply rounded-xl border border-white/10 bg-black/25 px-4 py-3; }
</style>
