---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin - Sténtor" description="Console riservata di amministrazione Sténtor." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.18)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_64%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_64%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[620px] h-[620px] rounded-full bg-red-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <header class="relative border-b border-white/10">
      <div class="max-w-[1440px] mx-auto px-5 md:px-8 h-20 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-3 text-white hover:text-white/80 transition-colors cursor-pointer" aria-label="Home Sténtor"><span class="font-semibold tracking-[-0.04em] text-xl">STÉNTOR</span><span class="text-white/45 text-sm">Admin</span></a>
        <div class="flex items-center gap-3"><span data-admin-email class="hidden sm:inline-flex h-9 items-center px-3 rounded-full border border-amber-400/25 bg-amber-400/10 text-amber-200 text-xs font-mono uppercase tracking-[0.12em]">Area riservata</span><button data-admin-logout class="inline-flex items-center justify-center h-10 px-4 rounded-xl border border-white/10 text-sm text-white/65 hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer">Esci</button><a href="/" class="inline-flex items-center justify-center h-10 px-4 rounded-xl border border-white/10 text-sm text-white/65 hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer">Torna al sito</a></div>
      </div>
    </header>

    <main class="relative max-w-[1440px] mx-auto px-5 md:px-8 py-10">
      <section data-admin-login hidden class="max-w-[680px] mx-auto rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-7 md:p-8">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-3">Accesso admin</p>
        <h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4">Accesso riservato.</h1>
        <p class="text-white/50 leading-[1.6] mb-7">Accedi con email e password Supabase. Il magic link resta disponibile come alternativa, ma durante i test può essere limitato.</p>
        <form data-admin-login-form class="grid gap-4">
          <input name="email" type="email" autocomplete="email" placeholder="nome@dominio.it" class="admin-input" required />
          <input name="password" type="password" autocomplete="current-password" placeholder="Password admin" class="admin-input" />
          <button type="submit" class="h-13 rounded-xl bg-red-500 text-black font-semibold hover:bg-red-400 transition-colors cursor-pointer">Accedi</button>
          <button type="button" data-admin-magic-link class="h-12 rounded-xl border border-white/10 text-white/65 hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer">Invia magic link</button>
        </form>
        <p data-admin-error hidden class="mt-5 rounded-xl border border-red-500/30 bg-red-500/10 text-red-200 text-sm leading-[1.5] p-4"></p>
      </section>

      <div data-admin-app hidden class="grid lg:grid-cols-[260px_1fr] gap-6">
        <aside class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-4 h-fit">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-white/35 px-3 mb-3">Console</p>
          <nav class="grid gap-1 text-sm"><a href="#requests" class="admin-nav-active">Richieste beta</a><a href="#invites" class="admin-nav">Inviti</a><a href="#licenses" class="admin-nav">Licenze</a><a href="/admin/feedback/" class="admin-nav">Dati e feedback</a><a href="#downloads" class="admin-nav">Download</a><a href="#notes" class="admin-nav">Note tecniche</a></nav>
        </aside>

        <div class="grid gap-6 min-w-0">
          <section class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
              <div><p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-3">Console admin</p><h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold">Gestione beta.</h1><p class="text-white/50 leading-[1.6] mt-4 max-w-[760px]">Richieste lette da Supabase con account admin. Puoi approvare richieste, creare licenze e generare inviti temporanei alla sperimentazione.</p></div>
              <div class="grid grid-cols-3 gap-2 min-w-[300px]"><div class="admin-stat"><span>In attesa</span><strong data-stat-pending>--</strong></div><div class="admin-stat"><span>Approvate</span><strong data-stat-approved>--</strong></div><div class="admin-stat"><span>Licenze</span><strong data-stat-licenses>--</strong></div></div>
            </div>
          </section>

          <section id="requests" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm overflow-hidden">
            <div class="p-6 md:p-7 border-b border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-4"><div><p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-2">Richieste beta</p><h2 class="text-2xl font-semibold tracking-[-0.04em]">Richieste ricevute</h2></div><div class="flex flex-wrap gap-2"><span class="admin-pill">pending</span><span class="admin-pill-muted">approved</span><span class="admin-pill-muted">rejected</span></div></div>
            <div class="overflow-x-auto"><table class="admin-table"><thead class="admin-thead"><tr><th class="admin-th w-[220px]">Nome</th><th class="admin-th w-[250px]">Email</th><th class="admin-th w-[230px]">Organizzazione</th><th class="admin-th w-[150px] text-center">Piattaforme</th><th class="admin-th w-[110px] text-center">Posti</th><th class="admin-th w-[150px] text-center">Stato</th><th class="admin-th w-[190px] text-center">Azione</th></tr></thead><tbody data-admin-requests class="divide-y divide-white/8"><tr><td class="admin-td text-white/45" colspan="7">Caricamento...</td></tr></tbody></table></div>
            <div class="p-5 border-t border-white/10 bg-black/20 text-white/42 text-sm leading-[1.6]">Le righe arrivano da Supabase -> beta_requests. Le azioni aggiornano lo stato.</div>
          </section>

          <section id="invites" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7">
            <div class="flex flex-col xl:flex-row xl:items-start gap-6">
              <div class="xl:w-[360px] shrink-0">
                <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-3">Inviti</p>
                <h2 class="text-2xl font-semibold tracking-[-0.04em] mb-3">Invita a provare Sténtor</h2>
                <p class="text-white/50 text-sm leading-[1.6] mb-5">Crea un link di invito alla sperimentazione. Il link resta valido 14 giorni; quando viene accettato, attiva un accesso di 6 mesi per macOS.</p>
                <form data-admin-invite-form class="grid gap-3">
                  <input data-admin-invite-email type="email" autocomplete="email" placeholder="email@dominio.it" class="admin-input" required />
                  <input data-admin-invite-name type="text" autocomplete="name" placeholder="Nome opzionale" class="admin-input" />
                  <button data-admin-invite-submit type="submit" class="h-12 rounded-xl bg-red-500 text-black font-semibold hover:bg-red-400 transition-colors cursor-pointer disabled:opacity-45 disabled:cursor-wait">Crea invito</button>
                </form>
                <div data-admin-invite-message class="mt-4"></div>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-3 mb-4">
                  <h3 class="text-lg font-semibold tracking-[-0.03em]">Inviti recenti</h3>
                  <span class="admin-pill-muted">sperimentazione</span>
                </div>
                <div data-admin-invites-list class="grid gap-3 text-sm text-white/55 leading-[1.6]"><p>Caricamento inviti...</p></div>
              </div>
            </div>
          </section>

          <div class="grid xl:grid-cols-2 gap-6"><section id="licenses" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7"><p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-3">Licenze</p><h2 class="text-2xl font-semibold tracking-[-0.04em] mb-4">Licenze attive</h2><div data-admin-licenses class="grid gap-3 text-sm text-white/55 leading-[1.6]"><p>Caricamento licenze...</p></div></section><section id="downloads" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7"><p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-3">Download</p><h2 class="text-2xl font-semibold tracking-[-0.04em] mb-4">Build disponibili</h2><div class="grid gap-3 text-sm text-white/55 leading-[1.6]"><p>La versione Lite potrà diventare pubblica. I download Pro restano collegati alle licenze approvate e alle piattaforme abilitate.</p><div class="grid grid-cols-3 gap-2"><span class="download-chip">macOS</span><span class="download-chip">Windows</span><span class="download-chip">Linux</span></div></div></section></div>
          <section id="notes" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7"><p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-3">Prossimi passi</p><h2 class="text-2xl font-semibold tracking-[-0.04em] mb-4">Piano di connessione sicura</h2><ol class="grid md:grid-cols-4 gap-3 text-sm text-white/58 leading-[1.55]"><li class="admin-step"><strong>1</strong><span>Creare licenza su approvazione.</span></li><li class="admin-step"><strong>2</strong><span>Collegare area account.</span></li><li class="admin-step"><strong>3</strong><span>Aggiungere download protetti.</span></li><li class="admin-step"><strong>4</strong><span>Aggiungere notifiche email.</span></li></ol></section>
        </div>
      </div>
    </main>
  </section>
</Layout>

<script>
  import { setupAdminConsole } from '../lib/adminConsole';
  import { setupAdminInvites } from '../lib/adminInvites';

  const publicSiteUrl = String(import.meta.env.PUBLIC_SITE_URL || 'https://www.stentor.live').replace(/\/$/, '');

  function normalizeInviteUrl(value: string) {
    if (!value) return '';
    try {
      const url = new URL(value, publicSiteUrl);
      if (url.pathname === '/invite/accept') return `${publicSiteUrl}${url.pathname}${url.search}${url.hash}`;
    } catch {
      if (value.startsWith('/')) return `${publicSiteUrl}${value}`;
    }
    return value;
  }

  function normalizeAdminInviteLinks() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-invite-url]').forEach((button) => {
      const normalized = normalizeInviteUrl(button.dataset.copyInviteUrl || '');
      if (!normalized) return;
      button.dataset.copyInviteUrl = normalized;
      const code = button.previousElementSibling;
      if (code?.tagName === 'CODE') code.textContent = normalized;
    });
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy-invite-url]');
    if (!button) return;
    button.dataset.copyInviteUrl = normalizeInviteUrl(button.dataset.copyInviteUrl || '');
  }, true);

  setupAdminConsole();
  setupAdminInvites();

  normalizeAdminInviteLinks();
  new MutationObserver(normalizeAdminInviteLinks).observe(document.body, { childList: true, subtree: true });
</script>

<style is:global>
  @reference "../styles/global.css";
  .admin-nav { @apply h-10 px-3 rounded-xl inline-flex items-center text-white/48 hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer; }
  .admin-nav-active { @apply h-10 px-3 rounded-xl inline-flex items-center text-white bg-white/[0.08] border border-white/10 cursor-pointer; }
  .admin-stat { @apply rounded-xl border border-white/10 bg-black/25 p-3; }
  .admin-stat span { @apply block text-[11px] font-mono uppercase tracking-[0.12em] text-white/35 mb-2; }
  .admin-stat strong { @apply text-2xl font-semibold tracking-[-0.04em]; }
  .admin-pill { @apply inline-flex h-8 items-center px-3 rounded-full bg-red-500/15 border border-red-500/25 text-red-200 text-xs font-mono uppercase tracking-[0.1em]; }
  .admin-pill-muted { @apply inline-flex h-8 items-center px-3 rounded-full bg-white/[0.04] border border-white/10 text-white/38 text-xs font-mono uppercase tracking-[0.1em]; }
  .admin-input { @apply w-full h-13 rounded-xl border border-white/10 bg-black/30 text-white outline-none transition-all text-[15px]; padding: 0 16px; }
  .admin-input:focus { border-color: rgba(239, 68, 68, 0.55); box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12); }
  .admin-table { @apply w-full min-w-[1300px] table-fixed text-left text-sm; }
  .admin-thead { @apply text-white/38 font-mono text-[11px] uppercase tracking-[0.12em] border-b border-white/10; }
  .admin-th { @apply px-6 py-4 font-medium text-left align-middle whitespace-nowrap; }
  .admin-td { @apply px-6 py-4 text-left align-middle; }
  .admin-td strong { @apply block leading-tight; }
  .admin-platform { @apply inline-flex mr-1 mb-1 px-2 py-1 rounded-md bg-white/[0.06] border border-white/10 text-white/60 text-xs; }
  .status-pending { @apply inline-flex px-2.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-200 text-xs font-mono uppercase tracking-[0.08em]; }
  .status-approved { @apply inline-flex px-2.5 py-1 rounded-full bg-green-400/10 border border-green-400/20 text-green-200 text-xs font-mono uppercase tracking-[0.08em]; }
  .status-rejected { @apply inline-flex px-2.5 py-1 rounded-full bg-red-400/10 border border-red-400/20 text-red-200 text-xs font-mono uppercase tracking-[0.08em]; }
  .admin-button-live { @apply h-9 px-3 rounded-lg border border-white/10 text-white/70 hover:text-white hover:bg-white/[0.06] text-sm transition-colors cursor-pointer; }
  .admin-button-live.secondary { @apply text-white/40; }
  .license-card { @apply rounded-xl border border-white/10 bg-black/25 p-4; }
  .license-label { @apply block text-[10px] font-mono uppercase tracking-[0.12em] text-white/35 mb-1; }
  .license-key { @apply font-mono text-[12px] text-white/78 break-all; }
  .download-chip { @apply h-10 rounded-xl border border-white/10 bg-black/25 inline-flex items-center justify-center text-white/55 text-sm; }
  .admin-step { @apply rounded-xl border border-white/10 bg-black/25 p-4; }
  .admin-step strong { @apply block text-red-400 font-mono mb-2; }
  .invite-card { @apply rounded-xl border border-white/10 bg-black/25 p-4 grid md:grid-cols-[1.4fr_0.8fr_0.9fr_0.9fr] gap-4 items-start; }
</style>
