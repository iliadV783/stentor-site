---
import Layout from "../layouts/Layout.astro";
import IconMenu from "../assets/icons/menu.svg";
import IconSearch from "../assets/icons/search.svg";
import IconWarningTriangle from "../assets/icons/warning-triangle.svg";
import IconEdit from "../assets/icons/edit.svg";
import IconPlayground from "../assets/icons/playground.svg";
import IconMessageCircle from "../assets/icons/message-circle.svg";
import IconX from "../assets/icons/x.svg";
import { sidebarGroups, tocItems, tocActions, pageMeta } from "../data/docs";

const tocActionIconMap = {
  edit: IconEdit,
  playground: IconPlayground,
  "message-circle": IconMessageCircle,
} as const;
---
<Layout
  title="Documentation — Sténtor"
  description="Documentation for Sténtor: the workspace for preparing scripts, translations, surtitles, audio description, timelines and live stage text."
  active="docs"
>
  <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-10 pb-24 grid gap-10 lg:[grid-template-columns:240px_minmax(0,1fr)] xl:[grid-template-columns:260px_minmax(0,1fr)_240px] xl:gap-12 items-start" x-data="{mobileOpen:false}">

    <button @click="mobileOpen=!mobileOpen" class="w-fit lg:hidden inline-flex items-center gap-2 h-10 px-3 border border-hairline rounded-lg text-sm text-text-2 hover:text-text">
      <IconMenu class="w-4 h-4" />
      Documentation
    </button>

    <aside class:list={[
      "lg:sticky lg:top-32 lg:max-h-[calc(100vh-152px)] lg:overflow-y-auto pr-2 text-sm",
      "max-lg:fixed max-lg:inset-x-0 max-lg:top-16 max-lg:bottom-0 max-lg:bg-bg max-lg:border-b max-lg:border-hairline max-lg:p-6 max-lg:z-40 max-lg:overflow-y-auto max-lg:overscroll-contain",
    ]} x-show="mobileOpen || window.matchMedia('(min-width: 1024px)').matches" x-cloak aria-label="Documentation">
      <button @click="mobileOpen=false" class="lg:hidden flex items-center justify-between w-full mb-4 text-xs tracking-[0.08em] uppercase text-text-3 font-medium" aria-label="Close documentation menu">
        <span>Documentation</span>
        <span aria-hidden="true" class="text-base text-text-2"><IconX class="w-4 h-4" /></span>
      </button>
      <div class="docs-search">
        <IconSearch class="w-4 h-4" />
        <span class="flex-1">Search docs…</span>
      </div>
      {sidebarGroups.map((g) => (
        <>
          <h2 class="text-xs tracking-[0.08em] uppercase text-text-4 font-medium mt-6 first:mt-0 mb-2">{g.title}</h2>
          <ul class="grid gap-px list-none p-0 m-0">
            {g.items.map((item) => (
              <li>
                <a href={item.href} class:list={[
                  "flex items-center gap-2.5 px-2.5 py-1.5 transition-colors border-l-2",
                  item.active ? "bg-red-500/[0.08] text-red-500 font-medium border-red-500 rounded-r-md" : "text-text-2 hover:text-text hover:bg-white/[0.03] border-transparent rounded-md",
                ]}>
                  {item.label}
                  {item.badge && (
                    <span class:list={[
                      "ml-auto font-mono text-xs px-1.5 py-px rounded-sm",
                      item.badgeNew ? "text-red-500 bg-red-500/10" : "text-text-3 bg-white/[0.04]",
                    ]}>{item.badge}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </>
      ))}
    </aside>

    <article class="min-w-0 max-w-[840px]">
      <div class="flex items-center gap-2 font-mono text-xs text-text-3 mb-7">
        {pageMeta.breadcrumb.map((b, i) => (
          <>
            {i > 0 && <span class="text-text-4">/</span>}
            {b.href ? <a href={b.href} class="hover:text-text-2">{b.label}</a> : <b class="text-text font-medium">{b.label}</b>}
          </>
        ))}
      </div>

      <h1 id="overview" class="text-4xl md:text-[48px] leading-[1.03] tracking-[-0.05em] font-semibold mb-4">Prepare the text. Build the timeline. Run the show.</h1>
      <p class="text-lg leading-[1.6] text-text-2 max-w-[720px] mb-7">
        Sténtor is a workspace for live performance text, bringing scripts, translations, surtitles, audio description, timelines, screens and stage operation into one carefully controlled project.
      </p>

      <div class="flex items-center gap-3 flex-wrap mb-10 font-mono text-xs text-text-3">
        <span class="w-[22px] h-[22px] rounded-full border border-hairline bg-gradient-to-br from-chrome to-[#161616]"></span>
        <span>{pageMeta.maintainer}</span>
        <span class="text-text-4">·</span>
        <span>{pageMeta.lastUpdated}</span>
        <span class="text-text-4">·</span>
        <span>{pageMeta.readingTime}</span>
      </div>

      <div class="callout callout--info">
        <div>
          <p class="m-0 text-sm leading-[1.55] text-text-2"><b class="text-text font-medium">Current positioning.</b> Sténtor is built for theatres, festivals and performance spaces that need a precise text workflow before and during the show: preparation, multilingual versions, live cueing and accessible materials.</p>
        </div>
      </div>

      <h2 id="what-it-is" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">What Sténtor is</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        Sténtor is an app for people who prepare and operate text in live performance. It keeps the source script, translations, surtitles, characters, cue structure, audio-description notes, timeline and screen settings inside the same production file.
      </p>
      <div class="grid md:grid-cols-3 gap-3 mb-8">
        {[
          { t: "Project-first", d: "Each production keeps text, languages, characters, cues, timeline and settings together." },
          { t: "Built for Regia", d: "The live view focuses on cue position, current and next text, timing, blackout and operational control." },
          { t: "Multilingual by design", d: "The app interface is separate from the languages used by each performance project." },
        ].map((item) => (
          <div class="border border-hairline rounded-xl bg-surface p-4">
            <h3 class="text-[15px] font-semibold tracking-[-0.015em] mb-1">{item.t}</h3>
            <p class="text-sm text-text-2 leading-[1.5] m-0">{item.d}</p>
          </div>
        ))}
      </div>

      <h2 id="version" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">Beta status: desktop app</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        The current beta is focused on the macOS version of Sténtor, while the long-term direction remains desktop and cross-platform. The priority is not to expose a technical prototype, but to deliver a coherent application for preparing projects, importing text, managing languages, building timelines and operating surtitles live.
      </p>
      <div class="border border-hairline rounded-[10px] bg-surface overflow-hidden mb-8">
        <table class="w-full border-collapse text-[13px] min-w-[520px]">
          <thead>
            <tr>
              <th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline">Area</th>
              <th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline">Current direction</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Desktop</td><td class="text-text-2 px-4 py-3 border-b border-hairline">macOS beta first, with the product architecture and communication kept open for Windows and Linux.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Preparation</td><td class="text-text-2 px-4 py-3 border-b border-hairline">Projects, text import, script editing, character management, languages and audio-description notes.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Operation</td><td class="text-text-2 px-4 py-3 border-b border-hairline">Timeline, live cueing, Regia controls, blackout, notes and screen-oriented output.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3">Release</td><td class="text-text-2 px-4 py-3">Installer, licensing and distribution are being prepared alongside the public website.</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="projects" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">1. Projects</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        The Projects view is the entry point. It is where new productions are created, existing work is opened, recent projects are listed, demo material can be loaded and project-level information is kept under control.
      </p>
      <ul class="grid gap-2 mb-5 list-none">
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>Create a new Sténtor project or open a recent one.</span></li>
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>Keep title, languages, characters, cues, timeline, audio description and screen settings together.</span></li>
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>Use demo material for testing without confusing it with the user’s own archive.</span></li>
      </ul>

      <h2 id="import" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">2. Import text</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        Sténtor includes an import workflow for bringing existing scripts into a project. Before the imported text becomes part of the production, the app can present options and a preview so the operator can check structure, characters and cue divisions.
      </p>
      <div class="grid md:grid-cols-2 gap-3 mb-8">
        <div class="border border-hairline rounded-xl bg-surface p-4"><h3 class="text-[15px] font-semibold mb-1">Supported sources</h3><p class="text-sm text-text-2 leading-[1.5] m-0">Text, rich text, Word-style documents, subtitle files and structured data can be progressively supported in the same import flow.</p></div>
        <div class="border border-hairline rounded-xl bg-surface p-4"><h3 class="text-[15px] font-semibold mb-1">Control before import</h3><p class="text-sm text-text-2 leading-[1.5] m-0">The goal is to recognize speakers, cues, acts, scenes and captions without forcing the user to clean everything manually afterward.</p></div>
      </div>

      <h2 id="text" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">3. Text and languages</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        The Text area is where the performance script becomes usable on stage. Lines can be organized into cues, assigned to characters, checked for readability and connected to the project’s language versions.
      </p>
      <div class="border border-hairline rounded-[10px] bg-surface overflow-hidden mb-8">
        <table class="w-full border-collapse text-[13px] min-w-[520px]">
          <thead><tr><th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline">Element</th><th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline">Purpose</th></tr></thead>
          <tbody>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Original script</td><td class="text-text-2 px-4 py-3 border-b border-hairline">Keeps the source text readable and editable during preparation.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Translations</td><td class="text-text-2 px-4 py-3 border-b border-hairline">Allows multiple language versions to stay aligned with the same cue structure.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Characters</td><td class="text-text-2 px-4 py-3 border-b border-hairline">Makes the script easier to scan, filter and eventually visualize across the timeline.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3">Line breaks</td><td class="text-text-2 px-4 py-3">Supports readable surtitles by avoiding awkward splits and overly dense text blocks.</td></tr>
          </tbody>
        </table>
      </div>

      <div class="callout callout--info">
        <div>
          <p class="m-0 text-sm leading-[1.55] text-text-2"><b class="text-text font-medium">Interface language is separate.</b> The language used by the app interface is independent from the languages used inside a project. A production can contain Italian, English, French or other versions while the operator uses the interface in another language.</p>
        </div>
      </div>

      <h2 id="audio" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">4. Audio description</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        Audio description is treated as a dedicated layer of the project. Descriptions can be written, reviewed and connected to cues so that accessible material remains close to the script and the live structure.
      </p>
      <div class="callout callout--warning">
        <div class="callout__icon"><IconWarningTriangle class="w-3.5 h-3.5" /></div>
        <div>
          <p class="m-0 text-sm leading-[1.55] text-text-2"><b class="text-text font-medium">Progressive implementation.</b> The documentation describes the intended product direction. Public audio delivery and device playback should be enabled only when the live workflow is reliable enough for a real venue.</p>
        </div>
      </div>

      <h2 id="timeline" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">5. Timeline</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        The timeline gives the operator a visual map of the show. It can show cue order, approximate duration, sections, recorded timings and the current position during rehearsal or performance.
      </p>
      <div class="grid md:grid-cols-2 gap-3 mb-8">
        <div class="border border-hairline rounded-xl bg-surface p-4"><h3 class="text-[15px] font-semibold mb-1">Show overview</h3><p class="text-sm text-text-2 leading-[1.5] m-0">A compact map helps the operator understand where the performance is and what is coming next.</p></div>
        <div class="border border-hairline rounded-xl bg-surface p-4"><h3 class="text-[15px] font-semibold mb-1">Character view direction</h3><p class="text-sm text-text-2 leading-[1.5] m-0">A future view can distribute cues across character lines, making entrances and text density easier to read.</p></div>
      </div>

      <h2 id="stage-desk" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">6. Regia</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        Regia is the live operating view. It keeps the current cue, the next cue, timing, blackout, navigation and operator notes close together, so the person running the show can stay focused.
      </p>
      <div class="border border-hairline rounded-[10px] bg-surface overflow-hidden mb-8">
        <table class="w-full border-collapse text-[13px] min-w-[520px]">
          <thead><tr><th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline">Tool</th><th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline">Use</th></tr></thead>
          <tbody>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Advance / back</td><td class="text-text-2 px-4 py-3 border-b border-hairline">Manual cueing remains the safest default for live performance.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Blackout</td><td class="text-text-2 px-4 py-3 border-b border-hairline">The operator can immediately hide text when the stage moment requires it.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3 border-b border-hairline">Recorded timing</td><td class="text-text-2 px-4 py-3 border-b border-hairline">Rehearsal timings can support preparation without replacing live judgment.</td></tr>
            <tr><td class="font-mono text-text px-4 py-3">Notes</td><td class="text-text-2 px-4 py-3">Operational notes help track issues, cuts and cue adjustments during rehearsal.</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="screens" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">7. Screens</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        The Screens section is the place for configuring public output. Each screen can progressively receive its own language, format, style and content destination, depending on the needs of the venue.
      </p>
      <div class="grid md:grid-cols-2 gap-3 mb-8">
        <div class="border border-hairline rounded-xl bg-surface p-4"><h3 class="text-[15px] font-semibold mb-1">Projection targets</h3><p class="text-sm text-text-2 leading-[1.5] m-0">Screens can represent different outputs, rooms, projectors or future audience-facing displays.</p></div>
        <div class="border border-hairline rounded-xl bg-surface p-4"><h3 class="text-[15px] font-semibold mb-1">Readable styles</h3><p class="text-sm text-text-2 leading-[1.5] m-0">Typography, contrast and layout should remain simple enough for performance conditions.</p></div>
      </div>

      <h2 id="audience" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">8. Audience views</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        Sténtor’s long-term direction includes audience-facing views for surtitles, translations and accessible materials. In the current desktop beta, this area should be presented carefully: the live operator workflow comes first, and audience devices should be introduced only when the room setup is dependable.
      </p>
      <ul class="grid gap-2 mb-5 list-none">
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>Useful for future multilingual access and mobile reading scenarios.</span></li>
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>Should remain secondary to reliable projection and Regia controls.</span></li>
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>May later support QR access, language choice and accessible content.</span></li>
      </ul>

      <h2 id="files" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">9. Import and export</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        File support is centered on getting real production material into and out of Sténtor without destroying structure. Import should support text-first formats and structured data; export should help rehearsal, touring, archiving and translation review.
      </p>
      <div class="docs-codeblock mb-6">
        <div class="docs-codeblock__bar"><span class="font-mono">file workflow</span><span class="font-mono text-text-3">preparation / archive</span></div>
        <pre class="docs-codeblock__body"><code><span class="tok-ln">1</span><span class="tok-pn">→</span> Import script or subtitle material
<span class="tok-ln">2</span><span class="tok-pn">→</span> Review structure, characters and cue divisions
<span class="tok-ln">3</span><span class="tok-pn">→</span> Export project material for rehearsal, translation or archive</code></pre>
      </div>

      <h2 id="desktop" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">10. macOS app</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        Sténtor is being prepared first as a polished macOS application, without presenting the project as Mac-only. The public release should feel like a proper desktop app: clear project opening, coherent menus, a recognizable icon, an installer, versioning, licensing and a workflow that does not expose development tooling to the user.
      </p>
      <div class="docs-codeblock mb-6">
        <div class="docs-codeblock__bar"><span class="font-mono">release path</span><span class="font-mono text-text-3">macOS</span></div>
        <pre class="docs-codeblock__body"><code><span class="tok-ln">1</span><span class="tok-pn">✓</span> Native app interface
<span class="tok-ln">2</span><span class="tok-pn">→</span> Installer and distribution package
<span class="tok-ln">3</span><span class="tok-pn">→</span> License activation and public download flow</code></pre>
      </div>

      <h2 id="planned" class="text-2xl md:text-[28px] tracking-[-0.03em] font-semibold mt-14 mb-4 pt-4">What is still planned</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">
        Sténtor is in active beta development. The key areas still being refined are the importer, recent-project handling, complete interface localization, multi-screen output, licensing, installer packaging, export formats, external control options and the safest way to introduce audience-facing devices.
      </p>

      <div class="mt-8 px-6 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border border-hairline rounded-xl bg-surface">
        <div>
          <b class="font-medium">Preparing a real production?</b>
          <p class="mt-1 text-[13px] text-text-3 m-0">Start with a project, import the script, organize the languages and build a timeline before using Regia in rehearsal.</p>
        </div>
        <div class="flex gap-2">
          <a href="/download" class="h-8 px-3.5 rounded-md bg-red-500 text-bg text-[13px] inline-flex items-center">Download</a>
          <a href="/contact" class="h-8 px-3.5 rounded-md border border-hairline text-text-2 hover:text-text text-[13px] inline-flex items-center">Share notes</a>
        </div>
      </div>
    </article>

    <aside class="hidden xl:block sticky top-32 max-h-[calc(100vh-152px)] overflow-y-auto pl-4 border-l border-hairline text-[13px]" aria-label="On this page">
      <h2 class="text-xs tracking-[0.08em] uppercase text-text-3 font-medium mb-3">On this page</h2>
      <ul class="grid gap-1.5 list-none p-0 m-0">
        {tocItems.map((t, i) => (
          <li class:list={[t.sub && "pl-3.5"]}>
            <a href={t.href} data-toc-link class:list={["block py-0.5 transition-colors duration-300 ease-out", i === 0 ? "text-red-500" : "text-text-3 hover:text-text-2", t.sub && "text-xs"]}>{t.label}</a>
          </li>
        ))}
      </ul>
      <div class="mt-7 pt-4 border-t border-hairline grid gap-2 text-xs">
        {tocActions.map((a) => {
          const Icon = tocActionIconMap[a.icon];
          return (
            <a href={a.href} class="inline-flex items-center gap-2 text-text-3 hover:text-text-2">
              <Icon class="w-4 h-4" />
              {a.label}
            </a>
          );
        })}
      </div>
    </aside>
  </div>
</Layout>

<script is:inline>
  function setupTocScrollSpy() {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (!links.length) return;
    const sections = links
      .map((link) => {
        const href = link.getAttribute("href") || "";
        if (!href.startsWith("#")) return null;
        const el = document.getElementById(href.slice(1));
        return el ? { id: el.id, el, link } : null;
      })
      .filter(Boolean);
    if (!sections.length) return;
    function activate(id) {
      sections.forEach((s) => {
        const isActive = s.id === id;
        if (isActive) {
          s.link.classList.add("text-red-500");
          s.link.classList.remove("text-text-3", "hover:text-text-2");
        } else {
          s.link.classList.remove("text-red-500");
          s.link.classList.add("text-text-3", "hover:text-text-2");
        }
      });
    }
    const visible = new Set();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        const active = sections.find((s) => visible.has(s.id)) || sections[0];
        if (active) activate(active.id);
      },
      { rootMargin: "-20% 0px -65% 0px", threshold: 0.01 }
    );
    sections.forEach((s) => observer.observe(s.el));
  }
  setupTocScrollSpy();
  document.addEventListener("astro:page-load", setupTocScrollSpy);
</script>
