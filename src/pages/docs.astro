---
import Layout from "../layouts/Layout.astro";
import IconMenu from "../assets/icons/menu.svg";
import IconSearch from "../assets/icons/search.svg";
import IconCopy from "../assets/icons/copy.svg";
import IconInfo from "../assets/icons/info.svg";
import IconWarningTriangle from "../assets/icons/warning-triangle.svg";
import IconEdit from "../assets/icons/edit.svg";
import IconPlayground from "../assets/icons/playground.svg";
import IconMessageCircle from "../assets/icons/message-circle.svg";
import IconX from "../assets/icons/x.svg";
import { sidebarGroups, tocItems, tocActions, pageMeta } from "../data/docs";

const tocActionIconMap = {
  edit: IconEdit,
  playground: IconPlayground,
  "message-circle": IconMessageCircle,
} as const;
---
<Layout
  title="Workflow — Sténtor"
  description="A practical workflow for preparing, cueing and sharing surtitles, translations and audio descriptions with Sténtor."
  active="docs"
>
  <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-10 pb-24 grid gap-10 lg:[grid-template-columns:240px_minmax(0,1fr)] xl:[grid-template-columns:260px_minmax(0,1fr)_240px] xl:gap-12 items-start" x-data="{tab:'desktop', mobileOpen:false}">

    <!-- Mobile menu button -->
    <button @click="mobileOpen=!mobileOpen" class="w-fit lg:hidden inline-flex items-center gap-2 h-10 px-3 border border-hairline rounded-lg text-sm text-text-2 hover:text-text">
      <IconMenu class="w-4 h-4" />
      Documentation
    </button>

    <!-- Left sidebar -->
    <aside class:list={[
      "lg:sticky lg:top-32 lg:max-h-[calc(100vh-152px)] lg:overflow-y-auto pr-2 text-sm",
      "max-lg:fixed max-lg:inset-x-0 max-lg:top-16 max-lg:bottom-0 max-lg:bg-bg max-lg:border-b max-lg:border-hairline max-lg:p-6 max-lg:z-40 max-lg:overflow-y-auto max-lg:overscroll-contain",
    ]} x-show="mobileOpen || window.matchMedia('(min-width: 1024px)').matches" x-cloak aria-label="Documentation">
      <button @click="mobileOpen=false" class="lg:hidden flex items-center justify-between w-full mb-4 text-xs tracking-[0.08em] uppercase text-text-3 font-medium" aria-label="Close documentation menu">
        <span>Documentation</span>
        <span aria-hidden="true" class="text-base text-text-2"><IconX class="w-4 h-4" /></span>
      </button>
      <div class="docs-search">
        <IconSearch class="w-4 h-4" />
        <span class="flex-1">Search docs…</span>
      </div>
      {sidebarGroups.map((g) => (
        <>
          <h2 class="text-xs tracking-[0.08em] uppercase text-text-4 font-medium mt-6 first:mt-0 mb-2">{g.title}</h2>
          <ul class="grid gap-px list-none p-0 m-0">
            {g.items.map((item) => (
              <li>
                <a href={item.href} class:list={[
                  "flex items-center gap-2.5 px-2.5 py-1.5 transition-colors border-l-2",
                  item.active ? "bg-red-500/[0.08] text-red-500 font-medium border-red-500 rounded-r-md" : "text-text-2 hover:text-text hover:bg-white/[0.03] border-transparent rounded-md",
                ]}>
                  {item.label}
                  {item.badge && (
                    <span class:list={[
                      "ml-auto font-mono text-xs px-1.5 py-px rounded-sm",
                      item.badgeNew ? "text-red-500 bg-red-500/10" : "text-text-3 bg-white/[0.04]",
                    ]}>{item.badge}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </>
      ))}
    </aside>

    <!-- Main content -->
    <article class="min-w-0 max-w-[820px]">
      <div class="flex items-center gap-2 font-mono text-xs text-text-3 mb-7">
        {pageMeta.breadcrumb.map((b, i) => (
          <>
            {i > 0 && <span class="text-text-4">/</span>}
            {b.href ? (
              <a href={b.href} class="hover:text-text-2">{b.label}</a>
            ) : (
              <b class="text-text font-medium">{b.label}</b>
            )}
          </>
        ))}
      </div>

      <h1 id="quickstart" class="text-4xl md:text-[44px] leading-[1.05] tracking-[-0.04em] font-semibold mb-3">Prepare, cue and share a live performance text.</h1>
      <p class="text-lg leading-[1.55] text-text-2 max-w-[640px] mb-7">
        This workflow follows the current Sténtor app: create or import a project, prepare cues and languages in <code class="docs-code">Script</code>, operate the show from the <code class="docs-code">Operator view</code>, and let screens and audience phones follow through Live Sync.
      </p>

      <div class="flex items-center gap-3 flex-wrap mb-10 font-mono text-xs text-text-3">
        <span class="w-[22px] h-[22px] rounded-full border border-hairline bg-gradient-to-br from-chrome to-[#161616]"></span>
        <span>{pageMeta.maintainer}</span>
        <span class="text-text-4">·</span>
        <span>{pageMeta.lastUpdated}</span>
        <span class="text-text-4">·</span>
        <span>{pageMeta.readingTime}</span>
      </div>

      <!-- Prerequisites -->
      <h2 id="prerequisites" class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mt-14 mb-4 pt-4">What you need</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">Sténtor is designed to work in rehearsal rooms and theatres with a lightweight setup. For preparation you only need the desktop app or the web prototype. For a live room with audience phones, use a local network that the operator computer and smartphones can join.</p>
      <ul class="grid gap-2 mb-5 list-none">
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>A Sténtor project, either created from scratch or imported from <code class="docs-code">.docx</code>, <code class="docs-code">.txt</code>, <code class="docs-code">.srt</code>, <code class="docs-code">.vtt</code>, <code class="docs-code">.csv</code> or <code class="docs-code">.json</code>.</span></li>
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>One operator computer for the <code class="docs-code">Operator view</code>, plus optional projection screens and audience smartphones.</span></li>
        <li class="flex gap-2 items-start text-zinc-300 text-[15px] leading-[1.55] before:content-[''] before:flex-none before:mt-2 before:w-[5px] before:h-[5px] before:rounded-full before:bg-red-500"><span>For Live Sync in a venue, a stable local Wi-Fi network. Internet is not required for the room prototype; the devices only need to be on the same network.</span></li>
      </ul>

      <div class="callout callout--info">
        <div class="callout__icon"><IconInfo class="w-3.5 h-3.5" /></div>
        <div>
          <p class="m-0 text-sm leading-[1.55] text-text-2"><b class="text-text font-medium">Desktop-first, room-ready.</b> The current app can run as a web prototype and is structured for a Tauri desktop build. The live room mode uses a small local Node server to share project state, cue position and audience presence.</p>
        </div>
      </div>

      <!-- Install -->
      <h2 id="install" class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mt-14 mb-4 pt-4">1. Install and open Sténtor</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">For development or testing, install dependencies once and choose the mode you need. The desktop build is the long-term production direction; the web and room commands are useful for testing workflows quickly.</p>

      <div class="docs-codeblock">
        <div class="docs-codeblock__bar">
          <div class="inline-flex gap-0.5 p-0.5 border border-hairline rounded-md">
            {["desktop", "web", "room", "build"].map((t) => (
              <button
                @click={`tab='${t}'`}
                :class={`tab==='${t}' ? 'bg-red-500/[0.12] text-red-500' : 'text-text-3'`}
                class="px-2 py-[3px] rounded-sm font-mono text-xs cursor-pointer"
              >{t}</button>
            ))}
          </div>
          <span class="inline-flex items-center gap-1.5 px-2 py-[3px] rounded-md border border-hairline text-text-3">
            <IconCopy class="w-4 h-4" />
            Copy
          </span>
        </div>
        <pre class="docs-codeblock__body" x-show="tab==='desktop'"><code><span class="tok-cm"><span class="tok-ln">1</span># install dependencies</span>
<span class="tok-ln">2</span><span class="tok-pn">$</span> npm install
<span class="tok-ln">3</span>
<span class="tok-cm"><span class="tok-ln">4</span># open the desktop app during development</span>
<span class="tok-ln">5</span><span class="tok-pn">$</span> npm run desktop:dev</code></pre>
        <pre class="docs-codeblock__body" x-show="tab==='web'" x-cloak><code><span class="tok-pn">$</span> npm install
<span class="tok-pn">$</span> npm run dev</code></pre>
        <pre class="docs-codeblock__body" x-show="tab==='room'" x-cloak><code><span class="tok-pn">$</span> npm install
<span class="tok-pn">$</span> npm run build
<span class="tok-pn">$</span> npm run room</code></pre>
        <pre class="docs-codeblock__body" x-show="tab==='build'" x-cloak><code><span class="tok-pn">$</span> npm test
<span class="tok-pn">$</span> npm run build
<span class="tok-pn">$</span> npm run desktop:build</code></pre>
      </div>

      <!-- Init -->
      <h2 id="init" class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mt-14 mb-4 pt-4">2. Create or import a project</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">Start from <code class="docs-code">Projects</code>. You can create a blank project, open an existing Sténtor file, or import a script. Word import recognises theatrical structure where possible: characters, speeches, stage directions and markers such as act, scene, tableau or interval.</p>

      <div class="grid gap-3 mb-8">
        {[
          { n: 1, t: "Add project metadata", d: "Set title, company or collective, main language and useful production notes. Keep fields empty when they are not needed." },
          { n: 2, t: "Import or paste the script", d: "Use Word, TXT, SRT, WebVTT, CSV or JSON depending on where the material comes from. Imported scripts stay editable." },
          { n: 3, t: "Check languages", d: "Add, rename, duplicate or remove languages from the language menu. Sténtor keeps at least one language active in every project." },
        ].map((s) => (
          <div class="grid [grid-template-columns:36px_1fr] gap-3.5 px-5 py-4 border border-hairline rounded-xl bg-surface">
            <div class="w-7 h-7 rounded-lg grid place-items-center border border-red-500/30 bg-red-500/10 text-red-500 font-mono text-[13px] font-medium">{s.n}</div>
            <div>
              <h3 class="text-[15px] mb-1.5 mt-1 tracking-[-0.015em] font-semibold">{s.t}</h3>
              <p class="text-sm text-text-2 m-0">{s.d}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Prepare -->
      <h2 id="define-model" class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mt-14 mb-4 pt-4">3. Prepare cues and layers</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">In <code class="docs-code">Script</code>, each cue can hold original text, translations, notes and timing. Use markers for acts, scenes and intervals. Use the audio-description panel to connect descriptions to cue points and prepare a separate audio script when needed.</p>

      <div class="docs-codeblock">
        <div class="docs-codeblock__bar">
          <span class="font-mono">project.stentor.json</span>
          <span class="font-mono text-text-3">conceptual structure</span>
        </div>
        <pre class="docs-codeblock__body"><code><span class="tok-ln">1</span>{`{`}
<span class="tok-ln">2</span>  <span class="tok-str">"metadata"</span>: {`{`} <span class="tok-str">"title"</span>: <span class="tok-str">"Macbett"</span>, <span class="tok-str">"company"</span>: <span class="tok-str">"..."</span> {`}`},
<span class="tok-ln">3</span>  <span class="tok-str">"languages"</span>: [<span class="tok-str">"it"</span>, <span class="tok-str">"en"</span>],
<span class="tok-ln">4</span>  <span class="tok-str">"cues"</span>: [
<span class="tok-ln">5</span>    {`{`} <span class="tok-str">"speaker"</span>: <span class="tok-str">""</span>, <span class="tok-str">"original"</span>: <span class="tok-str">"..."</span>, <span class="tok-str">"translations"</span>: {`{`} <span class="tok-str">"en"</span>: <span class="tok-str">"..."</span> {`}`} {`}`}
<span class="tok-ln">6</span>  ],
<span class="tok-ln">7</span>  <span class="tok-str">"audioDescriptions"</span>: [
<span class="tok-ln">8</span>    {`{`} <span class="tok-str">"cueId"</span>: <span class="tok-str">"..."</span>, <span class="tok-str">"text"</span>: <span class="tok-str">"describe the visual action"</span> {`}`}
<span class="tok-ln">9</span>  ]
<span class="tok-ln">10</span>{`}`}</code></pre>
      </div>

      <div class="callout callout--warn">
        <div class="callout__icon"><IconWarningTriangle class="w-3.5 h-3.5" /></div>
        <div>
          <p class="m-0 text-sm leading-[1.55] text-text-2"><b class="text-text font-medium">Keep the cue clean.</b> The speaker field can stay empty. Use it only when the speaking voice or character is useful in rehearsal or in the exported script.</p>
        </div>
      </div>

      <!-- Live -->
      <h2 id="endpoints" class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mt-14 mb-4 pt-4">4. Cue the show</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">Move to the <code class="docs-code">Operator view</code> when the project is ready. The operator advances or rewinds cues, sends blackout, monitors timing and checks what screens and audience phones are receiving.</p>

      <div class="border border-hairline rounded-[10px] bg-surface overflow-hidden mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 px-4 py-3 border-b border-hairline font-mono text-[13px]">
          <div class="flex items-center gap-3">
            <span class="px-2 py-0.5 rounded-sm font-medium text-xs text-red-500 bg-red-500/10">LIVE</span>
            <span class="text-text">Operator view / cue state</span>
          </div>
          <span class="sm:ml-auto text-text-3 text-xs">operator-led · manual first · semi-automatic optional</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[13px] min-w-[480px]">
            <thead>
              <tr>
                <th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline" style="width: 24%;">Area</th>
                <th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline" style="width: 22%;">Use</th>
                <th class="font-mono text-xs tracking-[0.04em] uppercase text-text-3 font-medium bg-white/[0.02] px-4 py-3 text-left border-b border-hairline">What to check</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-mono text-text px-4 py-3 border-b border-hairline">Operator view<span class="text-red-500 ml-0.5">*</span></td>
                <td class="font-mono text-text-3 px-4 py-3 border-b border-hairline">live cueing</td>
                <td class="text-text-2 px-4 py-3 border-b border-hairline">Advance, go back, blackout, read the current and next cue, and add quick notes during the show.</td>
              </tr>
              <tr>
                <td class="font-mono text-text px-4 py-3 border-b border-hairline">Screens</td>
                <td class="font-mono text-text-3 px-4 py-3 border-b border-hairline">projection targets</td>
                <td class="text-text-2 px-4 py-3 border-b border-hairline">Configure each screen with language, aspect ratio and style. Open one screen or all configured screens.</td>
              </tr>
              <tr>
                <td class="font-mono text-text px-4 py-3 border-b border-hairline">Audio description</td>
                <td class="font-mono text-text-3 px-4 py-3 border-b border-hairline">notes and audio</td>
                <td class="text-text-2 px-4 py-3 border-b border-hairline">Prepare descriptions, attach recorded audio when needed, and export TXT, CSV or VTT for revision and rehearsal.</td>
              </tr>
              <tr>
                <td class="font-mono text-text px-4 py-3">Audience</td>
                <td class="font-mono text-text-3 px-4 py-3">audience phones</td>
                <td class="text-text-2 px-4 py-3">Show QR code or local address, monitor connected devices and check how many follow the operator view or enable audio.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Deploy -->
      <h2 id="deploy" class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mt-14 mb-4 pt-4">5. Run Live Sync in the room</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">For a theatre test, build the app and start the room server. Sténtor publishes the project and current cue to connected screens and audience phones on the same local network.</p>

      <div class="docs-codeblock">
        <div class="docs-codeblock__bar">
          <span class="font-mono">terminal</span>
          <span class="font-mono text-text-3">local network mode</span>
        </div>
        <pre class="docs-codeblock__body"><code><span class="tok-ln">1</span><span class="tok-pn">$</span> npm install
<span class="tok-ln">2</span><span class="tok-pn">$</span> npm run build
<span class="tok-ln">3</span><span class="tok-pn">$</span> npm run room
<span class="tok-ln">4</span>
<span class="tok-cm"><span class="tok-ln">5</span># open the operator app on the computer</span>
<span class="tok-cm"><span class="tok-ln">6</span># show the QR code to audience phones on the same Wi-Fi</span></code></pre>
      </div>

      <p class="text-zinc-300 leading-[1.65] mb-4">On the audience page, spectators choose language and mode: surtitles, audio description or both. During the show they can follow the operator view automatically, while the operator remains in control of cue position and blackout.</p>

      <!-- Feedback -->
      <h2 id="feedback" class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mt-14 mb-4 pt-4">6. Share feedback after use</h2>
      <p class="text-zinc-300 leading-[1.65] mb-4">Sténtor is developed through real performances. After a rehearsal or show, collect notes from the operator, translators, audio describers and spectators. The most useful feedback is specific: where the workflow helped, where it slowed down, what audiences actually used, and what should be clearer next time.</p>

      <div class="mt-8 px-6 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border border-hairline rounded-xl bg-surface">
        <div>
          <b class="font-medium">Was this workflow useful?</b>
          <p class="mt-1 text-[13px] text-text-3 m-0">Feedback from real productions helps shape the software, the documentation and the research model.</p>
        </div>
        <div class="flex gap-2">
          <button class="h-8 px-3.5 rounded-md border border-hairline bg-transparent text-text-2 hover:text-text hover:border-hairline-strong text-[13px] whitespace-nowrap">👍 Yes</button>
          <button class="h-8 px-3.5 rounded-md border border-hairline bg-transparent text-text-2 hover:text-text hover:border-hairline-strong text-[13px] whitespace-nowrap">Send notes</button>
        </div>
      </div>

      <!-- Pager -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-16">
        <a href="/features" class="grid gap-1 px-5 py-4 border border-hairline rounded-xl bg-surface hover:border-hairline-strong transition-colors">
          <span class="font-mono text-xs tracking-[0.04em] uppercase text-text-3">Previous</span>
          <span class="text-[15px] text-text font-medium before:content-['←_'] before:text-red-500">Features</span>
        </a>
        <a href="/customers" class="grid gap-1 px-5 py-4 border border-hairline rounded-xl bg-surface hover:border-hairline-strong transition-colors text-right">
          <span class="font-mono text-xs tracking-[0.04em] uppercase text-text-3">Next</span>
          <span class="text-[15px] text-text font-medium after:content-['_→'] after:text-red-500">For theatres</span>
        </a>
      </div>
    </article>

    <!-- Right TOC -->
    <aside class="hidden xl:block sticky top-32 max-h-[calc(100vh-152px)] overflow-y-auto pl-4 border-l border-hairline text-[13px]" aria-label="On this page">
      <h2 class="text-xs tracking-[0.08em] uppercase text-text-3 font-medium mb-3">On this page</h2>
      <ul class="grid gap-1.5 list-none p-0 m-0">
        {tocItems.map((t, i) => (
          <li class:list={[t.sub && "pl-3.5"]}>
            <a
              href={t.href}
              data-toc-link
              class:list={[
                "block py-0.5 transition-colors duration-300 ease-out",
                i === 0 ? "text-red-500" : "text-text-3 hover:text-text-2",
                t.sub && "text-xs",
              ]}
            >{t.label}</a>
          </li>
        ))}
      </ul>
      <div class="mt-7 pt-4 border-t border-hairline grid gap-2 text-xs">
        {tocActions.map((a) => {
          const Icon = tocActionIconMap[a.icon];
          return (
            <a href={a.href} class="inline-flex items-center gap-2 text-text-3 hover:text-text-2">
              <Icon class="w-4 h-4" />
              {a.label}
            </a>
          );
        })}
      </div>
    </aside>
  </div>
</Layout>

<script is:inline>
  function setupTocScrollSpy() {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (!links.length) return;

    const sections = links
      .map((link) => {
        const href = link.getAttribute("href") || "";
        if (!href.startsWith("#")) return null;
        const el = document.getElementById(href.slice(1));
        return el ? { id: el.id, el, link } : null;
      })
      .filter(Boolean);
    if (!sections.length) return;

    function activate(id) {
      sections.forEach((s) => {
        const isActive = s.id === id;
        if (isActive) {
          s.link.classList.add("text-red-500");
          s.link.classList.remove("text-text-3", "hover:text-text-2");
        } else {
          s.link.classList.remove("text-red-500");
          s.link.classList.add("text-text-3", "hover:text-text-2");
        }
      });
    }

    const visible = new Set();

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        let best = null;
        let bestTop = Infinity;
        sections.forEach((s) => {
          if (!visible.has(s.id)) return;
          const top = s.el.getBoundingClientRect().top;
          if (top < bestTop) {
            bestTop = top;
            best = s.id;
          }
        });
        if (best) activate(best);
      },
      { rootMargin: "-100px 0px -55% 0px", threshold: 0 },
    );

    sections.forEach((s) => observer.observe(s.el));
  }

  setupTocScrollSpy();
  document.addEventListener("astro:after-swap", setupTocScrollSpy);
</script>

<style>
  @reference "../styles/global.css";

  [x-cloak] { display: none !important; }

  .docs-search {
    @apply flex items-center gap-2 h-9 px-3 border border-hairline rounded-md bg-surface text-text-3 text-[13px] mb-4;
  }
  .docs-code {
    @apply font-mono text-[13px] px-1.5 py-px rounded-sm bg-red-500/[0.08] text-red-500 border border-red-500/[0.18];
  }
  .docs-codeblock {
