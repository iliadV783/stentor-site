---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---
<Layout title="Sténtor Konto - Sténtor" description="Sténtor Konto für Lizenzen, Downloads und Aktivierungen." active={null} noindex={true}>
  <section class="max-w-[1180px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <div class="max-w-[760px] mb-10">
      <p class="font-mono text-xs tracking-[0.08em] uppercase text-stentor mb-4">Konto</p>
      <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Sténtor Konto.</h1>
      <p class="text-xl text-text-2 leading-[1.55] max-w-[720px]">Dieser Bereich bündelt Lizenzen, Downloads, Ablaufdaten und aktivierte Plätze für Theater, Kompanien, Festivals, Schulen und Institutionen.</p>
    </div>
    <div class="grid lg:grid-cols-[1fr_0.72fr] gap-5 items-start">
      <article class="rounded-2xl border border-hairline bg-surface p-6 md:p-7">
        <div class="flex items-start justify-between gap-4 border-b border-hairline pb-5 mb-5"><div><p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-4 mb-2">Lizenz</p><h2 class="text-2xl font-semibold tracking-[-0.04em]">Keine Lizenz verknüpft</h2></div><span class="rounded-full border border-hairline px-3 py-1 text-xs text-text-3">in Vorbereitung</span></div>
        <p class="text-text-3 leading-[1.6] mb-6">Nach der Aktivierung siehst du hier Plan, Ablaufdatum, Anzahl der Plätze und den Download-Link für Sténtor.</p>
        <Btn href="/de/testzugang" variant="primary" size="md">Pro anfragen</Btn>
      </article>
      <aside class="rounded-2xl border border-hairline bg-sunken p-6 md:p-7"><h2 class="text-xl font-semibold tracking-[-0.03em] mb-3">Du hast bereits eine Lizenz?</h2><p class="text-text-3 leading-[1.6] mb-6">Melde dich mit Google, Microsoft oder einem E-Mail-Link an. Das Konto wird mit der Lizenz deiner Organisation verbunden.</p><Btn href="/de/zugang" variant="ghost" size="md">Anmelden</Btn></aside>
    </div>
  </section>
</Layout>
