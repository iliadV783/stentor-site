---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---
<Layout title="Funktionen - Sténtor" description="Die wichtigsten Sténtor-Funktionen für Übertitel, Übersetzung, Audiodeskription und Publikum." active="features">
  <section class="max-w-[1180px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <div class="max-w-[760px] mb-10">
      <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-4">Funktionen</p>
      <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Aufführungstext, Ausgaben und Barrierefreiheit.</h1>
      <p class="text-xl text-text-2 leading-[1.55]">Sténtor organisiert die Arbeit vom Skript bis zur Live-Aufführung: Übertitel, Übersetzungen, Audiodeskriptionsnotizen, Bildschirme und Publikumstelefone.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      <article class="rounded-2xl border border-hairline bg-surface p-6"><h2 class="text-xl font-semibold mb-3">Vorbereitung</h2><p class="text-text-3 leading-[1.6]">Importiere und strukturiere Texte, Übersetzungen, Cues und Barrierefreiheitsmaterialien.</p></article>
      <article class="rounded-2xl border border-hairline bg-surface p-6"><h2 class="text-xl font-semibold mb-3">Live-Regie</h2><p class="text-text-3 leading-[1.6]">Bewege dich mit einer klaren Ansicht durch Proben und Vorstellungen.</p></article>
      <article class="rounded-2xl border border-hairline bg-surface p-6"><h2 class="text-xl font-semibold mb-3">Publikum</h2><p class="text-text-3 leading-[1.6]">Sende Text an Bildschirme und synchronisierte Telefone im Saal.</p></article>
    </div>
    <div class="mt-8"><Btn href="/de/download" variant="primary">Sténtor herunterladen</Btn></div>
  </section>
</Layout>