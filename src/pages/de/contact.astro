---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---
<Layout title="Kontakt - Sténtor" description="Kontaktiere Sténtor für Tests, Theater und Institutionen." active={null}>
  <section class="max-w-[960px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-stentor mb-4">Kontakt</p>
    <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Sprechen wir über Sténtor.</h1>
    <p class="text-xl text-text-2 leading-[1.55] max-w-[760px] mb-8">Für Tests, Theater, Festivals, Schulen und Institutionen kannst du den Beta-Zugang anfragen und deinen Nutzungskontext beschreiben.</p>
    <div class="flex flex-wrap gap-3">
      <Btn href="/de/testzugang" variant="primary" size="lg">Beta anfragen</Btn>
      <Btn href="/de/download" variant="ghost" size="lg">Downloads ansehen</Btn>
    </div>
  </section>
</Layout>
