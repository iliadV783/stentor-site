---
import Layout from "../../../layouts/Layout.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Btn from "../../../components/Btn.astro";
import FinalCta from "../../../components/FinalCta.astro";
import Hero from "../../../components/sections/features/Hero.astro";
import Showcase from "../../../components/sections/features/Showcase.astro";
import SecondaryBento from "../../../components/sections/features/SecondaryBento.astro";
import CodeTabs from "../../../components/sections/features/CodeTabs.astro";
import { hero, showcase, secondaryBento, codeTabs, finalCta } from "../../../data/features.fr";
---
<Layout
  title="Sténtor – Fonctionnalités"
  description="Fonctionnalités pour préparer, piloter et partager surtitres, traductions et audiodescriptions dans le spectacle vivant."
  active="features"
>
  <Hero hero={hero} />
  <Showcase showcase={showcase} />
  <SecondaryBento secondaryBento={secondaryBento} />
  <CodeTabs codeTabs={codeTabs} />

  <FinalCta>
    <Eyebrow><span class="font-mono">{finalCta.eyebrow}</span></Eyebrow>
    <h2 class="text-4xl sm:text-5xl lg:text-[56px] leading-[1.02] tracking-[-0.04em] font-semibold max-w-[820px]" set:html={finalCta.title}></h2>
    <p class="text-lg leading-[1.55] text-text-2 max-w-[640px]" set:html={finalCta.body}></p>
    <div class="flex flex-wrap gap-3 justify-center">
      {finalCta.ctas.map((cta, i) => (
        <Btn href={cta.href} variant={cta.variant} size="lg">
          {cta.label}{i === 0 && <span aria-hidden="true">→</span>}
        </Btn>
      ))}
    </div>
  </FinalCta>
</Layout>
