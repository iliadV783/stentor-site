---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Demander Stentor Pro - Stentor" description="Demandez une licence d essai Stentor Pro pour theatres, compagnies, festivals, ecoles et institutions." active={null} showNav={false} showFooter={false}>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.22)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] pointer-events-none" aria-hidden="true"></div>
    <header class="relative max-w-[1120px] mx-auto px-5 md:px-8 py-7 flex items-center justify-between">
      <a href="/fr/" class="inline-flex items-center gap-3 text-white hover:text-white/80 transition-colors"><span class="font-semibold tracking-[-0.04em] text-xl">STENTOR</span><span class="text-white/45 text-sm">Pro</span></a>
      <a href="/fr/" class="inline-flex items-center gap-2 text-sm text-white/55 hover:text-white transition-colors"><span aria-hidden="true">←</span> Retour au site</a>
    </header>
    <main class="relative max-w-[760px] mx-auto px-5 md:px-8 pt-10 pb-20">
      <div class="mb-10">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-4">Acces professionnel</p>
        <h1 class="text-5xl sm:text-6xl lg:text-[72px] leading-[0.96] tracking-[-0.06em] font-semibold max-w-[650px]">Demander Stentor Pro.</h1>
        <p class="text-white/55 text-lg leading-[1.55] mt-6 max-w-[580px]">Licences d essai et acces professionnels pour theatres, compagnies, festivals, ecoles et institutions qui souhaitent utiliser Stentor en production.</p>
        <p class="text-white/45 mt-4">Vous avez deja une licence ? <a href="/fr/acces" class="text-red-400 underline underline-offset-4 hover:text-red-300">Se connecter →</a></p>
      </div>
      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        <a href="#" class="auth-provider"><span class="provider-mark google-mark" aria-hidden="true">G</span> Continuer avec Google</a>
        <a href="#" class="auth-provider"><span class="provider-mark microsoft-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span> Continuer avec Microsoft</a>
      </div>
      <div class="flex items-center gap-4 my-7 text-white/35 font-mono text-[12px] uppercase tracking-[0.14em]"><span class="h-px bg-white/10 flex-1"></span> ou continuer par e-mail <span class="h-px bg-white/10 flex-1"></span></div>
      <div x-data="{ sent: false }" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm overflow-hidden shadow-2xl shadow-red-950/10">
        <div x-show="sent" x-cloak class="p-8 sm:p-10 text-center"><div class="mx-auto w-12 h-12 rounded-full bg-green-400/10 border border-green-400/25 flex items-center justify-center text-green-300 mb-5">✓</div><h2 class="text-2xl font-semibold tracking-[-0.03em] mb-3">Demande recue</h2><p class="text-white/55 leading-[1.6] max-w-[420px] mx-auto">Nous vous recontacterons pour preparer la licence, le telechargement et le nombre de postes adaptes a votre organisation.</p></div>
        <form x-show="!sent" x-on:submit.prevent="sent = true" class="p-6 sm:p-8 grid gap-5" novalidate>
          <div><label class="auth-label" for="name">Nom et prenom</label><input id="name" type="text" class="auth-input" placeholder="Ada Lovelace" autocomplete="name" /></div>
          <div><label class="auth-label" for="email">E-mail professionnel</label><input id="email" type="email" class="auth-input" placeholder="nom@theatre.fr" autocomplete="email" /></div>
          <div class="grid sm:grid-cols-2 gap-5"><div><label class="auth-label" for="organization">Organisation</label><input id="organization" type="text" class="auth-input" placeholder="Theatre, compagnie, festival" autocomplete="organization" /></div><div><label class="auth-label" for="role">Role</label><input id="role" type="text" class="auth-input" placeholder="Production, accessibilite" /></div></div>
          <div><label class="auth-label" for="message">Comment souhaitez-vous utiliser Stentor ?</label><textarea id="message" rows="4" class="auth-input auth-textarea" placeholder="Indiquez la production, la periode d essai et les postes souhaites."></textarea></div>
          <button type="submit" class="h-14 rounded-xl bg-red-500 text-black font-semibold text-[15px] shadow-[0_0_40px_rgba(239,68,68,0.18)] hover:bg-red-400 transition-colors">Demander l acces →</button>
        </form>
      </div>
    </main>
  </section>
</Layout>
<style>
  @reference "../../styles/global.css";
  .auth-provider { @apply h-14 rounded-xl border border-white/10 bg-white/[0.045] hover:bg-white/[0.075] hover:border-white/20 transition-colors inline-flex items-center justify-center gap-3 text-[15px] font-medium text-white/90; }
  .provider-mark { @apply w-5 h-5 flex-none inline-flex items-center justify-center; }
  .google-mark { font-weight: 700; color: #fff; }
  .microsoft-mark { display: grid; grid-template-columns: repeat(2, 8px); grid-template-rows: repeat(2, 8px); gap: 2px; }
  .microsoft-mark span { display: block; background: rgba(255,255,255,0.88); }
  .auth-label { @apply block text-[13px] font-medium text-white/62 mb-2; }
  .auth-input { @apply w-full h-12 rounded-xl border border-white/10 bg-black/30 text-white outline-none transition-all text-[15px]; padding: 0 16px; }
  .auth-input:focus { border-color: rgba(239, 68, 68, 0.55); box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12); }
  .auth-input::placeholder { color: rgba(255,255,255,0.34); }
  .auth-textarea { height: auto; padding-top: 14px; padding-bottom: 14px; resize: none; }
  [x-cloak] { display: none !important; }
</style>
