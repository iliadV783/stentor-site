---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---

<Layout title="Sténtor — Texte scénique multilingue" description="Surtitres, traduction et audiodescription pour le spectacle vivant." active={null}>
  <section class="max-w-[1120px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-5">Français · multilingue par conception</p>
    <h1 class="text-5xl md:text-[80px] tracking-[-0.065em] leading-[0.96] font-semibold max-w-[960px] mb-6">
      Surtitres, traduction et audiodescription. En direct.
    </h1>
    <p class="text-xl text-text-2 leading-[1.6] max-w-[800px] mb-8">
      Sténtor est un outil desktop-first pour le texte du spectacle vivant : préparer des projets multilingues, piloter les surtitres et les traductions, gérer l’audiodescription, envoyer le texte vers les écrans de salle et permettre aux téléphones du public de suivre sur un réseau local.
    </p>
    <div class="flex flex-wrap gap-3 mb-10">
      <Btn href="/download" variant="primary" size="lg">Télécharger Sténtor →</Btn>
      <Btn href="/docs" variant="ghost" size="lg">Lire le workflow</Btn>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-hairline bg-surface p-5"><h2 class="font-semibold mb-2">Projets multilingues</h2><p class="text-sm text-text-2 leading-[1.55]">Texte original, traductions, surtitres et langues du projet restent dans un même espace éditable.</p></div>
      <div class="rounded-2xl border border-hairline bg-surface p-5"><h2 class="font-semibold mb-2">Régie / Stage desk</h2><p class="text-sm text-text-2 leading-[1.55]">L’opérateur contrôle les cues, le noir, les écrans, les téléphones du public et l’état de l’audiodescription.</p></div>
      <div class="rounded-2xl border border-hairline bg-surface p-5"><h2 class="font-semibold mb-2">Écrans et téléphones</h2><p class="text-sm text-text-2 leading-[1.55]">Utilisez les écrans de salle, une page foyer avec QR code et les appareils personnels sur réseau local.</p></div>
    </div>
  </section>
</Layout>
