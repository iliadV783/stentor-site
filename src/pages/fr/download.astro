---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---

<Layout title="Download Stentor - Stentor" description="Telechargez Stentor Lite ou demandez l acces a Stentor Pro pour macOS." active={null}>
  <section class="max-w-[980px] mx-auto px-4 md:px-8 py-24">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-4">Download</p>
    <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Telecharger Stentor.</h1>
    <p class="text-xl text-text-2 leading-[1.55] max-w-[720px] mb-8">Stentor Lite sera disponible librement. Stentor Pro sera distribue avec une licence professionnelle pour theatres, compagnies, festivals, ecoles et institutions.</p>
    <div class="grid md:grid-cols-2 gap-4">
      <article class="rounded-2xl border border-hairline bg-surface p-6"><p class="font-mono text-xs text-text-3 mb-3">Gratuit</p><h2 class="text-2xl font-semibold mb-2">Stentor Lite</h2><p class="text-text-3 mb-5">Telechargement en preparation.</p><button class="inline-flex items-center justify-center h-10 px-4 rounded-lg border border-hairline text-text-3 text-sm cursor-not-allowed" disabled>En preparation</button></article>
      <article class="rounded-2xl border border-red-500/25 bg-surface p-6"><p class="font-mono text-xs text-red-500 mb-3">Licence professionnelle</p><h2 class="text-2xl font-semibold mb-2">Stentor Pro</h2><p class="text-text-3 mb-5">Pour surtitres, traduction, audiodescription et diffusion vers ecrans ou telephones du public.</p><Btn href="/fr/demander-essai" variant="primary">Demander Pro <span aria-hidden="true">→</span></Btn></article>
    </div>
  </section>
</Layout>
