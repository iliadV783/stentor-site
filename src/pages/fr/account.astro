---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---

<Layout title="Compte Stentor - Stentor" description="Compte Stentor pour licences, telechargements et activations." active={null} noindex={true}>
  <section class="max-w-[1180px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <div class="max-w-[760px] mb-10">
      <p class="font-mono text-xs tracking-[0.08em] uppercase text-stentor mb-4">Compte</p>
      <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Compte Stentor.</h1>
      <p class="text-xl text-text-2 leading-[1.55] max-w-[720px]">Cet espace accueillera licences, telechargements, echeances et postes actives pour theatres, compagnies, festivals, ecoles et institutions.</p>
    </div>
    <div class="grid lg:grid-cols-[1fr_0.72fr] gap-5 items-start">
      <article class="rounded-2xl border border-hairline bg-surface p-6 md:p-7">
        <div class="flex items-start justify-between gap-4 border-b border-hairline pb-5 mb-5"><div><p class="font-mono text-[12px] uppercase tracking-[0.12em] text-text-4 mb-2">Licence</p><h2 class="text-2xl font-semibold tracking-[-0.04em]">Aucune licence associee</h2></div><span class="rounded-full border border-hairline px-3 py-1 text-xs text-text-3">en preparation</span></div>
        <p class="text-text-3 leading-[1.6] mb-6">Apres activation, vous verrez ici le plan, l echeance, le nombre de postes et le lien de telechargement de Sténtor.</p>
        <Btn href="/fr/demander-essai" variant="primary" size="md">Demander Pro</Btn>
      </article>
      <aside class="rounded-2xl border border-hairline bg-sunken p-6 md:p-7"><h2 class="text-xl font-semibold tracking-[-0.03em] mb-3">Vous avez deja une licence ?</h2><p class="text-text-3 leading-[1.6] mb-6">Connectez-vous avec Google, Microsoft ou un lien e-mail. Le compte sera associe a la licence de votre organisation.</p><Btn href="/fr/acces" variant="ghost" size="md">Se connecter</Btn></aside>
    </div>
  </section>
</Layout>
