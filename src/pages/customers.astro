---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Btn from "../components/Btn.astro";
import FinalCta from "../components/FinalCta.astro";
import IllusHelio from "../assets/illustrations/customer-helio.svg";
import IllusConstellate from "../assets/illustrations/customer-constellate.svg";
import IllusVector from "../assets/illustrations/customer-vector.svg";
import IllusKettlebrook from "../assets/illustrations/customer-kettlebrook.svg";
import IllusOrbital from "../assets/illustrations/customer-orbital.svg";
import IllusTessera from "../assets/illustrations/customer-tessera.svg";
import {
  hero,
  featured,
  filters,
  filterCount,
  cards,
  logoWall,
  stats,
  quotes,
  finalCta,
} from "../data/customers";

const illustrationMap = {
  helio: IllusHelio,
  constellate: IllusConstellate,
  vector: IllusVector,
  kettlebrook: IllusKettlebrook,
  orbital: IllusOrbital,
  tessera: IllusTessera,
} as const;
---
<Layout
  title="Customers — Lambda"
  description="How 10,000+ teams — from Series A startups to Fortune 500s — ship faster on Lambda. Read their stories, numbers, and architecture decisions."
  active="customers"
>
  <!-- Header -->
  <section class="relative overflow-hidden border-b border-hairline pt-24 pb-16">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.35)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] [mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="max-w-[760px]">
        <Eyebrow><span class="font-mono">{hero.eyebrow}</span></Eyebrow>
        <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.02] tracking-[-0.04em] font-semibold mt-5 mb-4" set:html={hero.title}></h1>
        <p class="text-lg leading-[1.55] text-text-2 max-w-[560px]">{hero.description}</p>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="py-16">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8">
      <article class="border border-hairline rounded-xl bg-surface overflow-hidden mb-6 grid grid-cols-1 lg:[grid-template-columns:1.1fr_1fr]">
        <div class="p-8 lg:p-12 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2.5 text-lg tracking-[-0.02em] font-medium">
            <div class="grid place-items-center w-7 h-7 rounded-md bg-gradient-to-br from-red-500 to-red-700 text-bg font-mono font-semibold text-sm">{featured.brand.initial}</div>
            {featured.brand.name}
          </div>
          <h2 class="text-3xl md:text-4xl leading-[1.12] tracking-[-0.03em] font-semibold" set:html={featured.title}></h2>
          <p class="text-[16px] leading-[1.6] text-text-2 max-w-[460px]">{featured.description}</p>
          <div class="grid grid-cols-3 gap-6 my-3 py-5 border-y border-hairline">
            {featured.stats.map((s) => (
              <div>
                <div class="text-[28px] tracking-[-0.03em] font-semibold text-red-500 leading-none">{s.value}</div>
                <div class="text-sm text-text-3 mt-1.5 leading-[1.4]">{s.label}</div>
              </div>
            ))}
          </div>
          <a href={featured.link.href} class="inline-flex items-center gap-2 text-red-500 text-sm font-medium hover:underline">{featured.link.label} <span aria-hidden="true">→</span></a>
        </div>
        <div class="relative bg-deep border-t lg:border-t-0 lg:border-l border-hairline overflow-hidden p-8 lg:p-0 flex flex-col gap-8 justify-between lg:min-h-[540px]" style="background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(239,68,68,0.18), transparent 70%), var(--color-deep);">
          <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:40px_40px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
          <div class="relative grid gap-2.5 z-10 lg:absolute lg:top-10 lg:left-10 lg:right-10">
            {featured.hudRows.map((r) => (
              <div class:list={["hud-row", !r.emphasized && "opacity-55"]}>
                <span>{r.method}</span>
                <span>{r.emphasized ? <b class="text-text font-medium">{r.path}</b> : r.path}</span>
                <span class="text-red-500 text-[12px] text-right">{r.lat}</span>
              </div>
            ))}
          </div>
          <blockquote class="relative z-10 text-lg leading-[1.5] text-zinc-200 border-l-2 border-red-500 py-1 pl-4 lg:absolute lg:left-10 lg:right-10 lg:bottom-10">
            {featured.pullQuote.text}
            <span class="block mt-2.5 text-sm text-text-3"><b class="text-text-2 font-medium">{featured.pullQuote.author}</b> · {featured.pullQuote.role}</span>
          </blockquote>
        </div>
      </article>

      <!-- Filter -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-14 mb-6" x-data="{f:'All'}">
        <div class="flex flex-wrap gap-1">
          {filters.map((label) => (
            <button
              @click={`f='${label}'`}
              :class={`f==='${label}' ? 'bg-red-500/[0.08] border-red-500/25 text-red-500' : 'border-hairline text-text-2 hover:text-text'`}
              class="h-8 px-3 rounded-md border text-sm transition-colors"
            >{label}</button>
          ))}
        </div>
        <span class="font-mono text-xs text-text-3">Showing {filterCount.showing} of {filterCount.total} stories</span>
      </div>

      <!-- Grid -->
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3 mb-24">
        {cards.map((card) => {
          const Illus = illustrationMap[card.illustration];
          return (
            <article class="cu-card">
              <div class="aspect-[16/9] relative border-b border-hairline overflow-hidden">
                <Illus class="w-full h-full" style={`background: radial-gradient(ellipse at 50% 60%, ${card.tint}, var(--color-deep) 70%);`} />
              </div>
              <div class="cu-card__body">
                <div class="cu-card__head">
                  <div class:list={["w-6 h-6 bg-zinc-300", card.glyph]}></div>
                  <b class="text-sm">{card.brand}</b>
                  <span class="tag ml-auto">{card.industry}</span>
                </div>
                <h3 class="text-lg leading-[1.25] tracking-[-0.02em] font-semibold">{card.title}</h3>
                <p class="text-[13.5px] leading-[1.55] text-text-2 m-0">{card.description}</p>
                <div class="cu-card__stats">
                  {card.stats.map((s) => (
                    <div><div class="k">{s.k}</div><div class="l">{s.l}</div></div>
                  ))}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Logo wall -->
  <section class="border-y border-hairline py-14 bg-bg/40">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-[28px] tracking-[-0.025em] font-semibold">{logoWall.title}</h2>
        <p class="text-sm text-text-3 mt-2">{logoWall.description}</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 border border-hairline rounded-xl overflow-hidden">
        {logoWall.logos.map((l, i) => (
          <div class:list={[
            "h-[88px] grid place-items-center text-zinc-300 text-base lg:text-[17px] tracking-[-0.02em] font-medium opacity-70 border-hairline",
            (i + 1) % 6 !== 0 && "lg:border-r",
            (i + 1) % 3 !== 0 && "md:border-r lg:border-r",
            (i + 1) % 2 !== 0 && "border-r md:border-r-0 lg:border-r",
            i < 6 && "lg:border-b",
            i < 9 && "md:border-b",
            i < 10 && "border-b",
          ]}>
            <span class:list={["w-[18px] h-[18px] mr-2 inline-block bg-zinc-300", l.glyph]}></span>{l.name}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- By the numbers -->
  <section class="py-24">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:[grid-template-columns:1.4fr_1fr_1fr_1fr] border border-hairline rounded-xl bg-surface overflow-hidden">
        <div class="px-8 py-9 lg:px-10 bg-gradient-to-b from-red-500/[0.05] to-transparent border-b md:border-b-0 md:border-r border-hairline flex flex-col justify-center gap-2.5">
          <h3 class="text-2xl tracking-[-0.025em] font-semibold max-w-[280px] leading-[1.2]">{stats.title}</h3>
          <p class="text-sm text-text-3 m-0 max-w-[320px] leading-[1.5]">{stats.description}</p>
        </div>
        {stats.items.map((s, i) => (
          <div class:list={[
            "px-7 py-8 flex flex-col justify-center",
            i < stats.items.length - 1 && "border-b md:border-b-0 md:border-r border-hairline",
          ]}>
            <div class="text-4xl tracking-[-0.035em] font-semibold leading-none">{s.value}<em class="not-italic text-red-500 text-2xl font-medium">{s.suffix}</em></div>
            <div class="text-sm text-text-2 mt-2.5 leading-[1.4]">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quotes -->
  <section class="py-16">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3 mb-24">
        {quotes.map((q) => (
          <div class="border border-hairline rounded-xl bg-surface p-7 flex flex-col gap-5">
            <span class="text-red-500 tracking-[2px]">{"★".repeat(q.stars)}</span>
            <p class="m-0 leading-[1.55] text-zinc-200 before:content-['“'] before:text-red-500 before:mr-0.5 after:content-['”'] after:text-red-500 after:ml-0.5">{q.text}</p>
            <div class="flex items-center gap-3 mt-auto pt-3.5 border-t border-dashed border-hairline">
              <div class="w-9 h-9 rounded-full border border-hairline-strong grid place-items-center font-mono text-xs text-text-2 bg-gradient-to-br from-raised to-sunken">{q.av}</div>
              <div>
                <b class="block font-medium text-[13.5px]">{q.name}</b>
                <span class="block text-xs text-text-3">{q.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FinalCta variant={finalCta.variant}>
    <h2 class="text-4xl sm:text-5xl tracking-[-0.035em] font-semibold leading-[1.1] max-w-[680px]">{finalCta.title}</h2>
    <p class="text-lg leading-[1.55] text-text-2 max-w-[560px]">{finalCta.body}</p>
    <div class="flex flex-wrap gap-3 justify-center">
      {finalCta.ctas.map((cta, i) => (
        <Btn href={cta.href} variant={cta.variant} size="lg">
          {cta.label}{i === 0 && <span aria-hidden="true">→</span>}
        </Btn>
      ))}
    </div>
  </FinalCta>
</Layout>

<style>
  @reference "../styles/global.css";

  .hud-row {
    @apply grid [grid-template-columns:40px_1fr_auto] gap-3 items-center px-3.5 py-2.5 border border-hairline rounded-lg bg-bg/70 backdrop-blur-md font-mono text-xs text-text-2;
  }
  .cu-card {
    @apply border border-hairline rounded-xl bg-surface overflow-hidden flex flex-col transition-colors hover:border-hairline-strong;
  }
  .cu-card__body {
    @apply px-6 py-5 flex flex-col gap-3 flex-1;
  }
  .cu-card__head {
    @apply flex items-center gap-2.5;
  }
  .cu-card__stats {
    @apply grid grid-cols-2 gap-4 pt-4 mt-auto border-t border-dashed border-hairline font-mono text-[12px];
  }
  .cu-card__stats .k {
    @apply text-red-500 text-lg tracking-[-0.02em] font-semibold;
  }
  .cu-card__stats .l {
    @apply text-text-3 mt-1 text-[12px];
  }
  .tag {
    @apply inline-flex items-center gap-1.5 font-mono text-[12px] px-2 py-0.5 rounded-sm bg-white/5 text-text-2 border border-hairline;
  }
</style>
