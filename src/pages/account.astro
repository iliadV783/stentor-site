---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Account Sténtor - Sténtor" description="Access your Sténtor account, downloads and access code." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.18)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_66%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_66%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[620px] h-[620px] rounded-full bg-red-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <header class="relative border-b border-white/10">
      <div class="max-w-[1180px] mx-auto px-5 md:px-8 h-20 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-3 text-white hover:text-white/80 transition-colors"><span class="font-semibold tracking-[-0.04em] text-xl">Sténtor</span><span class="text-white/55 text-sm" data-i18n="nav.account">Account</span></a>
        <div class="flex items-center gap-3"><button data-account-logout hidden class="inline-flex items-center justify-center h-10 px-4 rounded-xl border border-red-400/30 bg-red-500/10 text-sm text-red-100 hover:text-white hover:bg-red-500/15 transition-colors" data-i18n="action.logout">Logout</button>
        <a href="/" class="inline-flex items-center justify-center h-10 px-4 rounded-xl border border-white/12 text-sm text-white/70 hover:text-white hover:bg-white/[0.06] transition-colors" data-i18n="action.backToSite">Back to site</a></div>
      </div>
    </header>

    <main class="relative max-w-[1180px] mx-auto px-5 md:px-8 py-12 md:py-16">
      <section data-account-login class="max-w-[760px] mx-auto rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-7 md:p-8">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-3" data-i18n="accessCode">Access code</p>
        <h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4" data-i18n="login.title">Sign in to Sténtor.</h1>
        <p class="text-white/58 leading-[1.65] mb-7" data-i18n="login.subtitle">Use your email, Google, Apple or Microsoft account to access downloads, activation details and your Sténtor access code.</p>

        <div class="grid sm:grid-cols-3 gap-3 mb-6">
          <button type="button" data-account-oauth="google" class="account-provider"><img src="/brand/google.svg" alt="" class="provider-logo" /> <span data-i18n="login.google">Continue with Google</span></button>
          <button type="button" data-account-oauth="apple" class="account-provider"><span class="provider-logo provider-logo-apple" aria-hidden="true"></span> <span data-i18n="login.apple">Continue with Apple</span></button>
          <button type="button" data-account-oauth="azure" class="account-provider"><img src="/brand/microsoft.svg" alt="" class="provider-logo" /> <span data-i18n="login.microsoft">Continue with Microsoft</span></button>
        </div>
        <div class="flex items-center gap-4 my-6 text-white/42 font-mono text-[12px] uppercase tracking-[0.12em]"><span class="h-px bg-white/10 flex-1"></span><span data-i18n="login.orEmail">or email</span><span class="h-px bg-white/10 flex-1"></span></div>

        <form data-account-login-form class="grid gap-4">
          <input name="email" type="email" autocomplete="email" placeholder="name@theatre.org" class="account-input" required />
          <input name="password" type="password" autocomplete="current-password" placeholder="Password" data-i18n-placeholder="login.password" class="account-input" />
          <button type="submit" class="h-12 rounded-xl bg-red-500 text-black font-semibold hover:bg-red-400 transition-colors" data-i18n="action.signIn">Sign in</button>
          <button type="button" data-account-magic-link class="h-12 rounded-xl border border-white/10 text-white/70 hover:text-white hover:bg-white/[0.06] transition-colors" data-i18n="action.magicLink">Send email link</button>
        </form>
        <p class="mt-5 text-sm text-white/45 leading-[1.5]"><span data-i18n="login.noAccount">No account yet?</span> <a href="/request-pro" class="text-red-300 underline underline-offset-4 hover:text-red-200" data-i18n="login.requestBeta">Request free beta access</a>.</p>
        <p data-account-error hidden class="mt-5 rounded-xl border border-red-500/30 bg-red-500/10 text-red-200 text-sm leading-[1.5] p-4"></p>
      </section>

      <section data-account-app hidden class="grid gap-6">
        <div class="account-hero">
          <div class="relative z-10">
            <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-4" data-i18n="accessCode">Access code</p>
            <h1 class="text-4xl md:text-6xl tracking-[-0.06em] leading-[0.98] font-semibold mb-5" data-i18n="app.title">Your Sténtor account.</h1>
            <p class="text-white/64 text-lg leading-[1.6] max-w-[760px]" data-i18n="app.subtitle">This area shows your Sténtor access code, enabled platforms, available downloads and the projects synced to the cloud.</p>
          </div>
          <div class="account-hero-mark" aria-hidden="true"><span>S</span></div>
        </div>

        <div class="grid lg:grid-cols-[1fr_0.58fr] gap-6 items-start">
          <section class="account-panel">
            <div class="flex items-start justify-between gap-4 mb-6">
              <div>
                <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-white/45 mb-2" data-i18n="section.access">Access</p>
                <h2 class="text-[28px] leading-tight font-semibold tracking-[-0.045em]" data-i18n="accessCodes.title">Access codes</h2>
                <p class="text-white/56 leading-[1.55] mt-2" data-i18n="accessCodes.subtitle">Manage your access codes and monitor active devices.</p>
              </div>
              <button data-account-refresh class="h-10 px-4 rounded-xl border border-white/12 text-sm text-white/70 hover:text-white hover:bg-white/[0.06] transition-colors" data-i18n="action.refresh">Refresh</button>
            </div>
            <div data-account-licenses class="grid gap-3"><p class="text-white/52" data-i18n="loading.accessCode">Loading access code...</p></div>
          </section>

          <aside class="grid gap-4">
            <section class="account-panel account-panel-compact">
              <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-white/45 mb-2" data-i18n="summary.eyebrow">Summary</p>
              <h2 class="text-2xl font-semibold tracking-[-0.04em] mb-4" data-i18n="summary.title">Account status</h2>
              <div data-account-summary class="account-summary-list"><span data-i18n="loading.accountSummary">Loading account summary...</span></div>
            </section>

            <section class="account-panel account-panel-compact">
              <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-white/45 mb-2" data-i18n="section.downloads">Downloads</p>
              <h2 class="text-2xl font-semibold tracking-[-0.04em] mb-3" data-i18n="downloads.title">Available builds</h2>
              <p class="text-white/58 leading-[1.6] mb-5" data-i18n="downloads.subtitle">Downloads appear here when a Sténtor build is available for your account.</p>
              <div data-account-downloads class="grid gap-2"><span class="download-chip" data-i18n="loading.downloads">Loading downloads...</span></div>
            </section>

            <section class="account-panel account-panel-compact">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                <div>
                  <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-white/45 mb-2" data-i18n="section.cloud">Cloud</p>
                  <h2 class="text-2xl font-semibold tracking-[-0.04em]" data-i18n="cloud.title">Cloud projects</h2>
                </div>
                <div data-account-cloud-summary class="cloud-summary"><span data-i18n="loading.cloudSummary">Loading cloud summary...</span></div>
              </div>
              <div data-account-cloud-projects class="grid gap-3"><p class="text-white/52" data-i18n="loading.cloudProjects">Loading cloud projects...</p></div>
            </section>
          </aside>
        </div>
      </section>
    </main>
  </section>
</Layout>

