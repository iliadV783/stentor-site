---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Account Sténtor - Sténtor" description="Access your Sténtor account, downloads and access code." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.18)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_66%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_66%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[620px] h-[620px] rounded-full bg-red-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <header class="relative border-b border-white/10">
      <div class="max-w-[1180px] mx-auto px-5 md:px-8 h-20 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-3 text-white hover:text-white/80 transition-colors"><span class="font-semibold tracking-[-0.04em] text-xl">Sténtor</span><span class="text-white/45 text-sm">Account</span></a>
        <div class="flex items-center gap-3"><button data-account-logout hidden class="inline-flex items-center justify-center h-10 px-4 rounded-xl border border-white/10 text-sm text-white/65 hover:text-white hover:bg-white/[0.06] transition-colors">Logout</button>
        <a href="/" class="inline-flex items-center justify-center h-10 px-4 rounded-xl border border-white/10 text-sm text-white/65 hover:text-white hover:bg-white/[0.06] transition-colors">Back to site</a></div>
      </div>
    </header>

    <main class="relative max-w-[1180px] mx-auto px-5 md:px-8 py-12 md:py-16">
      <section data-account-login class="max-w-[760px] mx-auto rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-7 md:p-8">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-3">Access code</p>
        <h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4">Sign in to Sténtor.</h1>
        <p class="text-white/50 leading-[1.6] mb-7">Use your email, Google, Apple or Microsoft account to access downloads, activation details and your Sténtor access code.</p>

        <div class="grid sm:grid-cols-3 gap-3 mb-6">
          <button type="button" data-account-oauth="google" class="account-provider"><img src="/brand/google.svg" alt="" class="provider-logo" /> Continue with Google</button>
          <button type="button" data-account-oauth="apple" class="account-provider"><span class="provider-logo provider-logo-apple" aria-hidden="true"></span> Continue with Apple</button>
          <button type="button" data-account-oauth="azure" class="account-provider"><img src="/brand/microsoft.svg" alt="" class="provider-logo" /> Continue with Microsoft</button>
        </div>
        <div class="flex items-center gap-4 my-6 text-white/35 font-mono text-[12px] uppercase tracking-[0.14em]"><span class="h-px bg-white/10 flex-1"></span> or email <span class="h-px bg-white/10 flex-1"></span></div>

        <form data-account-login-form class="grid gap-4">
          <input name="email" type="email" autocomplete="email" placeholder="name@theatre.org" class="account-input" required />
          <input name="password" type="password" autocomplete="current-password" placeholder="Password" class="account-input" />
          <button type="submit" class="h-12 rounded-xl bg-red-500 text-black font-semibold hover:bg-red-400 transition-colors">Sign in</button>
          <button type="button" data-account-magic-link class="h-12 rounded-xl border border-white/10 text-white/65 hover:text-white hover:bg-white/[0.06] transition-colors">Send email link</button>
        </form>
        <p class="mt-5 text-sm text-white/38 leading-[1.5]">No account yet? <a href="/request-pro" class="text-red-300 underline underline-offset-4 hover:text-red-200">Request free beta access</a>.</p>
        <p data-account-error hidden class="mt-5 rounded-xl border border-red-500/30 bg-red-500/10 text-red-200 text-sm leading-[1.5] p-4"></p>
      </section>

      <section data-account-app hidden class="grid gap-6">
        <div class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7">
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-3">Access code</p>
          <h1 class="text-4xl md:text-6xl tracking-[-0.06em] leading-[0.98] font-semibold mb-4">Your Sténtor account.</h1>
          <p class="text-white/50 leading-[1.6] max-w-[760px]">This area shows your Sténtor access code, enabled platforms, available downloads and the projects synced to the cloud.</p>
        </div>

        <div class="grid lg:grid-cols-[1fr_0.72fr] gap-6 items-start">
          <section class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7">
            <div class="flex items-start justify-between gap-4 mb-6">
              <div><p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-2">Access</p><h2 class="text-2xl font-semibold tracking-[-0.04em]">Access code</h2></div>
              <button data-account-refresh class="h-10 px-4 rounded-xl border border-white/10 text-sm text-white/55 hover:text-white hover:bg-white/[0.06] transition-colors">Refresh</button>
            </div>
            <div data-account-licenses class="grid gap-3"><p class="text-white/45">Loading access code...</p></div>
          </section>

          <aside class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7">
            <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-3">Downloads</p>
            <h2 class="text-2xl font-semibold tracking-[-0.04em] mb-4">Available builds</h2>
            <p class="text-white/50 leading-[1.6] mb-5">Downloads appear here when a Sténtor build is available for your account.</p>
            <div data-account-downloads class="grid gap-2"><span class="download-chip">Loading downloads...</span></div>
          </aside>
        </div>

        <section class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-6 md:p-7">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
            <div>
              <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-white/35 mb-2">Cloud</p>
              <h2 class="text-2xl font-semibold tracking-[-0.04em]">Cloud projects</h2>
              <p class="text-white/50 leading-[1.6] mt-2 max-w-[720px]">A compact summary of the Sténtor projects available in your cloud workspace and their latest synchronization state.</p>
            </div>
            <div data-account-cloud-summary class="cloud-summary"><span>Loading cloud summary...</span></div>
          </div>
          <div data-account-cloud-projects class="grid gap-3"><p class="text-white/45">Loading cloud projects...</p></div>
        </section>
      </section>
    </main>
  </section>
</Layout>

<script>
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const storageKey = 'stentor_account_access_token';

  const loginPanel = document.querySelector('[data-account-login]');
  const appPanel = document.querySelector('[data-account-app]');
  const loginForm = document.querySelector('[data-account-login-form]');
  const errorBox = document.querySelector('[data-account-error]');
  const logoutButton = document.querySelector('[data-account-logout]');
  const magicButton = document.querySelector('[data-account-magic-link]');
  const refreshButton = document.querySelector('[data-account-refresh]');
  const licensesTarget = document.querySelector('[data-account-licenses]');
  const downloadsTarget = document.querySelector('[data-account-downloads]');
  const cloudSummaryTarget = document.querySelector('[data-account-cloud-summary]');
  const cloudProjectsTarget = document.querySelector('[data-account-cloud-projects]');

  function showLogin() {
    if (loginPanel) loginPanel.hidden = false;
    if (appPanel) appPanel.hidden = true;
    if (logoutButton) logoutButton.hidden = true;
  }

  function showApp() {
    if (loginPanel) loginPanel.hidden = true;
    if (appPanel) appPanel.hidden = false;
    if (logoutButton) logoutButton.hidden = false;
  }

  function getTokenFromHash() {
    const hash = new URLSearchParams(window.location.hash.replace(/^#/, ''));
    const token = hash.get('access_token');
    const error = hash.get('error_description') || hash.get('error');
    if (token) {
      localStorage.setItem(storageKey, token);
      history.replaceState(null, '', window.location.pathname);
    } else if (error) {
      showError(error);
      history.replaceState(null, '', window.location.pathname);
    }
    return token;
  }

  function getStoredToken() {
    return getTokenFromHash() || localStorage.getItem(storageKey) || '';
  }

  async function readError(response, fallback) {
    try {
      const body = await response.json();
      return body.msg || body.message || body.error_description || body.error || fallback;
    } catch {
      return fallback;
    }
  }

  function showError(message) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  function ensureConfig() {
    if (!supabaseUrl || !supabaseAnonKey) {
      throw new Error('Account access is not configured yet. Check Supabase public environment variables.');
    }
  }

  function startOAuth(provider) {
    ensureConfig();
    const redirectTo = `${window.location.origin}/auth/confirm?next=/account`;
    const url = new URL(`${supabaseUrl}/auth/v1/authorize`);
    url.searchParams.set('provider', provider);
    url.searchParams.set('redirect_to', redirectTo);
    window.location.assign(url.toString());
  }

  async function apiFetch(path, token, options = {}) {
    ensureConfig();
    const response = await fetch(`${supabaseUrl}${path}`, {
      ...options,
      headers: {
        apikey: supabaseAnonKey,
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
        ...(options.headers || {}),
      },
    });
    if (!response.ok) throw new Error(await readError(response, 'Request failed.'));
    return response.json();
  }

  async function signInWithPassword(email, password) {
    ensureConfig();
    const response = await fetch(`${supabaseUrl}/auth/v1/token?grant_type=password`, {
      method: 'POST',
      headers: { apikey: supabaseAnonKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    if (!response.ok) throw new Error(await readError(response, 'Login failed.'));
    const body = await response.json();
    localStorage.setItem(storageKey, body.access_token);
    return body.access_token;
  }

  async function sendMagicLink(email) {
    ensureConfig();
    const redirectTo = `${window.location.origin}/auth/confirm?next=/account`;
    const response = await fetch(`${supabaseUrl}/auth/v1/otp?redirect_to=${encodeURIComponent(redirectTo)}`, {
      method: 'POST',
      headers: { apikey: supabaseAnonKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, create_user: true }),
    });
    if (!response.ok) throw new Error(await readError(response, 'Email link could not be sent.'));
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (character) => {
      if (character === '&') return '&amp;';
      if (character === '<') return '&lt;';
      if (character === '>') return '&gt;';
      if (character === '"') return '&quot;';
      return '&#39;';
    });
  }

  function statusClass(status) {
    if (status === 'active') return 'account-status-active';
    if (status === 'revoked') return 'account-status-revoked';
    return 'account-status-pending';
  }

  function syncStatusClass(status) {
    if (status === 'synced') return 'cloud-status-synced';
    if (status === 'conflict') return 'cloud-status-conflict';
    if (status === 'local_changes' || status === 'remote_changes') return 'cloud-status-pending';
    return 'cloud-status-muted';
  }

  function syncStatusLabel(status) {
    if (status === 'synced') return 'Synced';
    if (status === 'local_changes') return 'Local changes';
    if (status === 'remote_changes') return 'Remote changes';
    if (status === 'conflict') return 'Conflict';
    if (status === 'archived') return 'Archived';
    return status || 'Unknown';
  }

  function formatBytes(bytes) {
    const value = Number(bytes || 0);
    if (!Number.isFinite(value) || value <= 0) return '—';
    const units = ['B', 'KB', 'MB', 'GB'];
    let amount = value;
    let unitIndex = 0;
    while (amount >= 1024 && unitIndex < units.length - 1) {
      amount /= 1024;
      unitIndex += 1;
    }
    return `${amount.toFixed(unitIndex === 0 ? 0 : 1)} ${units[unitIndex]}`;
  }

  function formatDate(value) {
    if (!value) return 'Never';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return 'Unknown';
    return date.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
  }

  function productLabel() {
    return 'Sténtor';
  }

  function platformLabel(platform) {
    if (platform === 'macos') return 'macOS';
    if (platform === 'windows') return 'Windows';
    if (platform === 'linux') return 'Linux';
    return platform;
  }

  function renderLicenses(licenses) {
    if (!licensesTarget) return;
    if (!licenses.length) {
      licensesTarget.innerHTML = '<div class="account-card"><h3 class="text-xl font-semibold tracking-[-0.03em] mb-2">No access code yet</h3><p class="text-white/50 leading-[1.6]">When your Sténtor account is enabled, your access code will appear here automatically.</p><a href="/account" class="inline-flex mt-5 h-11 px-4 rounded-xl bg-red-500 text-black font-semibold items-center justify-center hover:bg-red-400 transition-colors">Refresh account</a></div>';
      return;
    }

    licensesTarget.innerHTML = licenses.map((license) => {
      const platforms = (license.enabled_platforms || []).join(', ') || '—';
      const expires = license.expires_at ? new Date(license.expires_at).toLocaleDateString() : 'No expiration';
      return `<article class="account-card">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-5">
          <div><span class="account-label">Access code</span><div class="account-access-code">${license.license_key}</div></div>
          <button type="button" class="account-copy" data-copy-access-code="${license.license_key}">Copy</button>
        </div>
        <div class="grid sm:grid-cols-3 gap-3">
          <div><span class="account-label">Status</span><span class="${statusClass(license.status)}">${license.status}</span></div>
          <div><span class="account-label">Access</span><div class="text-white/70">${license.plan}</div></div>
          <div><span class="account-label">Devices</span><div class="text-white/70">${license.max_activations}</div></div>
          <div><span class="account-label">Platforms</span><div class="text-white/70">${platforms}</div></div>
          <div><span class="account-label">Expires</span><div class="text-white/70">${expires}</div></div>
          <div><span class="account-label">Organization</span><div class="text-white/70">${license.organization_name || '—'}</div></div>
        </div>
      </article>`;
    }).join('');
  }

  function renderDownloads(downloads) {
    if (!downloadsTarget) return;
    if (!downloads.length) {
      downloadsTarget.innerHTML = '<div class="download-card"><strong>No builds yet</strong><span>Downloads will appear here after the first build artifact is configured.</span></div>';
      return;
    }

    downloadsTarget.innerHTML = downloads.map((item) => {
      const title = `${productLabel(item.product)} ${platformLabel(item.platform)}`;
      const subtitle = `${item.channel} · v${item.version}`;
      if (item.is_available && item.file_url) {
        return `<a class="download-card download-card-active" href="${item.file_url}" target="_blank" rel="noreferrer"><strong>${title}</strong><span>${subtitle}</span><em>Download →</em></a>`;
      }
      return `<div class="download-card"><strong>${title}</strong><span>${subtitle}</span><em>Coming soon</em></div>`;
    }).join('');
  }

  function renderCloudProjects(projects, unavailable = false) {
    if (!cloudSummaryTarget || !cloudProjectsTarget) return;

    if (unavailable) {
      cloudSummaryTarget.innerHTML = '<span>Cloud index not configured</span>';
      cloudProjectsTarget.innerHTML = '<div class="account-card"><h3 class="text-xl font-semibold tracking-[-0.03em] mb-2">Cloud projects unavailable</h3><p class="text-white/50 leading-[1.6]">Apply the cloud projects migration in Supabase to enable this account summary.</p></div>';
      return;
    }

    if (!projects.length) {
      cloudSummaryTarget.innerHTML = '<span>0 projects</span>';
      cloudProjectsTarget.innerHTML = '<div class="account-card"><h3 class="text-xl font-semibold tracking-[-0.03em] mb-2">No cloud projects yet</h3><p class="text-white/50 leading-[1.6]">Projects will appear here after Sténtor uploads their cloud manifest.</p></div>';
      return;
    }

    const totalBytes = projects.reduce((sum, project) => sum + Number(project.size_bytes || 0), 0);
    const syncedCount = projects.filter((project) => project.sync_status === 'synced').length;
    const conflictCount = projects.filter((project) => project.sync_status === 'conflict').length;

    cloudSummaryTarget.innerHTML = `
      <span><strong>${projects.length}</strong> projects</span>
      <span><strong>${formatBytes(totalBytes)}</strong> used</span>
      <span><strong>${syncedCount}</strong> synced</span>
      ${conflictCount ? `<span class="text-red-200"><strong>${conflictCount}</strong> conflicts</span>` : ''}
    `;

    cloudProjectsTarget.innerHTML = projects.map((project) => {
      const cueCount = Number(project.cue_count || 0);
      const translationCount = Number(project.translation_count || 0);
      const audioCount = Number(project.audio_count || 0);
      const questionnaireCount = Number(project.questionnaire_count || 0);

      return `<article class="cloud-project-card">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h3 class="text-xl font-semibold tracking-[-0.035em] truncate">${escapeHtml(project.name || 'Untitled project')}</h3>
              <span class="${syncStatusClass(project.sync_status)}">${escapeHtml(syncStatusLabel(project.sync_status))}</span>
            </div>
            <p class="text-white/42 text-sm">${escapeHtml(project.organization_name || 'No organization')} · ${escapeHtml(project.provider || 'cloud')}</p>
          </div>
          <div class="text-left lg:text-right">
            <span class="account-label">Last sync</span>
            <div class="text-white/70 text-sm">${formatDate(project.last_synced_at || project.updated_at)}</div>
          </div>
        </div>
        <div class="cloud-project-meta">
          <div><span class="account-label">Size</span><div>${formatBytes(project.size_bytes)}</div></div>
          <div><span class="account-label">Cues</span><div>${cueCount || '—'}</div></div>
          <div><span class="account-label">Translations</span><div>${translationCount || '—'}</div></div>
          <div><span class="account-label">Audio</span><div>${audioCount || '—'}</div></div>
          <div><span class="account-label">Questionnaires</span><div>${questionnaireCount || '—'}</div></div>
          <div><span class="account-label">Updated by</span><div>${escapeHtml(project.last_modified_by || '—')}</div></div>
        </div>
      </article>`;
    }).join('');
  }

  async function loadCloudProjects(token) {
    try {
      const projects = await apiFetch('/rest/v1/rpc/current_user_cloud_projects', token, { method: 'POST', body: JSON.stringify({}) });
      renderCloudProjects(projects);
    } catch (error) {
      renderCloudProjects([], true);
    }
  }

  async function loadAccount(token) {
    await apiFetch('/auth/v1/user', token);
    const licenses = await apiFetch('/rest/v1/rpc/current_user_licenses', token, { method: 'POST', body: JSON.stringify({}) });
    const downloads = await apiFetch('/rest/v1/rpc/current_user_downloads', token, { method: 'POST', body: JSON.stringify({}) });
    renderLicenses(licenses);
    renderDownloads(downloads);
    await loadCloudProjects(token);
    showApp();
  }

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorBox) errorBox.hidden = true;
    const formData = new FormData(loginForm);
    const email = String(formData.get('email') || '').trim();
    const password = String(formData.get('password') || '');
    if (!email) return showError('Enter your email.');
    if (!password) return showError('Enter your password, or use the email link button.');
    try {
      const token = await signInWithPassword(email, password);
      await loadAccount(token);
    } catch (error) {
      showLogin();
      showError(error instanceof Error ? error.message : 'Login failed.');
    }
  });

  magicButton?.addEventListener('click', async () => {
    if (errorBox) errorBox.hidden = true;
    const formData = new FormData(loginForm);
    const email = String(formData.get('email') || '').trim();
    if (!email) return showError('Enter your email.');
    try {
      await sendMagicLink(email);
      showError('Email link sent. Check your inbox, then return here.');
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Email link failed.');
    }
  });

  document.addEventListener('click', async (event) => {
    const oauthButton = event.target.closest?.('[data-account-oauth]');
    if (oauthButton) {
      if (errorBox) errorBox.hidden = true;
      try {
        startOAuth(oauthButton.getAttribute('data-account-oauth') || 'google');
      } catch (error) {
        showError(error instanceof Error ? error.message : 'Provider login is not configured yet.');
      }
      return;
    }

    const button = event.target.closest?.('[data-copy-access-code]');
    if (!button) return;
    const key = button.getAttribute('data-copy-access-code') || '';
    await navigator.clipboard.writeText(key);
    button.textContent = 'Copied';
    window.setTimeout(() => { button.textContent = 'Copy'; }, 1400);
  });

  logoutButton?.addEventListener('click', () => {
    localStorage.removeItem(storageKey);
    window.location.reload();
  });

  refreshButton?.addEventListener('click', async () => {
    const token = getStoredToken();
    if (token) await loadAccount(token).catch((error) => showError(error instanceof Error ? error.message : 'Refresh failed.'));
  });

  showLogin();
  const token = getStoredToken();
  if (token) {
    loadAccount(token).catch((error) => {
      localStorage.removeItem(storageKey);
      showLogin();
      showError(error instanceof Error ? error.message : 'Session expired. Please sign in again.');
    });
  }
</script>

<style is:global>
  @reference "../styles/global.css";
  .account-provider { @apply h-12 rounded-xl border border-white/10 bg-white/[0.045] hover:bg-white/[0.075] hover:border-white/20 transition-colors inline-flex items-center justify-center gap-3 text-[15px] font-medium text-white/90; }
  .provider-logo { width: 20px; height: 20px; flex: none; display: block; }
  .provider-logo-apple { font-size: 20px; line-height: 1; text-align: center; }
  .account-input { @apply w-full h-12 rounded-xl border border-white/10 bg-black/30 text-white outline-none transition-all text-[15px]; padding: 0 16px; }
  .account-input:focus { border-color: rgba(239, 68, 68, 0.55); box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12); }
  .account-input::placeholder { color: rgba(255,255,255,0.34); }
  .account-card { @apply rounded-xl border border-white/10 bg-black/25 p-5; }
  .account-label { @apply block text-[10px] font-mono uppercase tracking-[0.12em] text-white/35 mb-1; }
  .account-access-code { @apply font-mono text-[13px] text-white/78 break-all; }
  .account-copy { @apply h-9 px-3 rounded-lg border border-white/10 bg-white/[0.04] text-white/55 hover:text-white hover:bg-white/[0.08] cursor-pointer text-sm transition-colors; }
  .account-status-active { @apply inline-flex px-2.5 py-1 rounded-full bg-green-400/10 border border-green-400/20 text-green-200 text-xs font-mono uppercase tracking-[0.08em]; }
