  function detectLocale() {
    const pathLocale = window.location.pathname.split('/').filter(Boolean)[0];
    if (['it', 'fr', 'es', 'de'].includes(pathLocale)) return pathLocale;
    const browserLocale = (navigator.languages?.[0] || navigator.language || 'en').toLowerCase().split('-')[0];
    return ['it', 'fr', 'es', 'de'].includes(browserLocale) ? browserLocale : 'en';
  }

  const locale = detectLocale();
  const text = translations[locale] || translations.en;
  const t = (key) => text[key] || translations.en[key] || key;

  document.documentElement.lang = locale;
  document.querySelectorAll('[data-i18n]').forEach((node) => { node.textContent = t(node.getAttribute('data-i18n')); });
  document.querySelectorAll('[data-i18n-placeholder]').forEach((node) => { node.setAttribute('placeholder', t(node.getAttribute('data-i18n-placeholder'))); });
  document.title = `${t('nav.account')} Sténtor - Sténtor`;

  const loginPanel = document.querySelector('[data-account-login]');
  const appPanel = document.querySelector('[data-account-app]');
  const loginForm = document.querySelector('[data-account-login-form]');
  const errorBox = document.querySelector('[data-account-error]');
  const logoutButton = document.querySelector('[data-account-logout]');
  const magicButton = document.querySelector('[data-account-magic-link]');
  const refreshButton = document.querySelector('[data-account-refresh]');
  const licensesTarget = document.querySelector('[data-account-licenses]');
  const downloadsTarget = document.querySelector('[data-account-downloads]');
  const accountSummaryTarget = document.querySelector('[data-account-summary]');
  const cloudSummaryTarget = document.querySelector('[data-account-cloud-summary]');
  const cloudProjectsTarget = document.querySelector('[data-account-cloud-projects]');
  let cloudAvailable = false;

  function showLogin() {
    if (loginPanel) loginPanel.hidden = false;
    if (appPanel) appPanel.hidden = true;
    if (logoutButton) logoutButton.hidden = true;
  }

  function showApp() {
    if (loginPanel) loginPanel.hidden = true;
    if (appPanel) appPanel.hidden = false;
    if (logoutButton) logoutButton.hidden = false;
  }

  function getTokenFromHash() {
    const hash = new URLSearchParams(window.location.hash.replace(/^#/, ''));
    const token = hash.get('access_token');
    const error = hash.get('error_description') || hash.get('error');
    if (token) {
      localStorage.setItem(storageKey, token);
      history.replaceState(null, '', window.location.pathname);
    } else if (error) {
      showError(error);
      history.replaceState(null, '', window.location.pathname);
    }
    return token;
  }

  function getStoredToken() {
    return getTokenFromHash() || localStorage.getItem(storageKey) || '';
  }

  async function readError(response, fallback) {
    try {
      const body = await response.json();
      return body.msg || body.message || body.error_description || body.error || fallback;
    } catch {
      return fallback;
    }
  }

  function showError(message) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  function ensureConfig() {
    if (!supabaseUrl || !supabaseAnonKey) {
      throw new Error(t('error.config'));
    }
  }

  function startOAuth(provider) {
    ensureConfig();
    const redirectTo = `${window.location.origin}/auth/confirm?next=/account`;
    const url = new URL(`${supabaseUrl}/auth/v1/authorize`);
    url.searchParams.set('provider', provider);
    url.searchParams.set('redirect_to', redirectTo);
    window.location.assign(url.toString());
  }

  async function apiFetch(path, token, options = {}) {
    ensureConfig();
    const response = await fetch(`${supabaseUrl}${path}`, {
      ...options,
      headers: {
        apikey: supabaseAnonKey,
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
        ...(options.headers || {}),
      },
    });
    if (!response.ok) throw new Error(await readError(response, t('error.request')));
    return response.json();
  }

  async function signInWithPassword(email, password) {
    ensureConfig();
    const response = await fetch(`${supabaseUrl}/auth/v1/token?grant_type=password`, {
      method: 'POST',
      headers: { apikey: supabaseAnonKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    if (!response.ok) throw new Error(await readError(response, t('error.login')));
    const body = await response.json();
    localStorage.setItem(storageKey, body.access_token);
    return body.access_token;
  }

  async function sendMagicLink(email) {
    ensureConfig();
    const redirectTo = `${window.location.origin}/auth/confirm?next=/account`;
    const response = await fetch(`${supabaseUrl}/auth/v1/otp?redirect_to=${encodeURIComponent(redirectTo)}`, {
      method: 'POST',
      headers: { apikey: supabaseAnonKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, create_user: true }),
    });
    if (!response.ok) throw new Error(await readError(response, t('error.emailNotSent')));
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (character) => {
      if (character === '&') return '&amp;';
      if (character === '<') return '&lt;';
      if (character === '>') return '&gt;';
      if (character === '"') return '&quot;';
      return '&#39;';
    });
  }

  function statusClass(status) {
    if (status === 'active') return 'account-status-active';
    if (status === 'revoked') return 'account-status-revoked';
    return 'account-status-pending';
  }

  function statusLabel(status) {
    return t(`status.${status}`) || status || t('date.unknown');
  }

  function planLabel(plan) {
    return t(`plan.${plan}`) || plan || '—';
  }

  function syncStatusClass(status) {
    if (status === 'synced') return 'cloud-status-synced';
    if (status === 'conflict') return 'cloud-status-conflict';
    if (status === 'local_changes' || status === 'remote_changes') return 'cloud-status-pending';
    return 'cloud-status-muted';
  }

  function syncStatusLabel(status) {
    return t(`sync.${status}`) || t('sync.unknown');
  }

  function formatBytes(bytes) {
    const value = Number(bytes || 0);
    if (!Number.isFinite(value) || value <= 0) return '—';
    const units = ['B', 'KB', 'MB', 'GB'];
    let amount = value;
    let unitIndex = 0;
    while (amount >= 1024 && unitIndex < units.length - 1) {
      amount /= 1024;
      unitIndex += 1;
    }
    return `${amount.toFixed(unitIndex === 0 ? 0 : 1)} ${units[unitIndex]}`;
  }

  function formatDate(value) {
    if (!value) return t('date.never');
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return t('date.unknown');
    return date.toLocaleString(locale, { dateStyle: 'medium', timeStyle: 'short' });
  }

  function productLabel() {
    return 'Sténtor';
  }

  function platformLabel(platform) {
    if (platform === 'macos') return 'macOS';
    if (platform === 'windows') return 'Windows';
    if (platform === 'linux') return 'Linux';
    return platform || '—';
  }

  function formatPlatforms(platforms) {
    return (platforms || []).map(platformLabel).join(', ') || '—';
  }

  function shortCode(value) {
    const code = String(value || '');
    if (code.length <= 18) return code || '—';
    return `${code.slice(0, 8)}…${code.slice(-4)}`;
  }

  function renderAccountSummary(licenses = [], downloads = [], hasCloud = false) {
    if (!accountSummaryTarget) return;
    const activeLicenses = licenses.filter((license) => license.status === 'active').length;
    const platforms = Array.from(new Set(licenses.flatMap((license) => license.enabled_platforms || []).map(platformLabel))).filter(Boolean).join(', ') || '—';
    const buildCount = downloads.length;
    const buildValue = buildCount ? `${buildCount} ${t('summary.buildsAvailable')}` : t('summary.noBuilds');
    accountSummaryTarget.innerHTML = `
      <div class="summary-row"><span>${t('summary.activeAccesses')}</span><strong>${activeLicenses}</strong></div>
      <div class="summary-row"><span>${t('summary.platforms')}</span><strong>${escapeHtml(platforms)}</strong></div>
      <div class="summary-row"><span>${t('summary.cloud')}</span><strong class="${hasCloud ? 'text-green-200' : 'text-red-200'}">${hasCloud ? t('summary.cloudActive') : t('summary.cloudInactive')}</strong></div>
      <div class="summary-row"><span>${t('summary.builds')}</span><strong>${escapeHtml(buildValue)}</strong></div>
    `;
  }

  function renderLicenses(licenses) {
    if (!licensesTarget) return;
    if (!licenses.length) {
      licensesTarget.innerHTML = `<div class="account-card"><h3 class="text-xl font-semibold tracking-[-0.03em] mb-2">${t('license.noneTitle')}</h3><p class="text-white/58 leading-[1.65]">${t('license.noneBody')}</p><a href="/account" class="inline-flex mt-5 h-11 px-4 rounded-xl bg-red-500 text-black font-semibold items-center justify-center hover:bg-red-400 transition-colors">${t('license.refreshAccount')}</a></div>`;
      return;
    }

    licensesTarget.innerHTML = licenses.map((license, index) => {
      const platforms = formatPlatforms(license.enabled_platforms);
      const expires = license.expires_at ? new Date(license.expires_at).toLocaleDateString(locale) : t('date.noExpiration');
      const fullCode = String(license.license_key || '');
      return `<article class="account-card access-card">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
          <div class="min-w-0">
            <span class="account-label">${t('accessCode')}</span>
            <div class="account-access-code"><span data-access-short="${index}">${escapeHtml(shortCode(fullCode))}</span><span data-access-full="${index}" hidden>${escapeHtml(fullCode || '—')}</span></div>
          </div>
          <div class="flex items-center gap-2 md:gap-3">
            <button type="button" class="account-copy" data-toggle-access-code="${index}">${t('label.show')}</button>
            <button type="button" class="account-copy" data-copy-access-code="${escapeHtml(fullCode)}">${t('label.copy')}</button>
          </div>
        </div>
        <div class="account-data-grid">
          <div><span class="account-label">${t('label.status')}</span><span class="${statusClass(license.status)}">${escapeHtml(statusLabel(license.status))}</span></div>
          <div><span class="account-label">${t('label.access')}</span><div class="account-value">${escapeHtml(planLabel(license.plan))}</div></div>
          <div><span class="account-label">${t('label.activeDevices')}</span><div class="account-value">${license.max_activations}</div></div>
          <div><span class="account-label">${t('label.platforms')}</span><div class="account-value">${escapeHtml(platforms)}</div></div>
          <div><span class="account-label">${t('label.expires')}</span><div class="account-value">${escapeHtml(expires)}</div></div>
          <div><span class="account-label">${t('label.organization')}</span><div class="account-value">${escapeHtml(license.organization_name || '—')}</div></div>
        </div>
      </article>`;
    }).join('');
  }

  function renderDownloads(downloads) {
    if (!downloadsTarget) return;
    if (!downloads.length) {
      downloadsTarget.innerHTML = `<div class="download-card"><strong>${t('downloads.noneTitle')}</strong><span>${t('downloads.noneBody')}</span></div>`;
      return;
    }

    downloadsTarget.innerHTML = downloads.map((item) => {
      const title = `${productLabel(item.product)} ${platformLabel(item.platform)}`;
      const subtitle = `${item.channel} · v${item.version}`;
      if (item.is_available && item.file_url) {
        return `<a class="download-card download-card-active" href="${item.file_url}" target="_blank" rel="noreferrer"><strong>${escapeHtml(title)}</strong><span>${escapeHtml(subtitle)}</span><em>${t('downloads.download')} →</em></a>`;
      }
      return `<div class="download-card"><strong>${escapeHtml(title)}</strong><span>${escapeHtml(subtitle)}</span><em>${t('downloads.comingSoon')}</em></div>`;
    }).join('');
  }

  function renderCloudProjects(projects, unavailable = false) {
    if (!cloudSummaryTarget || !cloudProjectsTarget) return;
    cloudAvailable = !unavailable;

    if (unavailable) {
      cloudSummaryTarget.innerHTML = `<span>${t('cloud.notConfigured')}</span>`;
      cloudProjectsTarget.innerHTML = `<div class="account-card"><h3 class="text-xl font-semibold tracking-[-0.03em] mb-2">${t('cloud.unavailableTitle')}</h3><p class="text-white/58 leading-[1.65]">${t('cloud.unavailableBody')}</p></div>`;
      return;
    }

    if (!projects.length) {
      cloudSummaryTarget.innerHTML = `<span>0 ${t('cloud.projects')}</span>`;
      cloudProjectsTarget.innerHTML = `<div class="account-card"><h3 class="text-xl font-semibold tracking-[-0.03em] mb-2">${t('cloud.noneTitle')}</h3><p class="text-white/58 leading-[1.65]">${t('cloud.noneBody')}</p></div>`;
      return;
    }

    const totalBytes = projects.reduce((sum, project) => sum + Number(project.size_bytes || 0), 0);
    const syncedCount = projects.filter((project) => project.sync_status === 'synced').length;
    const conflictCount = projects.filter((project) => project.sync_status === 'conflict').length;

    cloudSummaryTarget.innerHTML = `
      <span><strong>${projects.length}</strong> ${t('cloud.projects')}</span>
      <span><strong>${formatBytes(totalBytes)}</strong> ${t('cloud.used')}</span>
      <span><strong>${syncedCount}</strong> ${t('cloud.synced')}</span>
      ${conflictCount ? `<span class="text-red-200"><strong>${conflictCount}</strong> ${t('cloud.conflicts')}</span>` : ''}
    `;

    cloudProjectsTarget.innerHTML = projects.map((project) => {
      const cueCount = Number(project.cue_count || 0);
      const translationCount = Number(project.translation_count || 0);
      const audioCount = Number(project.audio_count || 0);
      const questionnaireCount = Number(project.questionnaire_count || 0);

      return `<article class="cloud-project-card">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h3 class="text-xl font-semibold tracking-[-0.035em] truncate">${escapeHtml(project.name || t('cloud.untitled'))}</h3>
              <span class="${syncStatusClass(project.sync_status)}">${escapeHtml(syncStatusLabel(project.sync_status))}</span>
            </div>
            <p class="text-white/48 text-sm">${escapeHtml(project.organization_name || t('cloud.noOrganization'))} · ${escapeHtml(project.provider || t('cloud.providerFallback'))}</p>
          </div>
          <div class="text-left lg:text-right">
            <span class="account-label">${t('label.lastSync')}</span>
            <div class="text-white/78 text-sm">${formatDate(project.last_synced_at || project.updated_at)}</div>
          </div>
        </div>
        <div class="cloud-project-meta">
          <div><span class="account-label">${t('label.size')}</span><div>${formatBytes(project.size_bytes)}</div></div>
          <div><span class="account-label">${t('label.cues')}</span><div>${cueCount || '—'}</div></div>
          <div><span class="account-label">${t('label.translations')}</span><div>${translationCount || '—'}</div></div>
          <div><span class="account-label">${t('label.audio')}</span><div>${audioCount || '—'}</div></div>
          <div><span class="account-label">${t('label.questionnaires')}</span><div>${questionnaireCount || '—'}</div></div>
          <div><span class="account-label">${t('label.updatedBy')}</span><div>${escapeHtml(project.last_modified_by || '—')}</div></div>
        </div>
      </article>`;
    }).join('');
  }

  async function loadCloudProjects(token) {
    try {
      const projects = await apiFetch('/rest/v1/rpc/current_user_cloud_projects', token, { method: 'POST', body: JSON.stringify({}) });
      renderCloudProjects(projects);
      return true;
    } catch (error) {
      renderCloudProjects([], true);
      return false;
    }
  }

  async function loadAccount(token) {
    await apiFetch('/auth/v1/user', token);
    const licenses = await apiFetch('/rest/v1/rpc/current_user_licenses', token, { method: 'POST', body: JSON.stringify({}) });
    const downloads = await apiFetch('/rest/v1/rpc/current_user_downloads', token, { method: 'POST', body: JSON.stringify({}) });
    renderLicenses(licenses);
    renderDownloads(downloads);
    const hasCloud = await loadCloudProjects(token);
    renderAccountSummary(licenses, downloads, hasCloud);
    showApp();
  }

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorBox) errorBox.hidden = true;
    const formData = new FormData(loginForm);
    const email = String(formData.get('email') || '').trim();
    const password = String(formData.get('password') || '');
    if (!email) return showError(t('form.enterEmail'));
    if (!password) return showError(t('form.enterPassword'));
    try {
      const token = await signInWithPassword(email, password);
      await loadAccount(token);
    } catch (error) {
      showLogin();
      showError(error instanceof Error ? error.message : t('error.login'));
    }
  });

  magicButton?.addEventListener('click', async () => {
    if (errorBox) errorBox.hidden = true;
    const formData = new FormData(loginForm);
    const email = String(formData.get('email') || '').trim();
    if (!email) return showError(t('form.enterEmail'));
    try {
      await sendMagicLink(email);
      showError(t('magic.sent'));
    } catch (error) {
      showError(error instanceof Error ? error.message : t('error.emailLink'));
    }
  });

  document.addEventListener('click', async (event) => {
    const oauthButton = event.target.closest?.('[data-account-oauth]');
    if (oauthButton) {
      if (errorBox) errorBox.hidden = true;
      try {
        startOAuth(oauthButton.getAttribute('data-account-oauth') || 'google');
      } catch (error) {
        showError(error instanceof Error ? error.message : t('error.provider'));
      }
      return;
    }

    const toggleButton = event.target.closest?.('[data-toggle-access-code]');
    if (toggleButton) {
      const index = toggleButton.getAttribute('data-toggle-access-code');
      const shortNode = document.querySelector(`[data-access-short="${index}"]`);
      const fullNode = document.querySelector(`[data-access-full="${index}"]`);
      const isShowingFull = fullNode && !fullNode.hidden;
      if (shortNode && fullNode) {
        shortNode.hidden = !isShowingFull;
        fullNode.hidden = isShowingFull;
        toggleButton.textContent = isShowingFull ? t('label.show') : t('label.hide');
      }
      return;
    }

    const button = event.target.closest?.('[data-copy-access-code]');
    if (!button) return;
    const key = button.getAttribute('data-copy-access-code') || '';
    await navigator.clipboard.writeText(key);
    button.textContent = t('label.copied');
    window.setTimeout(() => { button.textContent = t('label.copy'); }, 1400);
  });

  logoutButton?.addEventListener('click', () => {
    localStorage.removeItem(storageKey);
    window.location.reload();
  });

  refreshButton?.addEventListener('click', async () => {
    const token = getStoredToken();
    if (token) await loadAccount(token).catch((error) => showError(error instanceof Error ? error.message : t('error.refresh')));
  });

  showLogin();
  const token = getStoredToken();
  if (token) {
    loadAccount(token).catch((error) => {
      localStorage.removeItem(storageKey);
      showLogin();
      showError(error instanceof Error ? error.message : t('error.session'));
    });
  }
</script>

