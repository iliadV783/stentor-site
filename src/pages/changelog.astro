---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Btn from "../components/Btn.astro";
import IconRss from "../assets/icons/rss.svg";
import IconMail from "../assets/icons/mail.svg";
import IconDiscord from "../assets/icons/discord.svg";
import IllusRegionMap from "../assets/illustrations/region-map.svg";
import IllusPolicyHexagon from "../assets/illustrations/policy-hexagon.svg";
import {
  hero,
  filters,
  versionTag,
  versionRange,
  years,
  sideStats,
  loadMore,
} from "../data/changelog";

const subscribeIconMap = { rss: IconRss, mail: IconMail, discord: IconDiscord } as const;

// Illustration registry — maps frontmatter `illustration` value to component + visual config
type IllustrationEntry = {
  Component: typeof IllusRegionMap;
  aspect: string;
  bg: string;
};
const illustrationConfig: Record<string, IllustrationEntry> = {
  "region-map": {
    Component: IllusRegionMap,
    aspect: "aspect-[16/6]",
    bg: "radial-gradient(ellipse 60% 80% at 30% 50%, rgba(239,68,68,0.14), transparent 70%), radial-gradient(ellipse 50% 70% at 80% 60%, rgba(96,165,250,0.10), transparent 70%), var(--color-deep)",
  },
  "policy-hexagon": {
    Component: IllusPolicyHexagon,
    aspect: "aspect-[16/5]",
    bg: "radial-gradient(ellipse 60% 80% at 30% 50%, rgba(239,68,68,0.14), transparent 70%), var(--color-deep)",
  },
};

// Inline markdown helper — converts `code` backticks into <code class="cl-code">.
function mdInline(s: string): string {
  return s.replace(/`([^`]+)`/g, '<code class="cl-code">$1</code>');
}

// Load entries, sort by date desc, pre-render MDX bodies
const allEntries = await getCollection("changelog");
const sortedEntries = allEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const renderedEntries = await Promise.all(
  sortedEntries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

// Group by month for the "— March 2026 —" dividers
type Bucket = { label: string; items: typeof renderedEntries };
const monthBuckets: Bucket[] = [];
for (const r of renderedEntries) {
  const d = r.entry.data.date;
  const label = d.toLocaleString("en-US", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
  let bucket = monthBuckets.find((b) => b.label === label);
  if (!bucket) {
    bucket = { label, items: [] };
    monthBuckets.push(bucket);
  }
  bucket.items.push(r);
}

const fmtMonthDay = (d: Date) =>
  d.toLocaleString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---
<Layout
  title="Changelog — Lambda"
  description="Every shipped feature, fix, and improvement to the Lambda platform. Follow along by RSS or email."
  active="changelog"
>
  <!-- Header -->
  <section class="relative overflow-hidden border-b border-hairline pt-24 pb-16">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.35)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] [mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="max-w-[760px]">
        <Eyebrow><span class="font-mono">{hero.eyebrow}</span></Eyebrow>
        <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.02] tracking-[-0.04em] font-semibold mt-5 mb-4">{hero.title}</h1>
        <p class="text-lg leading-[1.55] text-text-2 mb-7 max-w-[560px]">{hero.description}</p>
        <div class="flex items-center gap-2.5 flex-wrap">
          <form action="javascript:void(0)" class="flex items-center border border-hairline rounded-lg bg-surface overflow-hidden">
            <input type="email" aria-label="Email address" placeholder={hero.emailPlaceholder} class="bg-transparent border-0 outline-0 text-text font-sans text-sm px-3.5 h-10 w-[200px] sm:w-[280px] placeholder:text-text-3" />
            <button type="submit" class="h-10 px-4 border-0 bg-red-500 text-bg font-medium text-sm">{hero.subscribeLabel}</button>
          </form>
          <div class="inline-flex gap-1.5 flex-wrap">
            {hero.subscribeLinks.map((l) => {
              const Icon = subscribeIconMap[l.icon];
              return (
                <a href={l.href} class="h-10 px-3 inline-flex items-center gap-1.5 border border-hairline rounded-lg text-text-2 hover:text-text hover:border-hairline-strong text-[13px] transition-colors">
                  <Icon class="w-4 h-4" />
                  {l.label}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter strip (sticky) -->
  <div class="sticky top-16 z-10 border-b border-hairline bg-bg/60 backdrop-blur-md" x-data="{f:'all'}">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 h-14 flex items-center justify-between gap-4 overflow-x-auto">
      <div class="flex gap-1">
        {filters.map((t) => (
          <button
            @click={`f='${t.id}'`}
            :class={`f==='${t.id}' ? 'bg-red-500/[0.08] border-red-500/25 text-red-500' : 'border-transparent text-text-2 hover:text-text'`}
            class="h-8 px-3 rounded-md border inline-flex items-center gap-2 text-[13px] whitespace-nowrap transition-colors"
          >{t.label} <span :class={`f==='${t.id}' ? 'text-red-400 bg-red-500/[0.18]' : 'text-text-3 bg-white/[0.04]'`} class="font-mono text-[11px] px-1.5 py-px rounded-sm">{t.count}</span></button>
        ))}
      </div>
      <div class="hidden sm:flex items-center gap-2 text-text-3 font-mono text-xs">
        <span class="px-2.5 py-1 border border-hairline rounded-full text-text-2">{versionTag}</span>
        <span>{versionRange}</span>
      </div>
    </div>
  </div>

  <!-- 2-column shell: jump-to-year + content / stats wraps below on smaller screens -->
  <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-16 grid gap-10 lg:[grid-template-columns:160px_minmax(0,1fr)] xl:[grid-template-columns:160px_minmax(0,1fr)_220px] xl:gap-14 items-start">
    <!-- Years -->
    <aside class="hidden lg:block sticky top-32 text-[13px]" aria-label="Jump to year">
      <h2 class="text-[11px] tracking-[0.08em] uppercase text-text-3 font-medium mb-3.5">Jump to</h2>
      <ul class="grid gap-1 list-none p-0 m-0">
        {years.map((y) => (
          <li>
            <a href="#" class:list={[
              "flex items-center justify-between px-2.5 py-1.5 transition-colors",
              y.on ? "text-red-500 bg-red-500/[0.08] shadow-[inset_2px_0_0_#ef4444] rounded-r-md" : "text-text-2 hover:text-text hover:bg-white/[0.03] rounded-md",
            ]}>
              {y.y} <span class:list={["font-mono text-[11px]", y.on ? "text-red-500" : "text-text-3"]}>{y.n}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <!-- Timeline -->
    <section class="relative min-w-0 max-w-[820px]">
      {monthBuckets.map((bucket, bi) => (
        <>
          {bi > 0 && (
            <div class="font-mono text-[11px] text-text-3 tracking-[0.06em] uppercase mb-6 mt-2">— {bucket.label} —</div>
          )}
          {bucket.items.map(({ entry, Content }) => {
            const { data } = entry;
            const isMajor = data.type === "major";
            const illus = data.illustration ? illustrationConfig[data.illustration] : null;
            return (
              <article class:list={[
                "cl-entry mb-14 relative pl-7",
                isMajor && "cl-entry--major",
              ]}>
                <div class="cl-entry__head-row relative flex items-center gap-3 mb-2.5">
                  {isMajor ? (
                    <span class="absolute -left-[25px] top-[7px] w-[11px] h-[11px] rounded-full border-2 border-red-500 bg-red-500 [box-shadow:0_0_0_4px_rgba(239,68,68,0.18),0_0_12px_#ef4444]"></span>
                  ) : (
                    <span class="absolute -left-[25px] top-[7px] w-[11px] h-[11px] rounded-full bg-bg border-2 border-text-4"></span>
                  )}
                  <span class="font-mono text-xs text-text-2">
                    <span class="text-text font-medium">{fmtMonthDay(data.date)}</span> · <span class="text-text-4">{data.date.getUTCFullYear()}</span>
                  </span>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 mb-2">
                  <span class:list={["cl-ver", !isMajor && "cl-ver--minor"]}>v{data.version}</span>
                  {isMajor && <span class="tag tag--amber">Major release</span>}
                  {data.type === "patch" && <span class="tag">Patch</span>}
                  {data.contributors && (
                    <span class="tag">{data.contributors} contributors</span>
                  )}
                </div>

                <h2 class="text-2xl md:text-[26px] tracking-[-0.025em] font-semibold mb-3 mt-1.5">{data.title}</h2>

                <div class="cl-prose mb-6">
                  <Content />
                </div>

                {illus && (
                  <div class="border border-hairline rounded-xl bg-surface overflow-hidden mb-6">
                    <div class:list={[
                      illus.aspect,
                      "relative bg-deep border-b border-hairline overflow-hidden",
                    ]} style={`background: ${illus.bg};`}>
                      <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:48px_48px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
                      <illus.Component class="absolute inset-0 w-full h-full" />
                    </div>
                  </div>
                )}

                {data.changes && (
                  <div class="grid gap-5 mb-3">
                    {data.changes.new && data.changes.new.length > 0 && (
                      <div>
                        <div class="cl-group__hd cl-group__hd--new"><span class="w-1.5 h-1.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444]"></span>New</div>
                        <ul class="cl-list">
                          {data.changes.new.map((c) => (
                            <li><div>
                              {c.title && <><b>{c.title}.</b>{" "}</>}
                              <Fragment set:html={mdInline(c.body)} />
                              {c.pr && <span class="cl-pr">#{c.pr}</span>}
                            </div></li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {data.changes.improvements && data.changes.improvements.length > 0 && (
                      <div>
                        <div class="cl-group__hd cl-group__hd--imp"><span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>Improvements</div>
                        <ul class="cl-list">
                          {data.changes.improvements.map((c) => (
                            <li><div>
                              {c.title && <><b>{c.title}.</b>{" "}</>}
                              <Fragment set:html={mdInline(c.body)} />
                              {c.pr && <span class="cl-pr">#{c.pr}</span>}
                            </div></li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {data.changes.fixes && data.changes.fixes.length > 0 && (
                      <div>
                        <div class="cl-group__hd cl-group__hd--fix"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>Fixes</div>
                        <ul class="cl-list">
                          {data.changes.fixes.map((c) => (
                            <li><div>
                              {c.title && <><b>{c.title}.</b>{" "}</>}
                              <Fragment set:html={mdInline(c.body)} />
                              {c.pr && <span class="cl-pr">#{c.pr}</span>}
                            </div></li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}

                {data.authors && data.authors.length > 0 && (
                  <div class="cl-authors">
                    <div class="flex">
                      {data.authors.map((a) => (
                        <div class:list={["cl-av", a.primary && "cl-av--amber"]}>{a.initials}</div>
                      ))}
                    </div>
                    {data.authorsLine && (
                      <span class="text-[13px] text-text-3">{data.authorsLine}</span>
                    )}
                    {data.links && (
                      <div class="ml-auto inline-flex gap-3.5 text-text-2 text-[13px]">
                        {data.links.map((l) => (
                          <a href={l.href} class="inline-flex items-center gap-1.5 hover:text-text">{l.label}</a>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </>
      ))}

      <!-- Load more -->
      <div class="pl-8">
        <Btn href="#" variant="ghost">{loadMore} <span aria-hidden="true">↓</span></Btn>
      </div>
    </section>

    <!-- Right rail — stats -->
    <aside class="grid gap-3.5 lg:col-span-2 xl:col-span-1 xl:sticky xl:top-32" aria-label="Release stats">
      <div class="border border-hairline rounded-[10px] bg-surface px-5 py-4">
        <h2 class="text-[11px] tracking-[0.06em] uppercase text-text-3 font-medium mb-3.5">{sideStats.thisYear.title}</h2>
        {sideStats.thisYear.rows.map((r) => (
          <div class="cl-stat-row">
            <span class="text-text-2">{r.label}</span>
            <span class:list={["font-mono", r.accent ? "text-red-500" : "text-text"]}>{r.value}</span>
          </div>
        ))}
      </div>
      <div class="border border-hairline rounded-[10px] bg-surface px-5 py-4">
        <h2 class="text-[11px] tracking-[0.06em] uppercase text-text-3 font-medium mb-3.5">{sideStats.cadence.title}</h2>
        <div class="mt-3.5 h-8 flex items-end gap-[3px]">
          {sideStats.cadence.bars.map((h) => (
            <i class="flex-1 bg-red-500 rounded-[1px] opacity-55" style={`height: ${h}%;${h === 100 ? " opacity: 1;" : ""}`}></i>
          ))}
        </div>
        <div class="flex justify-between font-mono text-[10px] text-text-4 mt-1.5">
          <span>{sideStats.cadence.rangeStart}</span><span>{sideStats.cadence.rangeEnd}</span>
        </div>
      </div>
      <div class="border border-hairline rounded-[10px] bg-surface px-5 py-4">
        <h2 class="text-[11px] tracking-[0.06em] uppercase text-text-3 font-medium mb-3.5">{sideStats.status.title}</h2>
        {sideStats.status.rows.map((r) => (
          <div class="cl-stat-row">
            <span class="text-text-2">{r.label}</span>
            <span class:list={["font-mono", r.color === "green" ? "text-green-400" : "text-text"]}>{r.value}</span>
          </div>
        ))}
      </div>
    </aside>
  </div>
</Layout>

<style is:global>
  /*
    All `.cl-*` classes are global so they apply both to the .astro template
    and to HTML rendered via <Content /> (MDX bodies) and set:html (inline
    markdown helper). The classes are namespaced — no collision risk.
  */

  .cl-entry { padding-left: 1.75rem; }
  .cl-entry::before {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.75rem;
    bottom: -56px;
    width: 1px;
    background: var(--color-hairline);
  }
  .cl-entry:last-child::before { display: none; }

  .cl-ver {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 3px 0.5rem;
    border-radius: 0.125rem;
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
    font-weight: 500;
  }
  .cl-ver--minor {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-2);
    border-color: var(--color-hairline);
  }

  .cl-code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 1px 6px;
    border-radius: 2px;
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.18);
  }

  /* Description body rendered from MDX */
  .cl-prose p {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-2);
  }
  .cl-prose p + p { margin-top: 0.75rem; }
  .cl-prose code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 1px 6px;
    border-radius: 2px;
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.18);
  }

  .cl-group__hd {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
    border: 1px solid;
  }
  .cl-group__hd--new {
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.22);
  }
  .cl-group__hd--imp {
    background: rgba(96, 165, 250, 0.06);
    color: #60a5fa;
    border-color: rgba(96, 165, 250, 0.22);
  }
  .cl-group__hd--fix {
    background: rgba(74, 222, 128, 0.06);
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.22);
  }

  .cl-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.625rem;
  }
  .cl-list li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 0.625rem;
    color: rgb(212 212 216);
    font-size: 14.5px;
    line-height: 1.55;
  }
  .cl-list li::before {
    content: "";
    margin-top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-text-4);
    align-self: start;
    justify-self: center;
  }
  .cl-list li b { font-weight: 500; color: var(--color-text); }

  .cl-pr {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-3);
    margin-left: 6px;
  }

  .cl-authors {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-hairline);
    flex-wrap: wrap;
  }
  .cl-av {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    border: 2px solid var(--color-bg);
    margin-left: -6px;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-2);
    background: linear-gradient(135deg, var(--color-chrome), #131313);
  }
  .cl-av:first-child { margin-left: 0; }
  .cl-av--amber {
    background: linear-gradient(135deg, #ef4444, #b91c1c);
    color: var(--color-bg);
  }

  .cl-stat-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--color-hairline);
    font-size: 13px;
  }
  .cl-stat-row:last-child { border-bottom: 0; }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-2);
    border: 1px solid var(--color-hairline);
  }
  .tag--amber {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.25);
  }
</style>
