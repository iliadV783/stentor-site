---
import Layout from "../layouts/Layout.astro";
import Btn from "../components/Btn.astro";
---

<Layout title="Sign in to Sténtor - Sténtor" description="Sign in to your Sténtor Account to view your licence key, activation details and available downloads." noindex>
  <section class="min-h-[78vh] max-w-[760px] mx-auto px-4 md:px-8 py-20 md:py-28 flex items-center">
    <div class="w-full rounded-3xl border border-hairline bg-surface p-6 md:p-9 text-center shadow-[0_24px_70px_-44px_rgba(0,0,0,0.75)]">
      <p class="font-mono text-xs tracking-[0.12em] uppercase text-stentor mb-4">Account</p>
      <h1 class="text-4xl md:text-6xl tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Sign in to Sténtor.</h1>
      <p class="text-lg text-text-2 leading-[1.55] max-w-[600px] mx-auto mb-8">
        Use your Sténtor Account after your beta request has been approved. Your Account shows the licence key, activation status and downloads enabled for your workspace.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <Btn href="/account" variant="primary" size="lg">Open Account <span aria-hidden="true">→</span></Btn>
        <Btn href="/request-pro" variant="ghost" size="lg">Request access</Btn>
      </div>
    </div>
  </section>
</Layout>
