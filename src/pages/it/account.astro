---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Reindirizzamento — Sténtor"
  description="La pagina account non è ancora pubblica. Verrai reindirizzato alla richiesta di prova."
  active={null}
  noindex={true}
  showNav={false}
  showFooter={false}
>
  <script is:inline>
    window.location.replace("/it/richiedi-prova/");
  </script>

  <section class="min-h-[70vh] max-w-[760px] mx-auto px-4 md:px-8 py-24 md:py-32 flex flex-col justify-center">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-stentor mb-4">Reindirizzamento</p>
    <h1 class="text-4xl md:text-[56px] tracking-[-0.05em] leading-[1] font-semibold mb-5">
      L’area personale non è ancora pubblica.
    </h1>
    <p class="text-xl text-text-2 leading-[1.55] mb-8">
      Ti stiamo portando alla pagina per richiedere l’accesso alla prova di Sténtor.
    </p>
    <a
      href="/it/richiedi-prova/"
      class="inline-flex w-fit items-center justify-center h-11 px-5 rounded-xl bg-stentor text-bg hover:bg-stentor-dark transition-colors font-semibold"
    >
      Vai a Richiedi prova →
    </a>
  </section>
</Layout>
