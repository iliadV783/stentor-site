<script is:inline>
  function setupTocScrollSpy() {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (!links.length) return;
    const sections = links
      .map((link) => {
        const href = link.getAttribute("href") || "";
        if (!href.startsWith("#")) return null;
        const el = document.getElementById(href.slice(1));
        return el ? { id: el.id, el, link } : null;
      })
      .filter(Boolean);
    if (!sections.length) return;
    function activate(id) {
      sections.forEach((s) => {
        const isActive = s.id === id;
        if (isActive) {
          s.link.classList.add("text-red-500");
          s.link.classList.remove("text-text-3", "hover:text-text-2");
        } else {
          s.link.classList.remove("text-red-500");
          s.link.classList.add("text-text-3", "hover:text-text-2");
        }
      });
    }
    const visible = new Set();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        const active = sections.find((s) => visible.has(s.id)) || sections[0];
        if (active) activate(active.id);
      },
      { rootMargin: "-20% 0px -65% 0px", threshold: 0.01 }
    );
    sections.forEach((s) => observer.observe(s.el));
  }
  setupTocScrollSpy();
  document.addEventListener("astro:page-load", setupTocScrollSpy);
</script>