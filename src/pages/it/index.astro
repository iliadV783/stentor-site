---
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn.astro";
---

<Layout title="Sténtor — Testo live multilingue" description="Sopratitoli, traduzione e audio descrizione per lo spettacolo dal vivo." active={null}>
  <section class="max-w-[1120px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-5">Italiano · multilingue per progetto</p>
    <h1 class="text-5xl md:text-[80px] tracking-[-0.065em] leading-[0.96] font-semibold max-w-[940px] mb-6">
      Sopratitoli, traduzione e audio descrizione. Dal vivo.
    </h1>
    <p class="text-xl text-text-2 leading-[1.6] max-w-[780px] mb-8">
      Sténtor è uno strumento desktop-first per il testo nello spettacolo dal vivo: prepara progetti multilingue, manda in regia sopratitoli e traduzioni, gestisce l’audio descrizione, invia il testo agli schermi di sala e permette ai telefoni del pubblico di seguire su rete locale.
    </p>
    <div class="flex flex-wrap gap-3 mb-10">
      <Btn href="/download" variant="primary" size="lg">Scarica Sténtor →</Btn>
      <Btn href="/docs" variant="ghost" size="lg">Leggi il workflow</Btn>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-hairline bg-surface p-5"><h2 class="font-semibold mb-2">Progetti multilingue</h2><p class="text-sm text-text-2 leading-[1.55]">Testo originale, traduzioni, sopratitoli e lingue del progetto restano in un unico spazio modificabile.</p></div>
      <div class="rounded-2xl border border-hairline bg-surface p-5"><h2 class="font-semibold mb-2">Regia / Stage desk</h2><p class="text-sm text-text-2 leading-[1.55]">L’operatore controlla cue, nero, schermi, telefoni del pubblico e stato dell’audio descrizione.</p></div>
      <div class="rounded-2xl border border-hairline bg-surface p-5"><h2 class="font-semibold mb-2">Schermi e telefoni</h2><p class="text-sm text-text-2 leading-[1.55]">Usa schermi di sala, pagina foyer con QR e dispositivi personali su rete locale.</p></div>
    </div>
  </section>
</Layout>
