---
import Layout from "../../layouts/Layout.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Btn from "../../components/Btn.astro";
import FinalCta from "../../components/FinalCta.astro";
import Hero from "../../components/sections/home/Hero.astro";
import HomeSummary from "../../components/sections/home/HomeSummary.astro";
import { hero, bento, finalCta } from "../../data/home.it";
---
<Layout
  title="Sténtor — Sopratitoli, traduzione e audio descrizione"
  description="Sténtor riunisce sopratitoli, traduzione e audio descrizione in un unico flusso local-first per lo spettacolo dal vivo."
  active={null}
>
  <Hero hero={hero} />
  <HomeSummary />
  <section class="py-20 lg:py-28 border-t border-hairline">
    <div class="max-w-[1180px] mx-auto px-4 md:px-8">

      <div class="grid lg:grid-cols-[1.15fr_.85fr] gap-6">

        <article class="rounded-2xl border border-hairline bg-surface overflow-hidden shadow-[0_24px_70px_-55px_rgba(37,61,96,.45)]">
          <div class="p-7 md:p-9 lg:p-11">

            <p class="font-mono text-[11px] tracking-[0.1em] uppercase text-stentor mb-4">
              Sténtor
            </p>

            <h2 class="text-4xl md:text-5xl lg:text-[56px] leading-[0.98] tracking-[-0.055em] font-semibold max-w-[620px]">
              Sténtor è gratuito.
            </h2>

            <p class="mt-5 text-lg text-text-2 leading-relaxed max-w-[650px]">
              Un’unica app completa, sviluppata nativamente per macOS, Windows e Linux,
              per preparare e condurre lo spettacolo dal vivo.
            </p>

            <div class="grid sm:grid-cols-3 gap-3 mt-9">

              <div class="rounded-xl border border-hairline bg-bg p-4">
                <div class="flex items-center gap-3">
                  <div class="platform-icon platform-icon--apple" aria-hidden="true">
                    
                  </div>
                  <div>
                    <span class="block font-mono text-[9px] uppercase tracking-[.08em] text-text-3">
                      macOS
                    </span>
                    <b class="text-sm font-medium whitespace-nowrap">
                      Silicon e Intel
                    </b>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-hairline bg-bg p-4">
                <div class="flex items-center gap-3">
                  <div class="platform-icon platform-icon--windows" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="presentation">
                      <path d="M3 4.5 10.5 3v8H3V4.5Zm8.5-1.7L21 1v10h-9.5V2.8ZM3 12.2h7.5v8L3 18.8v-6.6Zm8.5 0H21v10l-9.5-1.8v-8.2Z" fill="currentColor"/>
                    </svg>
                  </div>
                  <div>
                    <span class="block font-mono text-[9px] uppercase tracking-[.08em] text-text-3">
                      Windows
                    </span>
                    <b class="text-sm font-medium whitespace-nowrap">
                      x64 + ARM64
                    </b>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-hairline bg-bg p-4">
                <div class="flex items-center gap-3">
                  <div class="platform-icon platform-icon--linux" aria-hidden="true">
                    <img src="/icons/linux.svg" alt="" />
                  </div>
                  <div>
                    <span class="block font-mono text-[9px] uppercase tracking-[.08em] text-text-3">
                      Linux
                    </span>
                    <b class="text-sm font-medium whitespace-nowrap">
                      x64 + ARM64
                    </b>
                  </div>
                </div>
              </div>

            </div>

            <div class="flex flex-wrap gap-x-5 gap-y-2 mt-7 text-sm text-text-2">
              <span>✓ Testo e lingue</span>
              <span>✓ Audiodescrizione</span>
              <span>✓ Schermi</span>
              <span>✓ Pubblico</span>
              <span>✓ Regia live</span>
            </div>

            <div class="mt-9">
              <Btn href="/it/download" variant="primary" size="lg">
                Scarica <span aria-hidden="true">→</span>
              </Btn>
            </div>

          </div>
        </article>


        <article class="rounded-2xl border border-hairline bg-bg p-7 md:p-9 lg:p-10 flex flex-col">

          <p class="font-mono text-[11px] tracking-[0.1em] uppercase text-text-3 mb-4">
            Teatri, compagnie e istituzioni
          </p>

          <h3 class="text-3xl md:text-[38px] leading-[1.02] tracking-[-0.045em] font-semibold">
            Raccontaci il tuo progetto
          </h3>

          <p class="mt-5 text-text-2 leading-relaxed">
            Possiamo fornire supporto a teatri, festival, scuole, tournée e organizzazioni
            che vogliono usare Sténtor su più postazioni o preparare configurazioni dedicate:
          </p>

          <div class="mt-8 grid gap-3 text-sm">
            <div class="flex gap-3">
              <span class="text-stentor">✓</span>
              <span>Più postazioni</span>
            </div>

            <div class="flex gap-3">
              <span class="text-stentor">✓</span>
              <span>Supporto durante test e prove</span>
            </div>

            <div class="flex gap-3">
              <span class="text-stentor">✓</span>
              <span>Configurazione in sala</span>
            </div>

            <div class="flex gap-3">
              <span class="text-stentor">✓</span>
              <span>Uso in festival e tournée</span>
            </div>
          </div>

          <div class="mt-auto pt-10">
            <Btn href="/it/contact" variant="ghost" size="lg">
              Scrivici
            </Btn>
          </div>

        </article>

      </div>

      <p class="mt-5 text-xs text-text-3 max-w-[700px]">
        L’attivazione gratuita ci aiuta a seguire l’uso reale di Sténtor,
        fornire supporto e continuare lo sviluppo.
      </p>

    </div>
  </section>

  <FinalCta variant={finalCta.variant} paddingY="py-16 md:py-20" gap="gap-4">
    <h2 class="text-3xl sm:text-4xl lg:text-[46px] leading-[1.02] tracking-[-0.04em] font-semibold max-w-[880px]" set:html={finalCta.title}></h2>
    <p class="text-base leading-[1.55] text-text-2 max-w-[600px]" set:html={finalCta.body}></p>
    <div class="flex flex-wrap gap-3 justify-center mt-2">
      {finalCta.ctas.map((cta, i) => (
        <Btn href={cta.href} variant={cta.variant} size="lg">
          {cta.label}{i === 0 && <span aria-hidden="true">→</span>}
        </Btn>
      ))}
    </div>
  </FinalCta>

<style>
  .platform-icon {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-hairline);
    border-radius: 0.5rem;
    background: var(--color-surface);
    display: grid;
    place-items: center;
    color: var(--color-stentor);
    flex: 0 0 auto;
  }

  .platform-icon--apple {
    font-size: 1.45rem;
    line-height: 1;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
  }


  .platform-icon--windows,
  .platform-icon--linux {
    display: grid;
    place-items: center;
  }

  .platform-icon--windows svg,
  .platform-icon--linux svg {
    display: block;
    width: 21px;
    height: 21px;
  }

  .platform-icon--windows svg {
    width: 20px;
    height: 20px;
  }



  .platform-icon--linux img {
    display: block;
    width: 22px;
    height: 22px;
    object-fit: contain;
  }
</style>

</Layout>
