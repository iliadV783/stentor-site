---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Download" description="Download" active={null}>
  <section class="max-w-[980px] mx-auto px-4 md:px-8 py-24">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-4">Download</p>
    <h1 class="text-5xl md:text-[72px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Scarica Stentor.</h1>
    <p class="text-xl text-text-2 leading-[1.55] max-w-[720px] mb-8">Stentor Lite sara disponibile liberamente. Stentor Pro richiede un codice di attivazione.</p>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-hairline bg-surface p-6"><h2 class="text-2xl font-semibold mb-2">Stentor Lite</h2><p class="text-text-3">Download in preparazione.</p></div>
      <a class="rounded-2xl border border-red-500/25 bg-surface p-6 block" href="/it/richiedi-prova"><h2 class="text-2xl font-semibold mb-2">Stentor Pro</h2><p class="text-text-3">Richiedi accesso.</p></a>
    </div>
  </section>
</Layout>
