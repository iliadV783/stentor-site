---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Questionari pubblico - Stentor Admin" description="Area admin per consultare i questionari differiti pubblicati da Stentor." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-bg text-text relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(24, 88, 200,0.16)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_68%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_68%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[620px] h-[620px] rounded-full bg-stentor/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <header class="relative border-b border-hairline-strong">
      <div class="max-w-[1280px] mx-auto px-5 md:px-8 h-20 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-3 text-text hover:text-text-2 transition-colors">
          <span class="font-semibold tracking-[-0.04em] text-xl">STENTOR</span>
          <span class="text-text-2 text-sm">Admin</span>
        </a>
        <div class="flex items-center gap-3">
          <span data-admin-email class="hidden sm:inline-flex h-9 items-center px-3 rounded-full border border-hairline-strong bg-surface-2 text-text-2 text-xs font-mono uppercase tracking-[0.12em]">Admin area</span>
          <a href="/admin" class="admin-top-link">Admin console</a>
          <a href="/admin/feedback/" class="admin-top-link">Feedback</a>
          <button data-admin-refresh hidden class="admin-top-link">Aggiorna</button>
          <button data-admin-logout hidden class="admin-top-link">Logout</button>
        </div>
      </div>
    </header>

    <main class="relative max-w-[1280px] mx-auto px-5 md:px-8 py-10 md:py-14">
      <section data-admin-login hidden class="max-w-[680px] mx-auto rounded-2xl border border-hairline-strong bg-surface-2 backdrop-blur-sm p-7 md:p-8">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-3">Admin login</p>
        <h1 class="text-4xl md:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-4">Accedi ai questionari.</h1>
        <p class="text-text-2 leading-[1.6] mb-7">Usa il tuo account autorizzato per consultare questionari differiti e risposte anonime raccolte su stentor.live.</p>
        <form data-admin-login-form class="grid gap-4">
          <input name="email" type="email" autocomplete="email" placeholder="name@stentor.live" class="survey-admin-input h-12" required />
          <input name="password" type="password" autocomplete="current-password" placeholder="Password" class="survey-admin-input h-12" />
          <button type="submit" class="h-13 rounded-xl bg-stentor text-white font-semibold hover:bg-stentor-dark transition-colors">Accedi</button>
          <button type="button" data-admin-magic-link class="h-12 rounded-xl border border-hairline-strong text-text-2 hover:text-text hover:bg-surface-2 transition-colors">Invia link via email</button>
        </form>
        <p data-admin-error hidden class="mt-5 rounded-xl border border-stentor/30 bg-stentor/10 text-stentor text-sm leading-[1.5] p-4"></p>
      </section>

      <section data-admin-app hidden class="grid gap-6">
        <div class="rounded-2xl border border-hairline-strong bg-surface-2 backdrop-blur-sm p-6 md:p-7">
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-3">Questionari differiti</p>
          <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
            <div>
              <h1 class="text-4xl md:text-6xl tracking-[-0.06em] leading-[0.98] font-semibold mb-4">Risposte anonime degli spettatori.</h1>
              <p class="text-text-2 leading-[1.6] max-w-[820px]">Clicca un questionario per aprire una pagina dedicata, più leggibile della vecchia sidebar laterale.</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button data-filter="all" class="survey-filter is-active">Tutti</button>
              <button data-filter="open" class="survey-filter">Aperti</button>
              <button data-filter="closed" class="survey-filter">Chiusi</button>
            </div>
          </div>
        </div>

        <div data-admin-stats class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>
        <div data-admin-message hidden class="rounded-2xl border border-stentor/25 bg-stentor/10 text-stentor p-5 leading-[1.6]"></div>

        <section class="rounded-2xl border border-hairline-strong bg-surface-2 backdrop-blur-sm overflow-hidden">
          <div class="p-5 md:p-6 border-b border-hairline-strong flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-text-2 mb-2">Pubblicazioni</p>
              <h2 class="text-2xl font-semibold tracking-[-0.04em]">Questionari pubblicati</h2>
            </div>
            <input data-admin-search type="search" placeholder="Cerca spettacolo, compagnia, token..." class="survey-admin-input h-11 sm:w-[360px]" />
          </div>
          <div data-admin-table class="overflow-auto"></div>
        </section>
      </section>
    </main>
  </section>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  .admin-top-link { @apply inline-flex items-center justify-center h-10 px-4 rounded-xl border border-hairline-strong text-sm text-text-2 hover:text-text hover:bg-surface-2 transition-colors; }
  .survey-admin-input { @apply rounded-xl bg-surface-2 border border-hairline-strong px-4 text-text placeholder:text-text-2 outline-none focus:border-stentor/50; }
  .survey-filter { @apply h-10 px-4 rounded-full border border-hairline-strong text-sm text-text-2 bg-surface-2 hover:text-text hover:bg-surface-2 transition-colors; }
  .survey-filter.is-active { @apply text-text bg-stentor/15 border-stentor/30; }
</style>

<script>
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const storageKey = 'stentor_account_access_token';

  const loginPanel = document.querySelector('[data-admin-login]');
  const appPanel = document.querySelector('[data-admin-app]');
  const loginForm = document.querySelector('[data-admin-login-form]');
  const errorBox = document.querySelector('[data-admin-error]');
  const emailBadge = document.querySelector('[data-admin-email]');
  const logoutButton = document.querySelector('[data-admin-logout]');
  const magicButton = document.querySelector('[data-admin-magic-link]');
  const refreshButton = document.querySelector('[data-admin-refresh]');
  const statsTarget = document.querySelector('[data-admin-stats]');
  const tableTarget = document.querySelector('[data-admin-table]');
  const messageBox = document.querySelector('[data-admin-message]');
  const searchInput = document.querySelector('[data-admin-search]');
  const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));

  let allSurveys = [];
  let currentFilter = 'all';

  function getTokenFromHash() {
    const hash = new URLSearchParams(window.location.hash.replace(/^#/, ''));
    const token = hash.get('access_token');
    if (token) {
      localStorage.setItem(storageKey, token);
      history.replaceState(null, '', window.location.pathname);
    }
    return token;
  }

  function getStoredToken() {
    return getTokenFromHash() || localStorage.getItem(storageKey) || '';
  }

  async function readError(response, fallback) {
    try {
      const body = await response.json();
      return body.msg || body.message || body.error_description || body.error || fallback;
    } catch {
      return fallback;
    }
  }

  function showError(message) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  function showMessage(message) {
    if (!messageBox) return;
    messageBox.textContent = message;
    messageBox.hidden = !message;
  }

  async function apiFetch(path, token, options = {}) {
    const response = await fetch(`${supabaseUrl}${path}`, {
      ...options,
      headers: {
        apikey: supabaseAnonKey,
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
        ...(options.headers || {}),
      },
    });
    if (!response.ok) throw new Error(await readError(response, 'Request failed.'));
    return response.json();
  }

  async function signInWithPassword(email, password) {
    const response = await fetch(`${supabaseUrl}/auth/v1/token?grant_type=password`, {
      method: 'POST',
      headers: { apikey: supabaseAnonKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    if (!response.ok) throw new Error(await readError(response, 'Login failed.'));
    const body = await response.json();
    localStorage.setItem(storageKey, body.access_token);
    return body.access_token;
  }

  async function sendMagicLink(email) {
    const redirectTo = `${window.location.origin}/auth/confirm?next=/admin/surveys`;
    const response = await fetch(`${supabaseUrl}/auth/v1/otp?redirect_to=${encodeURIComponent(redirectTo)}`, {
      method: 'POST',
      headers: { apikey: supabaseAnonKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, create_user: false }),
    });
    if (!response.ok) throw new Error(await readError(response, 'Email link could not be sent.'));
  }

  function escapeHTML(value) {
    return String(value ?? '').replace(/[&<>'"]/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
    }[char]));
  }

  function formatDate(value) {
    if (!value) return '—';
    try {
      return new Intl.DateTimeFormat('it-IT', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
    } catch {
      return value;
    }
  }

  function isOpen(row) {
    const now = Date.now();
    const opens = row.opens_at ? Date.parse(row.opens_at) : null;
    const closes = row.closes_at ? Date.parse(row.closes_at) : null;
    return row.is_active !== false && (!opens || now >= opens) && (!closes || now <= closes);
  }

  function detailUrl(row) {
    return `/admin/surveys/detail?id=${encodeURIComponent(row.id)}`;
  }

  function filteredSurveys() {
    const query = String(searchInput?.value || '').trim().toLowerCase();
    return allSurveys.filter((row) => {
      const open = isOpen(row);
      if (currentFilter === 'open' && !open) return false;
      if (currentFilter === 'closed' && open) return false;
      if (!query) return true;
      return [row.title, row.company_name, row.venue, row.public_token, row.survey_id].join(' ').toLowerCase().includes(query);
    });
  }

  function renderStats() {
    if (!statsTarget) return;
    const total = allSurveys.length;
    const open = allSurveys.filter(isOpen).length;
    const responses = allSurveys.reduce((sum, row) => sum + Number(row.responses_count || 0), 0);
    const last = allSurveys.map((row) => row.last_response_at).filter(Boolean).sort().at(-1);
    const cards = [
      ['Questionari', total],
      ['Aperti', open],
      ['Risposte', responses],
      ['Ultima risposta', formatDate(last)],
    ];
    statsTarget.innerHTML = cards.map(([label, value]) => `
      <article class="rounded-2xl border border-hairline-strong bg-surface-2 p-5">
        <div class="text-3xl font-semibold tracking-[-0.05em] mb-1">${escapeHTML(value)}</div>
        <div class="text-text-2 text-sm">${escapeHTML(label)}</div>
      </article>
    `).join('');
  }

  function renderTable() {
    const rows = filteredSurveys();
    renderStats();
    if (!tableTarget) return;
    if (!rows.length) {
      tableTarget.innerHTML = '<div class="p-6 text-text-2">Nessun questionario corrisponde ai filtri attuali.</div>';
      return;
    }
    tableTarget.innerHTML = `
      <table class="w-full table-fixed text-left text-sm">
        <thead class="sticky top-0 z-10 bg-surface-2 text-text-2 border-b border-hairline-strong">
          <tr>
            <th class="font-medium px-5 py-3 whitespace-nowrap w-[190px]">Creato</th>
            <th class="font-medium px-5 py-3 whitespace-nowrap">Questionario</th>
            <th class="font-medium px-5 py-3 whitespace-nowrap w-[110px]">Stato</th>
            <th class="font-medium px-5 py-3 whitespace-nowrap w-[100px]">Risposte</th>
            <th class="font-medium px-5 py-3 whitespace-nowrap w-[180px]">Scadenza</th>
            <th class="font-medium px-5 py-3 whitespace-nowrap w-[150px]">Dettaglio</th>
          </tr>
        </thead>
        <tbody>
          ${rows.map((row) => `
            <tr data-row-link="${escapeHTML(detailUrl(row))}" class="border-b border-hairline-strong cursor-pointer hover:bg-surface-2">
              <td class="px-5 py-4 text-text-2 whitespace-nowrap">${escapeHTML(formatDate(row.created_at))}</td>
              <td class="px-5 py-4 min-w-0"><div class="text-text font-medium truncate">${escapeHTML(row.title || 'Senza titolo')}</div><div class="text-text-2 text-xs truncate">${escapeHTML(row.company_name || row.public_token || '—')}</div></td>
              <td class="px-5 py-4 whitespace-nowrap">${isOpen(row) ? '<span class="text-emerald-300">Aperto</span>' : '<span class="text-text-2">Chiuso</span>'}</td>
              <td class="px-5 py-4 whitespace-nowrap text-text-2">${escapeHTML(row.responses_count ?? 0)}</td>
              <td class="px-5 py-4 whitespace-nowrap text-text-2">${escapeHTML(formatDate(row.closes_at))}</td>
              <td class="px-5 py-4 whitespace-nowrap"><a href="${escapeHTML(detailUrl(row))}" class="inline-flex h-9 items-center px-3 rounded-xl border border-hairline-strong text-text-2 hover:text-text hover:bg-surface-2">Apri dettaglio</a></td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }

  async function loadSurveys(token) {
    showMessage('');
    const user = await apiFetch('/auth/v1/user', token);
    if (emailBadge) emailBadge.textContent = user.email || 'Admin';
    const select = ['id','survey_id','public_token','title','company_name','venue','opens_at','closes_at','is_active','created_at','updated_at','responses_count','last_response_at'].join(',');
    allSurveys = await apiFetch(`/rest/v1/audience_surveys_admin_view?select=${encodeURIComponent(select)}&order=created_at.desc&limit=200`, token);
    renderTable();
    if (loginPanel) loginPanel.hidden = true;
    if (appPanel) appPanel.hidden = false;
    if (logoutButton) logoutButton.hidden = false;
    if (refreshButton) refreshButton.hidden = false;
  }

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorBox) errorBox.hidden = true;
    const formData = new FormData(loginForm);
    const email = String(formData.get('email') || '').trim();
    const password = String(formData.get('password') || '');
    if (!email) return showError('Inserisci la tua email.');
    if (!password) return showError('Inserisci la password, oppure usa il link via email.');
    try {
      const token = await signInWithPassword(email, password);
      await loadSurveys(token);
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Accesso non riuscito.');
    }
  });

  magicButton?.addEventListener('click', async () => {
    if (errorBox) errorBox.hidden = true;
    const formData = new FormData(loginForm);
    const email = String(formData.get('email') || '').trim();
    if (!email) return showError('Inserisci la tua email.');
    try {
      await sendMagicLink(email);
      showError('Link inviato. Controlla la posta e torna qui.');
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Invio link non riuscito.');
    }
  });

  logoutButton?.addEventListener('click', () => {
    localStorage.removeItem(storageKey);
    window.location.reload();
  });

  refreshButton?.addEventListener('click', async () => {
    const token = getStoredToken();
    if (token) await loadSurveys(token);
  });

  searchInput?.addEventListener('input', () => renderTable());

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      currentFilter = button.getAttribute('data-filter') || 'all';
      filterButtons.forEach((item) => item.classList.toggle('is-active', item === button));
      renderTable();
    });
  });

  document.addEventListener('click', (event) => {
    const link = event.target.closest?.('a');
    if (link) return;
    const row = event.target.closest?.('[data-row-link]');
    if (!row) return;
    window.location.href = row.getAttribute('data-row-link');
  });

  (async () => {
    if (!supabaseUrl || !supabaseAnonKey) {
      showError('Configura PUBLIC_SUPABASE_URL e PUBLIC_SUPABASE_ANON_KEY nelle variabili ambiente del sito.');
      if (loginPanel) loginPanel.hidden = false;
      return;
    }
    const token = getStoredToken();
    if (!token) {
      if (loginPanel) loginPanel.hidden = false;
      return;
    }
    try {
      await loadSurveys(token);
    } catch (error) {
      localStorage.removeItem(storageKey);
      if (loginPanel) loginPanel.hidden = false;
      showError(error instanceof Error ? error.message : 'Accesso non riuscito.');
    }
  })();
</script>
