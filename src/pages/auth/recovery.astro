---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Account recovery - Stentor" description="Recover Stentor account access." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <main class="relative min-h-screen flex items-center justify-center px-5 py-16">
      <div class="w-full max-w-[620px] rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-8 sm:p-10 shadow-2xl shadow-red-950/10">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-4">Stentor admin</p>
        <h1 class="text-4xl sm:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-5">Account recovery.</h1>
        <p class="text-white/55 leading-[1.65] mb-8">Pagina tecnica per completare il recupero account Stentor.</p>
        <a href="/admin" class="h-12 px-5 rounded-xl bg-red-500 text-black font-semibold inline-flex items-center justify-center hover:bg-red-400 transition-colors">Vai ad admin</a>
      </div>
    </main>
  </section>
</Layout>
