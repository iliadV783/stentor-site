---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Accesso confermato - Sténtor" description="Conferma l’accesso a Sténtor." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-bg text-text relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(24, 88, 200,0.20)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[560px] h-[560px] rounded-full bg-stentor/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <main class="relative min-h-screen flex items-center justify-center px-5 py-16">
      <div class="w-full max-w-[620px] rounded-2xl border border-hairline-strong bg-surface-2 backdrop-blur-sm p-8 sm:p-10 text-center shadow-2xl shadow-stentor-dark/10">
        <div data-confirm-icon class="mx-auto w-14 h-14 rounded-full bg-green-400/10 border border-green-400/25 flex items-center justify-center text-green-300 mb-6">✓</div>
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-4">Account Sténtor</p>
        <h1 data-confirm-title class="text-4xl sm:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-5">Accesso confermato.</h1>
        <p data-confirm-message class="text-text-2 leading-[1.65] max-w-[460px] mx-auto">La sessione è stata confermata. Puoi continuare con l’attivazione dell’invito.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
          <a data-confirm-link href="/admin" class="h-12 px-5 rounded-xl bg-stentor text-white font-semibold inline-flex items-center justify-center hover:bg-stentor-dark transition-colors cursor-pointer">Continua</a>
          <a href="/" class="h-12 px-5 rounded-xl border border-hairline-strong text-text-2 inline-flex items-center justify-center hover:text-text hover:bg-surface-2 transition-colors cursor-pointer">Torna al sito</a>
        </div>
      </div>
    </main>
  </section>
</Layout>

<script>
  const params = new URLSearchParams(window.location.hash.replace(/^#/, ''));
  const token = params.get('access_token');
  const error = params.get('error_description') || params.get('error');
  const next = new URLSearchParams(window.location.search).get('next') || '/admin';

  const title = document.querySelector('[data-confirm-title]');
  const message = document.querySelector('[data-confirm-message]');
  const link = document.querySelector('[data-confirm-link]');
  const icon = document.querySelector('[data-confirm-icon]');

  function tokenStorageKeyFor(path) {
    if (path.startsWith('/account') || path.startsWith('/invite/')) return 'stentor_account_access_token';
    return 'stentor_admin_access_token';
  }

  if (token) {
    localStorage.setItem(tokenStorageKeyFor(next), token);
    history.replaceState(null, '', window.location.pathname + window.location.search);
    if (link instanceof HTMLAnchorElement) link.href = next;
    if (next.startsWith('/account') && message) {
      message.textContent = 'La sessione è stata confermata. Puoi continuare nel tuo account Sténtor.';
    } else if (next.startsWith('/invite/') && message) {
      message.textContent = 'La sessione è stata confermata. Continua per completare l’attivazione dell’invito.';
    }
  } else if (error) {
    if (title) title.textContent = 'Link scaduto.';
    if (message) message.textContent = 'Il link di accesso non è valido o è scaduto. Torna alla pagina dell’invito e richiedi un nuovo link.';
    if (link instanceof HTMLAnchorElement) {
      link.href = next.startsWith('/account') ? '/account' : '/';
      link.textContent = next.startsWith('/account') ? 'Torna all’account' : 'Torna al sito';
    }
    if (icon) {
      icon.textContent = '!';
      icon.className = 'mx-auto w-14 h-14 rounded-full bg-stentor/10 border border-stentor/25 flex items-center justify-center text-stentor mb-6';
    }
  }
</script>
