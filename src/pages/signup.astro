---
import Layout from "../layouts/Layout.astro";
import Btn from "../components/Btn.astro";
---

<Layout title="Download Sténtor" description="Download Sténtor. Free to try, no account required." noindex>
  <section class="max-w-[760px] mx-auto px-4 md:px-8 py-24 md:py-32">
    <p class="font-mono text-xs tracking-[0.08em] uppercase text-red-500 mb-4">Download</p>
    <h1 class="text-5xl md:text-[64px] tracking-[-0.06em] leading-[0.98] font-semibold mb-5">Download Sténtor freely.</h1>
    <p class="text-lg text-text-2 leading-[1.6] mb-8">
      Sténtor no longer asks you to fill in a form before downloading. Go straight to the download page, try the software, and share field notes only if you use it in rehearsal or performance.
    </p>
    <div class="flex flex-wrap gap-3">
      <Btn href="/download" variant="primary">Go to download</Btn>
      <Btn href="/contact" variant="ghost">Share field notes</Btn>
    </div>
  </section>
</Layout>
