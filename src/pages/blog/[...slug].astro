---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Eyebrow from "../../components/Eyebrow.astro";

import IllusRegionMap from "../../assets/illustrations/region-map.svg";
import IllusPolicyHexagon from "../../assets/illustrations/policy-hexagon.svg";
import IllusP95Ring from "../../assets/illustrations/p95-ring.svg";
import IllusTrafficChart from "../../assets/illustrations/traffic-line-chart.svg";
import IllusPostgres from "../../assets/illustrations/iso-bento-postgres.svg";
import IllusTypes from "../../assets/illustrations/iso-bento-types.svg";
import IllusPulse from "../../assets/illustrations/iso-bento-pulse-arc.svg";
import IllusDeploy from "../../assets/illustrations/iso-bento-deploy-branch.svg";

import IconArrowLeft from "../../assets/icons/arrow-left.svg";
import IconArrowRight from "../../assets/icons/arrow-right.svg";

import { blog } from "../../data/blog";

const coverMap = {
  "region-map": IllusRegionMap,
  "policy-hexagon": IllusPolicyHexagon,
  "p95-ring": IllusP95Ring,
  "traffic-line-chart": IllusTrafficChart,
  "iso-postgres": IllusPostgres,
  "iso-types": IllusTypes,
  "iso-pulse": IllusPulse,
  "iso-deploy": IllusDeploy,
} as const;

const coverTints: Record<string, string> = {
  engineering: "rgba(96,165,250,0.16)",
  product: "rgba(239,68,68,0.18)",
  company: "rgba(251,191,36,0.16)",
  tutorial: "rgba(74,222,128,0.14)",
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const all = await getCollection("blog");
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const related = sorted
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);
const fallback = sorted.filter((p) => p.id !== post.id).slice(0, 2);
const relatedPosts = related.length > 0 ? related : fallback;

const Cover = post.data.cover ? coverMap[post.data.cover] : null;
const style = blog.categoryStyles[post.data.category];
const tint = coverTints[post.data.category];

const fmtDate = (d: Date) =>
  d.toLocaleString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Layout
  title={`${post.data.title} — Lambda Blog`}
  description={post.data.description}
  active={null}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  author={post.data.author.name}
>

  <!-- Header -->
  <section class="relative overflow-hidden border-b border-hairline pt-20 pb-14">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.28)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top,transparent_5%,#000_60%)] [mask-image:linear-gradient(to_top,transparent_5%,#000_60%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[820px] mx-auto px-4 md:px-8">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-[13px] text-text-3 hover:text-text mb-6 transition-colors">
        <IconArrowLeft class="w-3.5 h-3.5 stroke-2" />
        Back to all posts
      </a>

      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span class={`inline-flex items-center gap-1.5 font-mono text-[11px] tracking-[0.06em] uppercase px-2.5 py-1 rounded-full border ${style.tag}`}>
          <span class={`w-1.5 h-1.5 rounded-full ${style.dot}`}></span>
          {post.data.category}
        </span>
        <span class="font-mono text-[12px] text-text-3">
          {fmtDate(post.data.date)} · {post.data.readingTime}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-[48px] leading-[1.08] tracking-[-0.035em] font-semibold mb-5">{post.data.title}</h1>
      <p class="text-lg leading-[1.55] text-text-2 max-w-[640px] m-0">{post.data.description}</p>

      <!-- Author -->
      <div class="flex items-center gap-3 mt-8 pt-6 border-t border-dashed border-hairline">
        <div class="w-10 h-10 rounded-full grid place-items-center font-mono text-[12px] text-text border border-hairline-strong bg-gradient-to-br from-raised to-sunken">
          {post.data.author.initials}
        </div>
        <div class="text-[13.5px]">
          <b class="block font-medium">{post.data.author.name}</b>
          <span class="text-text-3">{post.data.author.role}</span>
        </div>
        {post.data.tags && (
          <div class="ml-auto hidden sm:flex flex-wrap gap-1.5">
            {post.data.tags.map((t) => (
              <span class="font-mono text-[11px] px-2 py-0.5 rounded-sm bg-white/[0.04] text-text-3 border border-hairline">#{t}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Cover illustration (optional) -->
  {Cover && (
    <section class="border-b border-hairline">
      <div class="max-w-[1100px] mx-auto px-4 md:px-8 py-10">
        <div class="relative aspect-[16/7] bg-deep border border-hairline rounded-xl overflow-hidden" style={`background: radial-gradient(ellipse 60% 80% at 50% 50%, ${tint}, var(--color-deep) 70%);`}>
          <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:48px_48px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
          <Cover class="absolute inset-0 w-full h-full" />
        </div>
      </div>
    </section>
  )}

  <!-- Article body -->
  <div class="max-w-[820px] mx-auto px-4 md:px-8 py-14">
    <article class="post-prose">
      <Content />
    </article>

    <!-- Share / next CTA -->
    <div class="flex flex-wrap items-center justify-between gap-4 mt-14 pt-8 border-t border-hairline">
      <div class="text-[13px] text-text-3">
        Liked this post? Forward it to a teammate.
      </div>
      <div class="inline-flex gap-3">
        <a href="#" class="text-[13px] text-text-2 hover:text-text transition-colors">Share on X</a>
        <a href="#" class="text-[13px] text-text-2 hover:text-text transition-colors">Discuss on HN</a>
        <a href="#" class="text-[13px] text-text-2 hover:text-text transition-colors">Copy link</a>
      </div>
    </div>
  </div>

  <!-- Related posts -->
  {relatedPosts.length > 0 && (
    <section class="border-t border-hairline py-16 bg-bg/40">
      <div class="max-w-[1100px] mx-auto px-4 md:px-8">
        <div class="flex items-end justify-between mb-8 gap-4">
          <h2 class="text-2xl md:text-[28px] tracking-[-0.025em] font-semibold">{blog.relatedTitle}</h2>
          <a href="/blog" class="text-[13px] text-red-500 font-medium hover:underline">All posts →</a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {relatedPosts.map((p) => {
            const RC = p.data.cover ? coverMap[p.data.cover] : null;
            const ps = blog.categoryStyles[p.data.category];
            const pt = coverTints[p.data.category];
            return (
              <a href={`/blog/${p.id}/`} class="group flex flex-col border border-hairline rounded-xl bg-surface overflow-hidden hover:border-hairline-strong transition-colors">
                <div class="relative aspect-[16/9] bg-deep border-b border-hairline overflow-hidden" style={`background: radial-gradient(ellipse 70% 90% at 50% 60%, ${pt}, var(--color-deep) 70%);`}>
                  <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:40px_40px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
                  {RC && <RC class="absolute inset-0 w-full h-full" />}
                  <span class={`absolute top-3.5 left-3.5 inline-flex items-center gap-1.5 font-mono text-[10.5px] tracking-[0.06em] uppercase px-2 py-0.5 rounded-full border ${ps.tag}`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${ps.dot}`}></span>
                    {p.data.category}
                  </span>
                </div>
                <div class="p-5 flex flex-col gap-2.5 flex-1">
                  <span class="font-mono text-[11.5px] text-text-3">{fmtDate(p.data.date)} · {p.data.readingTime}</span>
                  <h3 class="text-[17px] tracking-[-0.02em] font-semibold leading-[1.25] group-hover:text-red-500 transition-colors">{p.data.title}</h3>
                  <p class="text-[13px] leading-[1.55] text-text-3 m-0 line-clamp-2">{p.data.description}</p>
                  <span class="inline-flex items-center gap-1.5 text-red-500 text-[13px] font-medium mt-auto pt-3">
                    Read <IconArrowRight class="w-3.5 h-3.5 [stroke-width:2.2] transition-transform group-hover:translate-x-0.5" />
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="border-t border-hairline py-16">
    <div class="max-w-[1100px] mx-auto px-4 md:px-8 text-center grid justify-items-center gap-4">
      <Eyebrow><span class="font-mono">{blog.finalCta.eyebrow}</span></Eyebrow>
      <h2 class="text-3xl md:text-[34px] tracking-[-0.03em] font-semibold leading-[1.1] max-w-[600px]">{blog.finalCta.title}</h2>
      <p class="text-[15px] leading-[1.6] text-text-2 max-w-[480px]">{blog.finalCta.body}</p>
      <form action="javascript:void(0)" class="flex flex-wrap items-center border border-hairline rounded-lg bg-surface overflow-hidden max-w-[420px] w-full mt-2">
        <input type="email" aria-label="Email address" placeholder={blog.finalCta.placeholder} class="flex-1 min-w-[180px] bg-transparent border-0 outline-0 text-text font-sans text-sm px-3.5 h-11 placeholder:text-text-3" />
        <button type="submit" class="h-11 px-5 border-0 bg-red-500 text-bg font-medium text-sm whitespace-nowrap hover:bg-red-400 transition-colors">{blog.finalCta.submitLabel}</button>
      </form>
    </div>
  </section>

</Layout>

<style is:global>
  /* Long-form post body. Renders the MDX <Content /> output of any blog post.
     Namespaced under .post-prose so it doesn't collide with .legal-prose or
     the changelog .cl-prose. */

  .post-prose {
    color: var(--color-text-2);
    font-size: 16.5px;
    line-height: 1.7;
  }

  .post-prose > * + * { margin-top: 1rem; }

  .post-prose h2 {
    color: var(--color-text);
    font-size: 1.6rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .post-prose h3 {
    color: var(--color-text);
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.4rem;
  }
  .post-prose p {
    margin: 0;
  }
  .post-prose strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .post-prose em {
    color: var(--color-text);
    font-style: italic;
  }
  .post-prose a {
    color: #ef4444;
    text-decoration: none;
    border-bottom: 1px solid rgba(239, 68, 68, 0.4);
    transition: border-color 0.15s;
  }
  .post-prose a:hover { border-bottom-color: #ef4444; }

  .post-prose ul,
  .post-prose ol {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .post-prose ul { list-style: none; padding-left: 0; }
  .post-prose ul > li {
    position: relative;
    padding-left: 1.25rem;
  }
  .post-prose ul > li::before {
    content: "";
    position: absolute;
    left: 0.4rem;
    top: 0.7em;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-text-4);
  }
  .post-prose ol { list-style: decimal; }
  .post-prose li { padding-left: 0.25rem; }

  .post-prose code {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 1px 6px;
    border-radius: 2px;
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.18);
  }

  .post-prose pre {
    background: var(--color-deep);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    margin: 1.25rem 0;
  }
  .post-prose pre code {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--color-text);
    font-size: inherit;
  }

  .post-prose blockquote {
    border-left: 2px solid #ef4444;
    padding: 0.4rem 0 0.4rem 1.1rem;
    color: var(--color-text);
    font-style: italic;
    margin: 1.5rem 0;
  }

  .post-prose hr {
    border: 0;
    border-top: 1px dashed var(--color-hairline);
    margin: 2.5rem 0;
  }
</style>
