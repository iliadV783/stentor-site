---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Accetta invito - Sténtor" description="Accetta un invito alla sperimentazione di Sténtor." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.20)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[560px] h-[560px] rounded-full bg-red-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <main class="relative min-h-screen flex items-center justify-center px-5 py-16">
      <div class="w-full max-w-[760px] rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm p-8 sm:p-10 shadow-2xl shadow-red-950/10">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-4">Invito Sténtor</p>
        <h1 data-invite-title class="text-4xl sm:text-5xl tracking-[-0.055em] leading-[1] font-semibold mb-5">Attiva il tuo accesso.</h1>
        <div data-invite-message class="space-y-4 text-white/55 leading-[1.65] max-w-[650px]">
          <p>Hai ricevuto un invito a provare Sténtor. Stiamo conducendo una fase di sperimentazione con teatri, festival e professionisti dello spettacolo dal vivo per capire come il software possa adattarsi meglio al lavoro reale di produzione, regia, accessibilità e soprattitolazione.</p>
          <p>L’attivazione crea un accesso valido per 6 mesi. In questo periodo ti chiediamo semplicemente di usare Sténtor, esplorarlo nel tuo contesto e, se vorrai, condividere impressioni, necessità o difficoltà incontrate.</p>
          <p>La scadenza serve solo a dare un perimetro alla fase di prova. L’uso di Sténtor è gratuito: anche dopo la sperimentazione potrai continuare a usare il software liberamente.</p>
        </div>

        <div data-invite-confirm-panel hidden class="mt-8 grid gap-3 max-w-[560px]">
          <p class="text-white/48 text-sm leading-[1.55]">Per proteggere l’accesso, ti invieremo un link di conferma all’indirizzo email associato a questo invito. Dopo averlo aperto tornerai qui per completare l’attivazione.</p>
          <button data-invite-confirm-submit type="button" class="h-12 px-7 rounded-xl bg-red-500 text-black font-semibold inline-flex items-center justify-center hover:bg-red-400 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-wait">Inviami il link di conferma</button>
        </div>

        <div data-invite-result class="mt-6"></div>
        <div class="flex flex-col sm:flex-row items-center gap-3 mt-8">
          <button data-invite-accept type="button" class="h-12 px-7 rounded-xl bg-red-500 text-black font-semibold inline-flex items-center justify-center hover:bg-red-400 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-wait">Accetta invito</button>
          <a href="/" class="h-12 px-5 rounded-xl border border-white/10 text-white/40 inline-flex items-center justify-center hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer">Torna al sito</a>
        </div>
      </div>
    </main>
  </section>
</Layout>

<script>
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const sessionStorageKey = "stentor_admin_access_token";
  const downloadUrl = "https://www.stentor.live/download/";
  const inviteToken = new URLSearchParams(window.location.search).get("token") || "";

  const title = document.querySelector("[data-invite-title]");
  const message = document.querySelector("[data-invite-message]");
  const button = document.querySelector("[data-invite-accept]");
  const confirmPanel = document.querySelector("[data-invite-confirm-panel]");
  const confirmSubmit = document.querySelector("[data-invite-confirm-submit]");
  const result = document.querySelector("[data-invite-result]");

  function showResult(html) {
    if (result) result.innerHTML = html;
  }

  function showSignedOutState() {
    if (button) button.hidden = true;
    if (confirmPanel instanceof HTMLElement) confirmPanel.hidden = false;
  }

  function showSignedInState() {
    if (button) button.hidden = false;
    if (confirmPanel instanceof HTMLElement) confirmPanel.hidden = true;
  }

  async function readError(response, fallback) {
    try {
      const body = await response.json();
      return body.msg || body.message || body.error_description || body.error || fallback;
    } catch {
      return fallback;
    }
  }

  async function sendAccessLink() {
    const nextPath = `${window.location.pathname}${window.location.search}`;
    const redirectTo = `${window.location.origin}/auth/confirm?next=${encodeURIComponent(nextPath)}`;
    const response = await fetch(`${supabaseUrl}/functions/v1/send-invite-access-link`, {
      method: "POST",
      headers: {
        apikey: supabaseAnonKey,
        Authorization: `Bearer ${supabaseAnonKey}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        token: inviteToken,
        redirect_to: redirectTo,
      }),
    });

    if (!response.ok) {
      throw new Error(await readError(response, "Non è stato possibile inviare il link di conferma."));
    }

    const body = await response.json();
    if (!body.ok) throw new Error(body.error || "Non è stato possibile inviare il link di conferma.");
  }

  async function acceptInvite(sessionToken) {
    const response = await fetch(`${supabaseUrl}/functions/v1/accept-invite`, {
      method: "POST",
      headers: {
        apikey: supabaseAnonKey,
        Authorization: `Bearer ${sessionToken}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ token: inviteToken }),
    });

    if (!response.ok) {
      throw new Error(await readError(response, "Invito non accettato."));
    }

    const body = await response.json();

    if (!body.ok) {
      throw new Error(body.error || "Invito non accettato.");
    }

    return body;
  }

  if (!inviteToken) {
    if (title) title.textContent = "Invito mancante.";
    if (message) {
      message.innerHTML = `<p>Il link non contiene un token valido. Chiedi un nuovo invito a chi ti ha invitato a provare Sténtor.</p>`;
    }
    if (button) button.hidden = true;
    if (confirmPanel instanceof HTMLElement) confirmPanel.hidden = true;
  } else if (localStorage.getItem(sessionStorageKey)) {
    showSignedInState();
  } else {
    showSignedOutState();
  }

  confirmSubmit?.addEventListener("click", async () => {
    if (confirmSubmit instanceof HTMLButtonElement) {
      confirmSubmit.disabled = true;
      confirmSubmit.textContent = "Invio...";
    }
    showResult("");

    try {
      await sendAccessLink();
      showResult(`
        <div class="rounded-xl border border-green-400/20 bg-green-400/10 text-green-100 text-sm leading-[1.5] p-4">
          <strong class="block mb-2">Link inviato.</strong>
          <span class="text-white/60">Controlla la posta associata a questo invito e apri il link ricevuto. Tornerai qui per completare l’attivazione.</span>
        </div>
      `);
    } catch (error) {
      showResult(`
        <p class="rounded-xl border border-red-500/30 bg-red-500/10 text-red-200 text-sm leading-[1.5] p-4">
          ${error instanceof Error ? error.message : "Non è stato possibile inviare il link di conferma."}
        </p>
      `);
    } finally {
      if (confirmSubmit instanceof HTMLButtonElement) {
        confirmSubmit.disabled = false;
        confirmSubmit.textContent = "Inviami il link di conferma";
      }
    }
  });

  button?.addEventListener("click", async () => {
    const sessionToken = localStorage.getItem(sessionStorageKey) || "";

    if (!sessionToken) {
      showSignedOutState();
      showResult("");
      return;
    }

    button.disabled = true;
    button.textContent = "Attivazione...";
    showResult("");

    try {
      const body = await acceptInvite(sessionToken);
      const expiresAt = body.license?.expires_at
        ? new Date(body.license.expires_at).toLocaleDateString("it-IT")
        : "tra 6 mesi";

      if (title) title.textContent = "Invito accettato.";
      if (message) {
        message.innerHTML = `<p>L’accesso di sperimentazione a Sténtor è attivo fino al ${expiresAt}. Potrai continuare a usare il software liberamente anche dopo la sperimentazione.</p>`;
      }
      if (button) button.hidden = true;
      if (confirmPanel instanceof HTMLElement) confirmPanel.hidden = true;

      showResult(`
        <div class="rounded-xl border border-green-400/20 bg-green-400/10 text-green-100 text-sm leading-[1.5] p-4">
          <strong class="block mb-2">Accesso attivato.</strong>
          <span class="text-white/60">Grazie: il tuo uso di Sténtor ci aiuterà a migliorare questa fase di sperimentazione.</span>
          <div class="mt-4 flex flex-col sm:flex-row gap-3">
            <a href="${downloadUrl}" class="h-12 px-5 rounded-xl bg-red-500 text-black font-semibold inline-flex items-center justify-center hover:bg-red-400 transition-colors cursor-pointer">Scarica Sténtor</a>
            <a href="/" class="h-12 px-5 rounded-xl border border-white/10 text-white/65 inline-flex items-center justify-center hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer">Torna al sito</a>
          </div>
        </div>
      `);
    } catch (error) {
      showResult(`
        <p class="rounded-xl border border-red-500/30 bg-red-500/10 text-red-200 text-sm leading-[1.5] p-4">
          ${error instanceof Error ? error.message : "Attivazione non riuscita."}
        </p>
      `);
    } finally {
      button.disabled = false;
      button.textContent = "Accetta invito";
    }
  });
</script>
