---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Btn from "../components/Btn.astro";

import IllusRegionMap from "../assets/illustrations/region-map.svg";
import IllusPolicyHexagon from "../assets/illustrations/policy-hexagon.svg";
import IllusP95Ring from "../assets/illustrations/p95-ring.svg";
import IllusTrafficChart from "../assets/illustrations/traffic-line-chart.svg";
import IllusPostgres from "../assets/illustrations/iso-bento-postgres.svg";
import IllusTypes from "../assets/illustrations/iso-bento-types.svg";
import IllusPulse from "../assets/illustrations/iso-bento-pulse-arc.svg";
import IllusDeploy from "../assets/illustrations/iso-bento-deploy-branch.svg";

import { blog } from "../data/blog";

const coverMap = {
  "region-map": IllusRegionMap,
  "policy-hexagon": IllusPolicyHexagon,
  "p95-ring": IllusP95Ring,
  "traffic-line-chart": IllusTrafficChart,
  "iso-postgres": IllusPostgres,
  "iso-types": IllusTypes,
  "iso-pulse": IllusPulse,
  "iso-deploy": IllusDeploy,
} as const;

const coverTints: Record<string, string> = {
  engineering: "rgba(96,165,250,0.16)",
  product: "rgba(239,68,68,0.18)",
  company: "rgba(251,191,36,0.16)",
  tutorial: "rgba(74,222,128,0.14)",
};

const allPosts = await getCollection("blog");
const sorted = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
const rest = sorted.filter((p) => p.id !== featured?.id);

const fmtDate = (d: Date) =>
  d.toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Layout
  title="Blog — Lambda"
  description="Engineering deep-dives, product updates, and infrastructure stories from the team behind Lambda."
  active={null}
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-hairline pt-24 pb-16">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.35)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] [mask-image:linear-gradient(to_top_left,#000_5%,transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-[1280px] mx-auto px-4 md:px-8">
      <div class="max-w-[760px]">
        <Eyebrow><span class="font-mono">{blog.hero.eyebrow}</span></Eyebrow>
        <h1 class="text-4xl sm:text-5xl lg:text-[64px] leading-[1.02] tracking-[-0.04em] font-semibold mt-5 mb-4">{blog.hero.title}</h1>
        <p class="text-lg leading-[1.55] text-text-2 mb-7 max-w-[560px]">{blog.hero.description}</p>
        <form action="javascript:void(0)" class="flex flex-wrap items-center border border-hairline rounded-lg bg-surface overflow-hidden max-w-[440px]">
          <input type="email" aria-label="Email address" placeholder={blog.hero.emailPlaceholder} class="flex-1 min-w-[180px] bg-transparent border-0 outline-0 text-text font-sans text-sm px-3.5 h-11 placeholder:text-text-3" />
          <button type="submit" class="h-11 px-5 border-0 bg-red-500 text-bg font-medium text-sm whitespace-nowrap hover:bg-red-400 transition-colors">{blog.hero.subscribeLabel}</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Filter tabs -->
  <div class="sticky top-16 z-10 border-b border-hairline bg-bg/60 backdrop-blur-md" x-data="{f:'all'}">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 h-14 flex items-center gap-4 overflow-x-auto">
      <div class="flex gap-1">
        {blog.categories.map((c) => (
          <button
            @click={`f='${c.id}'`}
            :class={`f==='${c.id}' ? 'bg-red-500/[0.08] border-red-500/25 text-red-500' : 'border-transparent text-text-2 hover:text-text'`}
            class="h-8 px-3 rounded-md border text-[13px] whitespace-nowrap transition-colors"
          >{c.label}</button>
        ))}
      </div>
      <span class="ml-auto hidden sm:inline-block font-mono text-xs text-text-3">{sorted.length} posts</span>
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-14 md:py-16">

    <!-- Featured post -->
    {featured && (() => {
      const FeatCover = featured.data.cover ? coverMap[featured.data.cover] : null;
      const featStyle = blog.categoryStyles[featured.data.category];
      const tint = coverTints[featured.data.category];
      return (
        <a href={`/blog/${featured.id}/`} class="group block border border-hairline rounded-xl bg-surface overflow-hidden mb-14 grid grid-cols-1 lg:[grid-template-columns:1.05fr_1fr] hover:border-hairline-strong transition-colors">
          <div class="relative bg-deep border-b lg:border-b-0 lg:border-r border-hairline overflow-hidden aspect-[16/9] lg:aspect-auto lg:min-h-[360px]" style={`background: radial-gradient(ellipse 60% 80% at 50% 50%, ${tint}, var(--color-deep) 70%);`}>
            <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:48px_48px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
            {FeatCover && <FeatCover class="absolute inset-0 w-full h-full" />}
            <span class={`absolute top-5 left-5 inline-flex items-center gap-1.5 font-mono text-[11px] tracking-[0.06em] uppercase px-2.5 py-1 rounded-full border ${featStyle.tag}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${featStyle.dot}`}></span>
              Featured · {featured.data.category}
            </span>
          </div>
          <div class="p-8 lg:p-12 flex flex-col gap-4 justify-center">
            <span class="font-mono text-[12px] text-text-3">{fmtDate(featured.data.date)} · {featured.data.readingTime}</span>
            <h2 class="text-3xl md:text-[34px] lg:text-[40px] tracking-[-0.03em] font-semibold leading-[1.08] group-hover:text-red-500 transition-colors">{featured.data.title}</h2>
            <p class="text-[15.5px] leading-[1.6] text-text-2 max-w-[480px]">{featured.data.description}</p>
            <div class="flex items-center gap-3 mt-3 pt-5 border-t border-dashed border-hairline">
              <div class="w-9 h-9 rounded-full grid place-items-center font-mono text-xs text-text border border-hairline-strong bg-gradient-to-br from-raised to-sunken">
                {featured.data.author.initials}
              </div>
              <div class="text-[13px]">
                <b class="block font-medium">{featured.data.author.name}</b>
                <span class="text-text-3">{featured.data.author.role}</span>
              </div>
              <span class="ml-auto inline-flex items-center gap-1.5 text-red-500 text-[13px] font-medium">
                Read <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            </div>
          </div>
        </a>
      );
    })()}

    <!-- Post grid -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => {
        const Cover = post.data.cover ? coverMap[post.data.cover] : null;
        const style = blog.categoryStyles[post.data.category];
        const tint = coverTints[post.data.category];
        return (
          <a href={`/blog/${post.id}/`} class="group flex flex-col border border-hairline rounded-xl bg-surface overflow-hidden hover:border-hairline-strong transition-colors">
            <div class="relative aspect-[16/10] bg-deep border-b border-hairline overflow-hidden" style={`background: radial-gradient(ellipse 70% 90% at 50% 60%, ${tint}, var(--color-deep) 70%);`}>
              <div class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:40px_40px] [-webkit-mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_30%,transparent_80%)] pointer-events-none"></div>
              {Cover && <Cover class="absolute inset-0 w-full h-full" />}
              <span class={`absolute top-3.5 left-3.5 inline-flex items-center gap-1.5 font-mono text-[10.5px] tracking-[0.06em] uppercase px-2 py-0.5 rounded-full border ${style.tag}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${style.dot}`}></span>
                {post.data.category}
              </span>
            </div>
            <div class="p-5 flex flex-col gap-3 flex-1">
              <span class="font-mono text-[11.5px] text-text-3">{fmtDate(post.data.date)} · {post.data.readingTime}</span>
              <h3 class="text-[18px] tracking-[-0.02em] font-semibold leading-[1.25] group-hover:text-red-500 transition-colors">{post.data.title}</h3>
              <p class="text-[13.5px] leading-[1.55] text-text-3 m-0 line-clamp-3">{post.data.description}</p>
              <div class="flex items-center gap-2.5 mt-auto pt-4 border-t border-dashed border-hairline">
                <div class="w-7 h-7 rounded-full grid place-items-center font-mono text-[10px] text-text border border-hairline-strong bg-gradient-to-br from-raised to-sunken">
                  {post.data.author.initials}
                </div>
                <span class="text-[12.5px] text-text-2 font-medium">{post.data.author.name}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Load more -->
    <div class="mt-12 flex justify-center">
      <Btn href="#" variant="ghost">{blog.loadMore} <span aria-hidden="true">↓</span></Btn>
    </div>
  </div>

  <!-- Newsletter CTA -->
  <section class="border-t border-hairline py-20 bg-bg/40">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 text-center grid justify-items-center gap-5">
      <Eyebrow><span class="font-mono">{blog.finalCta.eyebrow}</span></Eyebrow>
      <h2 class="text-3xl md:text-4xl lg:text-[44px] tracking-[-0.035em] font-semibold leading-[1.1] max-w-[680px]">{blog.finalCta.title}</h2>
      <p class="text-[15.5px] leading-[1.6] text-text-2 max-w-[520px]">{blog.finalCta.body}</p>
      <form action="javascript:void(0)" class="flex flex-wrap items-center border border-hairline rounded-lg bg-surface overflow-hidden max-w-[440px] w-full mt-2">
        <input type="email" aria-label="Email address" placeholder={blog.finalCta.placeholder} class="flex-1 min-w-[180px] bg-transparent border-0 outline-0 text-text font-sans text-sm px-3.5 h-11 placeholder:text-text-3" />
        <button type="submit" class="h-11 px-5 border-0 bg-red-500 text-bg font-medium text-sm whitespace-nowrap hover:bg-red-400 transition-colors">{blog.finalCta.submitLabel}</button>
      </form>
      <p class="text-[12px] text-text-4 max-w-[420px]">{blog.finalCta.fineprint}</p>
    </div>
  </section>

</Layout>
