---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Request Sténtor Pro – Sténtor"
  description="Request a Sténtor Pro trial license for theatres, companies, festivals, schools and institutions."
  active={null}
  showNav={false}
  showFooter={false}
>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(239,68,68,0.22)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_62%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[560px] h-[560px] rounded-full bg-red-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <header class="relative max-w-[1120px] mx-auto px-5 md:px-8 py-7 flex items-center justify-between">
      <a href="/" class="inline-flex items-center gap-3 text-white hover:text-white/80 transition-colors" aria-label="Sténtor home"><span class="font-semibold tracking-[-0.04em] text-xl">STÉNTOR</span><span class="text-white/45 text-sm">Pro</span></a>
      <a href="/" class="inline-flex items-center gap-2 text-sm text-white/55 hover:text-white transition-colors"><span aria-hidden="true">←</span> Back to site</a>
    </header>

    <main class="relative max-w-[760px] mx-auto px-5 md:px-8 pt-10 pb-20">
      <div class="mb-10">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-4">Professional access</p>
        <h1 class="text-5xl sm:text-6xl lg:text-[72px] leading-[0.96] tracking-[-0.06em] font-semibold max-w-[650px]">Request Sténtor Pro.</h1>
        <p class="text-white/55 text-lg leading-[1.55] mt-6 max-w-[580px]">Trial licenses and professional access for theatres, companies, festivals, schools and institutions using Sténtor in production.</p>
        <p class="text-white/45 mt-4">Already have a license? <a href="/accesso" class="text-red-400 underline underline-offset-4 hover:text-red-300">Sign in →</a></p>
      </div>

      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        <a href="#" class="auth-provider"><img src="/brand/google.svg" alt="" class="provider-logo" /> Continue with Google</a>
        <a href="#" class="auth-provider"><img src="/brand/microsoft.svg" alt="" class="provider-logo" /> Continue with Microsoft</a>
      </div>

      <div class="flex items-center gap-4 my-7 text-white/35 font-mono text-[12px] uppercase tracking-[0.14em]"><span class="h-px bg-white/10 flex-1"></span> or continue with email <span class="h-px bg-white/10 flex-1"></span></div>

      <div x-data="{ sent: false }" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm overflow-hidden shadow-2xl shadow-red-950/10">
        <div x-show="sent" x-cloak class="p-8 sm:p-10 text-center"><div class="mx-auto w-12 h-12 rounded-full bg-green-400/10 border border-green-400/25 flex items-center justify-center text-green-300 mb-5">✓</div><h2 class="text-2xl font-semibold tracking-[-0.03em] mb-3">Request received</h2><p class="text-white/55 leading-[1.6] max-w-[420px] mx-auto">We will get back to you to prepare the license, download and number of seats for your organization.</p><a href="/" class="inline-flex items-center justify-center mt-7 h-11 px-5 rounded-lg border border-white/10 text-sm text-white/75 hover:text-white hover:bg-white/[0.06] transition-colors">Back to site</a></div>
        <form x-show="!sent" x-on:submit.prevent="sent = true" class="p-6 sm:p-8 grid gap-5" novalidate>
          <div><label class="auth-label" for="name">Full name</label><input id="name" type="text" class="auth-input" placeholder="Ada Lovelace" autocomplete="name" /></div>
          <div><label class="auth-label" for="email">Work email</label><input id="email" type="email" class="auth-input" placeholder="name@theatre.org" autocomplete="email" /></div>
          <div class="grid sm:grid-cols-2 gap-5"><div><label class="auth-label" for="organization">Organization</label><input id="organization" type="text" class="auth-input" placeholder="Theatre, company, festival…" autocomplete="organization" /></div><div><label class="auth-label" for="role">Role</label><input id="role" type="text" class="auth-input" placeholder="Direction, production, accessibility…" /></div></div>
          <div><label class="auth-label" for="message">How would you like to use Sténtor?</label><textarea id="message" rows="4" class="auth-input auth-textarea" placeholder="Tell us about the production, trial period, Macs or seats you need."></textarea></div>
          <label class="flex gap-3 items-start text-sm text-white/55 leading-[1.5]"><input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-white/15 bg-white/5 accent-red-500" /><span>I accept the <a href="/terms" class="text-white underline underline-offset-4 hover:text-red-300">Terms</a> and <a href="/privacy" class="text-white underline underline-offset-4 hover:text-red-300">Privacy Policy</a>.</span></label>
          <button type="submit" class="h-14 rounded-xl bg-red-500 text-black font-semibold text-[15px] shadow-[0_0_40px_rgba(239,68,68,0.18)] hover:bg-red-400 transition-colors">Request access →</button>
        </form>
      </div>
      <ul class="grid sm:grid-cols-3 gap-3 mt-7 text-white/45 text-sm"><li class="flex gap-2"><span class="text-green-400">✓</span> No card required</li><li class="flex gap-2"><span class="text-green-400">✓</span> Trial license on request</li><li class="flex gap-2"><span class="text-green-400">✓</span> Built for live production</li></ul>
    </main>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";
  .auth-provider { @apply h-14 rounded-xl border border-white/10 bg-white/[0.045] hover:bg-white/[0.075] hover:border-white/20 transition-colors inline-flex items-center justify-center gap-3 text-[15px] font-medium text-white/90; }
  .provider-logo { width: 20px; height: 20px; flex: none; display: block; }
  .auth-label { @apply block text-[13px] font-medium text-white/62 mb-2; }
  .auth-input { @apply w-full h-12 rounded-xl border border-white/10 bg-black/30 text-white outline-none transition-all text-[15px]; padding: 0 16px; }
  .auth-input:focus { border-color: rgba(239, 68, 68, 0.55); box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12); }
  .auth-input::placeholder { color: rgba(255,255,255,0.34); }
  .auth-textarea { height: auto; padding-top: 14px; padding-bottom: 14px; resize: none; }
  [x-cloak] { display: none !important; }
</style>
