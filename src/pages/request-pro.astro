---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Request access - Sténtor"
  description="Request Sténtor access for individuals, theatres, companies, festivals, schools and institutions."
  active={null}
  showNav={false}
  showFooter={false}
>
  <section class="min-h-screen text-text relative overflow-hidden request-access-page">
    <div class="absolute inset-0 [background-image:radial-gradient(rgba(24, 88, 200,0.24)_1px,transparent_1px)] [background-size:28px_28px] [-webkit-mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_66%)] [mask-image:linear-gradient(to_bottom_right,#000_0%,transparent_66%)] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-[-18%] top-[-18%] w-[560px] h-[560px] rounded-full bg-stentor/14 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <header class="relative max-w-[1120px] mx-auto px-5 md:px-8 py-7 flex items-center justify-between">
      <a href="/" class="inline-flex items-center gap-3 text-text hover:text-text-2 transition-colors" aria-label="Sténtor home"><span class="font-semibold tracking-[-0.04em] text-xl">Sténtor</span><span class="text-text-2 text-sm">Access</span></a>
      <a href="/" class="inline-flex items-center gap-2 text-sm text-text-2 hover:text-text transition-colors"><span aria-hidden="true">←</span> Back to site</a>
    </header>

    <main class="relative max-w-[1120px] mx-auto px-5 md:px-8 pt-10 pb-20">
      <div class="mb-10 max-w-[720px]">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-4">Access request</p>
        <h1 class="text-5xl sm:text-6xl lg:text-[72px] leading-[0.96] tracking-[-0.06em] font-semibold max-w-[720px]">Request access.</h1>
        <p class="text-text-2 text-lg leading-[1.55] mt-6 max-w-[640px]">Tell us whether you will use Sténtor individually or for an organization. During the beta testing phase, access is reviewed manually before downloads and access codes are enabled.</p>
        <p class="text-text-2 mt-4">Already have an access code? <a href="/account" class="text-stentor underline underline-offset-4 hover:text-stentor">Sign in →</a></p>
      </div>

      <div id="request-form" class="scroll-mt-8 rounded-2xl border border-hairline-strong bg-surface-2 backdrop-blur-sm overflow-hidden shadow-2xl shadow-stentor-dark/10">
        <div data-beta-success hidden class="p-8 sm:p-10 text-center"><div class="mx-auto w-12 h-12 rounded-full bg-green-400/10 border border-green-400/25 flex items-center justify-center text-green-300 mb-5">✓</div><h2 class="text-2xl font-semibold tracking-[-0.03em] mb-3">Access request saved</h2><p class="text-text-2 leading-[1.6] max-w-[460px] mx-auto">Your request is now in the Sténtor access queue. When approved, your Account will show your access code, downloads and activation details.</p><a href="/" class="inline-flex items-center justify-center mt-7 h-11 px-5 rounded-lg border border-hairline-strong text-sm text-text-2 hover:text-text hover:bg-surface-2 transition-colors">Back to site</a></div>
        <form data-beta-form class="p-6 sm:p-8 grid gap-5" novalidate>
          <fieldset class="grid gap-3 form-full"><legend class="auth-label">How will you use Sténtor? <span class="required-mark">Required</span></legend><div class="grid sm:grid-cols-2 gap-4"><label class="account-type-option"><input type="radio" name="account_type" value="individual" class="accent-stentor" checked /><span><strong>Individual</strong><small>I use Sténtor on my own.</small></span></label><label class="account-type-option"><input type="radio" name="account_type" value="organization" class="accent-stentor" /><span><strong>Organization</strong><small>I represent a theatre, company, festival, school, university or team.</small></span></label></div></fieldset>

          <div><label class="auth-label" for="first_name">First name <span class="required-mark">Required</span></label><input id="first_name" name="first_name" required type="text" class="auth-input" placeholder="Ada" autocomplete="given-name" /></div>
          <div><label class="auth-label" for="last_name">Last name <span class="required-mark">Required</span></label><input id="last_name" name="last_name" required type="text" class="auth-input" placeholder="Lovelace" autocomplete="family-name" /></div>
          <div><label class="auth-label" for="email">E-mail <span class="required-mark">Required</span></label><input id="email" name="email" required type="email" class="auth-input" placeholder="name@theatre.org" autocomplete="email" /></div>
          <div><label class="auth-label" for="role">Role</label><input id="role" name="role" type="text" class="auth-input" placeholder="Direction, production, accessibility" /></div>
          <div data-organization-only><label class="auth-label" for="organization">Organization <span class="required-mark">Required for organizations</span></label><input id="organization" name="organization_name" type="text" class="auth-input" placeholder="Theatre, company, festival" autocomplete="organization" /></div>
          <div data-organization-only><label class="auth-label" for="seats">Users <span class="required-mark">Required for organizations</span></label><input id="seats" name="requested_seats" type="number" min="1" value="1" class="auth-input" /></div>
          <div><label class="auth-label" for="country">Country <span class="required-mark">Required</span></label><input id="country" name="country" required type="text" class="auth-input" placeholder="Italy" /></div>

          <fieldset class="grid gap-2 form-full"><legend class="auth-label">Platforms <span class="required-mark">Required</span></legend><div class="flex flex-wrap gap-4 text-sm text-text-2"><label class="inline-flex items-center gap-2"><input type="checkbox" name="platforms" value="macos" checked class="accent-stentor" /> macOS</label><label class="inline-flex items-center gap-2"><input type="checkbox" name="platforms" value="windows" class="accent-stentor" /> Windows</label></div></fieldset>
          <div class="form-full"><label class="auth-label" for="expected_use">Expected use</label><input id="expected_use" name="expected_use" type="text" class="auth-input" placeholder="Rehearsal, festival, accessibility project..." /></div>
          <div class="form-full"><label class="auth-label" for="message">How would you like to use Sténtor?</label><textarea id="message" name="message" rows="4" class="auth-input auth-textarea" placeholder="Tell us about the production, access needs and setup you need."></textarea></div>
          <p data-beta-error hidden class="form-full rounded-xl border border-stentor/30 bg-stentor/10 text-stentor text-sm leading-[1.5] p-4"></p>
          <label class="form-full flex gap-3 items-start text-sm text-text-2 leading-[1.5]"><input type="checkbox" required class="mt-0.5 w-4 h-4 rounded border-hairline-strong bg-surface-2 accent-stentor" /><span>I accept the <a href="/terms" class="text-text underline underline-offset-4 hover:text-stentor">Terms</a> and <a href="/privacy" class="text-text underline underline-offset-4 hover:text-stentor">Privacy Policy</a>. <span class="required-mark">Required</span></span></label>
          <button type="submit" data-loading-label="Saving request..." class="form-full h-14 rounded-xl bg-stentor text-white font-semibold text-[15px] shadow-[0_0_40px_rgba(24, 88, 200,0.20)] hover:bg-stentor-dark transition-colors disabled:opacity-60">Request access →</button>
        </form>
      </div>
      <ul class="grid sm:grid-cols-3 gap-3 mt-7 text-text-2 text-sm"><li class="flex gap-2"><span class="text-green-400">✓</span> Manual review</li><li class="flex gap-2"><span class="text-green-400">✓</span> Access code on approval</li><li class="flex gap-2"><span class="text-green-400">✓</span> Built for live performance</li></ul>
    </main>
  </section>
</Layout>

<script>
  import { setupBetaRequestForm } from '../lib/betaRequestForm';
  setupBetaRequestForm({ formSelector: '[data-beta-form]', successSelector: '[data-beta-success]', errorSelector: '[data-beta-error]' });
</script>

<style>
  @reference "../styles/global.css";
  .request-access-page { background: radial-gradient(circle at 82% 0%, rgba(110, 168, 255, 0.16), transparent 34%), linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%); }
  .auth-label { @apply block text-[13px] font-medium text-text-2 mb-2; }
  .auth-input { @apply w-full h-12 rounded-xl border border-hairline-strong bg-surface-2 text-text outline-none transition-all text-[15px]; padding: 0 16px; }
  .auth-input:focus { border-color: rgba(24, 88, 200, 0.58); box-shadow: 0 0 0 3px rgba(24, 88, 200, 0.12); }
  .auth-input::placeholder { color: #98a2b1; }
  .auth-textarea { height: auto; padding-top: 14px; padding-bottom: 14px; resize: none; }
  .account-type-option { @apply min-h-24 rounded-xl border border-hairline-strong bg-sunken p-4 flex items-start gap-3 cursor-pointer hover:border-stentor/35 hover:bg-surface-2 transition-colors; }
  .account-type-option input { margin-top: 3px; }
  .account-type-option span { @apply grid gap-1; }
  .account-type-option strong { @apply text-text font-semibold; }
  .account-type-option small { @apply text-text-2 leading-[1.45] text-sm; }
  .required-mark { display: inline-flex; margin-left: 6px; color: rgba(248, 113, 113, 0.92); font-size: 12px; font-weight: 600; letter-spacing: 0; text-transform: none; }
  @media (min-width: 980px) {
    #request-form form[data-beta-form] { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; row-gap: 22px; }
    #request-form form[data-beta-form] > .form-full { grid-column: 1 / -1; }
  }
</style>
