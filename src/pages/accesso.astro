---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sign in to Sténtor – Sténtor" description="Sign in to your account for downloads, access codes and activations." active={null} showNav={false} showFooter={false} noindex={true}>
  <section class="min-h-screen bg-bg text-text relative overflow-hidden">
    <div class="absolute left-[-18%] bottom-[-18%] w-[560px] h-[560px] rounded-full bg-stentor/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <header class="relative max-w-[1080px] mx-auto px-5 md:px-8 py-7 flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-3 text-text hover:text-text-2 transition-colors"><span class="font-semibold tracking-[-0.04em] text-xl">STÉNTOR</span><span class="text-text-2 text-sm">Account</span></a>
        <a href="/" class="inline-flex items-center gap-2 text-sm text-text-2 hover:text-text transition-colors"><span aria-hidden="true">←</span> Back to site</a></header>
    <main class="relative max-w-[650px] mx-auto px-5 md:px-8 pt-16 pb-20">
      <div class="mb-9"><p class="font-mono text-[12px] uppercase tracking-[0.14em] text-stentor mb-4">Access code</p><h1 class="text-5xl sm:text-6xl leading-[0.98] tracking-[-0.06em] font-semibold">Sign in to Sténtor.</h1><p class="text-text-2 text-lg leading-[1.55] mt-6 max-w-[540px]">Use your email to access downloads, activation details and your Sténtor access code.</p><p class="text-text-2 mt-4">No access code yet? <a href="/request-pro" class="text-stentor underline underline-offset-4 hover:text-stentor">Request a code →</a></p></div>
      <div class="grid sm:grid-cols-2 gap-3 mb-6"><a href="#" class="auth-provider"><img src="/brand/google.svg" alt="" class="provider-logo" /> Continue with Google</a><a href="#" class="auth-provider"><img src="/brand/microsoft.svg" alt="" class="provider-logo" /> Continue with Microsoft</a></div>
      <div class="flex items-center gap-4 my-7 text-text-2 font-mono text-[12px] uppercase tracking-[0.14em]"><span class="h-px bg-surface-2 flex-1"></span> or receive an email link <span class="h-px bg-surface-2 flex-1"></span></div>
      <div x-data="{ sent: false }" class="rounded-2xl border border-hairline-strong bg-surface-2 backdrop-blur-sm overflow-hidden"><div x-show="sent" x-cloak class="p-8 sm:p-10 text-center"><div class="mx-auto w-12 h-12 rounded-full bg-green-400/10 border border-green-400/25 flex items-center justify-center text-green-300 mb-5">✓</div><h2 class="text-2xl font-semibold tracking-[-0.03em] mb-3">Check your email</h2><p class="text-text-2 leading-[1.6] max-w-[420px] mx-auto">When authentication is active, you will receive a secure link to access your Sténtor area.</p></div><form x-show="!sent" x-on:submit.prevent="sent = true" class="p-6 sm:p-8 grid gap-5" novalidate><div><label class="auth-label" for="email">Work email</label><input id="email" type="email" class="auth-input" placeholder="name@theatre.org" autocomplete="email" /></div><button type="submit" class="h-14 rounded-xl bg-stentor text-white font-semibold text-[15px] hover:bg-stentor-dark transition-colors">Receive access link →</button></form></div>
    </main>
  </section>
</Layout>
<style>
  @reference "../styles/global.css";
  .auth-provider { @apply h-14 rounded-xl border border-hairline-strong bg-surface-2 hover:bg-surface-2 hover:border-hairline-strong transition-colors inline-flex items-center justify-center gap-3 text-[15px] font-medium text-text-2; }
  .provider-logo { width: 20px; height: 20px; flex: none; display: block; }
  .auth-label { @apply block text-[13px] font-medium text-text-2 mb-2; }
  .auth-input { @apply w-full h-12 rounded-xl border border-hairline-strong bg-sunken text-text outline-none transition-all text-[15px]; padding: 0 16px; }
  .auth-input:focus { border-color: rgba(24, 88, 200, 0.55); box-shadow: 0 0 0 3px rgba(24, 88, 200, 0.12); }
  .auth-input::placeholder { color: #98a2b1; }
  [x-cloak] { display: none !important; }
</style>
