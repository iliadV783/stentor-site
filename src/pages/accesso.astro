---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Accedi a Sténtor – Sténtor"
  description="Accedi al tuo account Sténtor per download, licenze e attivazioni."
  active={null}
  showNav={false}
  showFooter={false}
  noindex={true}
>
  <section class="min-h-screen bg-black text-white relative overflow-hidden">
    <div class="absolute left-[-18%] bottom-[-18%] w-[560px] h-[560px] rounded-full bg-red-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <header class="relative max-w-[1080px] mx-auto px-5 md:px-8 py-7 flex items-center justify-between">
      <a href="/" class="inline-flex items-center gap-3 text-white hover:text-white/80 transition-colors" aria-label="Sténtor home">
        <span class="font-semibold tracking-[-0.04em] text-xl">STÉNTOR</span>
        <span class="text-white/45 text-sm">Account</span>
      </a>
      <a href="/" class="inline-flex items-center gap-2 text-sm text-white/55 hover:text-white transition-colors">
        <span aria-hidden="true">←</span>
        Torna al sito
      </a>
    </header>

    <main class="relative max-w-[650px] mx-auto px-5 md:px-8 pt-16 pb-20">
      <div class="mb-9">
        <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-red-400 mb-4">Area cliente</p>
        <h1 class="text-5xl sm:text-6xl leading-[0.98] tracking-[-0.06em] font-semibold">Accedi a Sténtor.</h1>
        <p class="text-white/55 text-lg leading-[1.55] mt-6 max-w-[540px]">
          Gestisci licenze, download e attivazioni per il tuo teatro, compagnia o istituzione.
        </p>
        <p class="text-white/45 mt-4">
          Non hai ancora una licenza? <a href="/richiedi-prova" class="text-red-400 underline underline-offset-4 hover:text-red-300">Richiedi accesso →</a>
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-3 mb-6">
        <a href="#" class="auth-provider">
          <span class="provider-mark google-mark" aria-hidden="true">G</span>
          Continua con Google
        </a>
        <a href="#" class="auth-provider">
          <span class="provider-mark microsoft-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          Continua con Microsoft
        </a>
      </div>

      <div class="flex items-center gap-4 my-7 text-white/35 font-mono text-[12px] uppercase tracking-[0.14em]">
        <span class="h-px bg-white/10 flex-1"></span>
        oppure ricevi un link via email
        <span class="h-px bg-white/10 flex-1"></span>
      </div>

      <div x-data="{ sent: false }" class="rounded-2xl border border-white/10 bg-white/[0.045] backdrop-blur-sm overflow-hidden">
        <div x-show="sent" x-cloak class="p-8 sm:p-10 text-center">
          <div class="mx-auto w-12 h-12 rounded-full bg-green-400/10 border border-green-400/25 flex items-center justify-center text-green-300 mb-5">✓</div>
          <h2 class="text-2xl font-semibold tracking-[-0.03em] mb-3">Controlla la tua email</h2>
          <p class="text-white/55 leading-[1.6] max-w-[420px] mx-auto">
            Quando l’autenticazione sarà attiva, riceverai un link sicuro per accedere alla tua area Sténtor.
          </p>
        </div>

        <form x-show="!sent" x-on:submit.prevent="sent = true" class="p-6 sm:p-8 grid gap-5" novalidate>
          <div>
            <label class="auth-label" for="email">Email di lavoro</label>
            <input id="email" type="email" class="auth-input" placeholder="nome@teatro.it" autocomplete="email" />
          </div>
          <button type="submit" class="h-14 rounded-xl bg-red-500 text-black font-semibold text-[15px] hover:bg-red-400 transition-colors">
            Ricevi link di accesso →
          </button>
        </form>
      </div>
    </main>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";
  .auth-provider {
    @apply h-14 rounded-xl border border-white/10 bg-white/[0.045] hover:bg-white/[0.075] hover:border-white/20 transition-colors inline-flex items-center justify-center gap-3 text-[15px] font-medium text-white/90;
  }
  .provider-mark { @apply w-5 h-5 flex-none inline-flex items-center justify-center; }
  .google-mark { font-weight: 700; color: #fff; }
  .microsoft-mark { display: grid; grid-template-columns: repeat(2, 8px); grid-template-rows: repeat(2, 8px); gap: 2px; }
  .microsoft-mark span { display: block; background: rgba(255,255,255,0.88); }
  .auth-label { @apply block text-[13px] font-medium text-white/62 mb-2; }
  .auth-input { @apply w-full h-12 rounded-xl border border-white/10 bg-black/30 text-white outline-none transition-all text-[15px]; padding: 0 16px; }
  .auth-input:focus { border-color: rgba(239, 68, 68, 0.55); box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12); }
  .auth-input::placeholder { color: rgba(255,255,255,0.34); }
  [x-cloak] { display: none !important; }
</style>
